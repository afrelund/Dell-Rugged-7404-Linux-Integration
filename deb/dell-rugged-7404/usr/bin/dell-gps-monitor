class RouteError(Exception):
    pass


def geofabrik_slug(state_name):
    return state_name.lower().replace(" ", "-")


def http_json(params):
    import urllib.parse
    import urllib.request
    url = TIGER_URL + urllib.parse.urlencode(params)
    with urllib.request.urlopen(url, timeout=60) as response:
        return json.load(response)


def list_counties(state_fips):
    data = http_json({"where": f"STATE='{state_fips}'", "outFields": "NAME,GEOID",
                      "returnGeometry": "false", "f": "json", "orderByFields": "NAME"})
    return [(f["attributes"]["NAME"], f["attributes"]["GEOID"]) for f in data.get("features", [])]


def county_polygon(geoid):
    data = http_json({"where": f"GEOID='{geoid}'", "outFields": "NAME", "returnGeometry": "true",
                      "outSR": "4326", "f": "geojson"})
    if not data.get("features"):
        raise RouteError("County boundary not found.")
    return data


def download_file(url, dest, progress=None):
    import urllib.request
    request = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) dell-gps-monitor"})
    with urllib.request.urlopen(request, timeout=60) as response, open(dest, "wb") as handle:
        total = int(response.headers.get("Content-Length") or 0)
        done = 0
        while True:
            chunk = response.read(1 << 20)
            if not chunk:
                break
            handle.write(chunk)
            done += len(chunk)
            if progress and total:
                progress(f"Downloading state data… {done // 1048576} of {total // 1048576} MB")


def tools_missing():
    return [name for name in ("osmium", "planetsplitter", "routino-router") if not shutil.which(name)]


def downloaded_areas():
    areas = []
    base = os.path.join(MAPS_DIR, "areas")
    for geoid in sorted(os.listdir(base)) if os.path.isdir(base) else []:
        try:
            with open(os.path.join(base, geoid, "meta.json")) as handle:
                areas.append(dict(json.load(handle), geoid=geoid))
        except (OSError, ValueError):
            continue
    return areas


def run_tool(args, **kwargs):
    result = subprocess.run(args, capture_output=True, text=True, **kwargs)
    if result.returncode != 0:
        lines = (result.stderr or result.stdout).strip().splitlines()
        raise RouteError(f"{os.path.basename(args[0])} failed: {lines[-1] if lines else result.returncode}")
    return result


def build_routing_db(progress=None):
    folder = os.path.join(MAPS_DIR, "routing")
    shutil.rmtree(folder, ignore_errors=True)
    files = [os.path.join(MAPS_DIR, "areas", a["geoid"], "area.osm.pbf") for a in downloaded_areas()]
    if not files:
        return
    os.makedirs(folder)
    if progress:
        progress("Building the routing database (can take several minutes)…")
    run_tool(["planetsplitter", f"--dir={folder}", "--prefix=routing",
              f"--tagging={ROUTINO_SHARE}/tagging.xml"] + files)


def download_county(state_fips, geoid, name, progress=None):
    missing = tools_missing()
    if missing:
        raise RouteError("Missing: " + ", ".join(missing) + ". Install with: sudo apt install routino osmium-tool")
    say = progress or (lambda _text: None)
    area = os.path.join(MAPS_DIR, "areas", geoid)
    cache = os.path.join(MAPS_DIR, "cache")
    os.makedirs(area, exist_ok=True)
    os.makedirs(cache, exist_ok=True)
    state_file = os.path.join(cache, f"state-{state_fips}.osm.pbf")
    try:
        say("Getting the county boundary…")
        polygon = os.path.join(cache, f"{geoid}.geojson")
        with open(polygon, "w") as handle:
            json.dump(county_polygon(geoid), handle)
        download_file(GEOFABRIK_URL.format(geofabrik_slug(STATES[state_fips])), state_file, say)
        say("Cutting out the county…")
        run_tool(["osmium", "extract", "-p", polygon, state_file, "-o",
                  os.path.join(area, "area.osm.pbf"), "--overwrite"])
        with open(os.path.join(area, "meta.json"), "w") as handle:
            json.dump({"name": name, "state": STATES[state_fips],
                       "downloaded": datetime.date.today().isoformat()}, handle)
        build_routing_db(say)
    finally:
        shutil.rmtree(cache, ignore_errors=True)
    auto_cells_after_download(say)
    say(f"{name}, {STATES[state_fips]} is ready for offline routing.")


def remove_area(geoid, progress=None):
    shutil.rmtree(os.path.join(MAPS_DIR, "areas", geoid), ignore_errors=True)
    build_routing_db(progress)


# ----- satellite imagery (public-domain / open sources) with offline tile storage -----
IMAGERY_SOURCES = {
    "usgs": {"name": "Satellite (USGS, US only)", "max_zoom": 16,
             "url": "https://basemap.nationalmap.gov/arcgis/rest/services/USGSImageryOnly/MapServer/tile/{z}/{y}/{x}",
             "license": "USGS National Map imagery (public domain)",
             "license_uri": "https://www.usgs.gov/information-policies-and-instructions/copyrights-and-credits"},
    "s2": {"name": "Satellite (Sentinel-2, world)", "max_zoom": 13,
           "url": "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2021_3857/default/g/{z}/{y}/{x}.jpg",
           "license": "Sentinel-2 cloudless by EOX (CC BY-NC-SA 4.0), contains modified Copernicus Sentinel data",
           "license_uri": "https://s2maps.eu"},
}
IMAGERY_DIR = os.path.join(MAPS_DIR, "imagery")
IMAGERY_MIN_ZOOM = 8


def tile_xy(lat, lon, zoom):
    n = 2 ** zoom
    x = int((lon + 180) / 360 * n)
    lat_r = math.radians(max(min(lat, 85.0511), -85.0511))
    y = int((1 - math.asinh(math.tan(lat_r)) / math.pi) / 2 * n)
    return min(max(x, 0), n - 1), min(max(y, 0), n - 1)


def tiles_for_bbox(bbox, zmin, zmax):
    """All (z, x, y) tiles covering bbox = (south, west, north, east)."""
    south, west, north, east = bbox
    for zoom in range(zmin, zmax + 1):
        x0, y1 = tile_xy(south, west, zoom)
        x1, y0 = tile_xy(north, east, zoom)
        for x in range(x0, x1 + 1):
            for y in range(y0, y1 + 1):
                yield zoom, x, y


def count_tiles(bbox, zmin, zmax):
    total = 0
    for zoom in range(zmin, zmax + 1):
        x0, y1 = tile_xy(bbox[0], bbox[1], zoom)
        x1, y0 = tile_xy(bbox[2], bbox[3], zoom)
        total += (x1 - x0 + 1) * (y1 - y0 + 1)
    return total


def geojson_bbox(data):
    lats, lons = [], []

    def walk(coords):
        if coords and isinstance(coords[0], (int, float)):
            lons.append(coords[0])
            lats.append(coords[1])
        else:
            for item in coords:
                walk(item)
    for feature in data.get("features", []):
        walk(feature["geometry"]["coordinates"])
    return min(lats), min(lons), max(lats), max(lons)


def imagery_tile_path(source, zoom, x, y):
    return os.path.join(IMAGERY_DIR, source, str(zoom), str(x), f"{y}.jpg")


def fetch_tile(source, zoom, x, y, timeout=15):
    """Return tile bytes from disk, or download and store them."""
    import urllib.request
    path = imagery_tile_path(source, zoom, x, y)
    try:
        with open(path, "rb") as handle:
            return handle.read()
    except OSError:
        pass
    url = IMAGERY_SOURCES[source]["url"].format(z=zoom, x=x, y=y)
    request = urllib.request.Request(url, headers={"User-Agent": "dell-rugged-gps-monitor/1.0"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        data = response.read()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".part", "wb") as handle:
        handle.write(data)
    os.replace(path + ".part", path)
    return data


def start_tile_server():
    """Local 127.0.0.1 server so the map reads imagery from disk first and caches what it views."""
    import http.server

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            try:
                source, zoom, x, y = self.path.strip("/").split(".")[0].split("/")
                data = fetch_tile(source, int(zoom), int(x), int(y))
            except Exception:
                self.send_error(404)
                return
            self.send_response(200)
            self.send_header("Content-Type", "image/jpeg")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def log_message(self, *_args):
            pass
    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return server.server_address[1]


def imagery_areas():
    try:
        with open(os.path.join(IMAGERY_DIR, "areas.json")) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def save_imagery_areas(areas):
    os.makedirs(IMAGERY_DIR, exist_ok=True)
    with open(os.path.join(IMAGERY_DIR, "areas.json"), "w") as handle:
        json.dump(areas, handle)


def download_imagery(source, geoid, name, zmax, progress=None):
    from concurrent.futures import ThreadPoolExecutor
    say = progress or (lambda _text: None)
    say("Getting the county boundary…")
    bbox = geojson_bbox(county_polygon(geoid))
    tiles = list(tiles_for_bbox(bbox, IMAGERY_MIN_ZOOM, zmax))
    done, failed = 0, 0

    def one(tile):
        for _attempt in range(3):
            try:
                fetch_tile(source, *tile)
                return True
            except OSError:
                time.sleep(1)
        return False
    with ThreadPoolExecutor(max_workers=8) as pool:
        for ok in pool.map(one, tiles):
            done += 1
            failed += not ok
            if done % 25 == 0:
                say(f"Downloading imagery… {done} of {len(tiles)} tiles")
    areas = imagery_areas()
    areas[f"{source}:{geoid}"] = {"source": source, "name": name, "bbox": bbox, "zmax": zmax,
                                  "downloaded": datetime.date.today().isoformat()}
    save_imagery_areas(areas)
    auto_cells_after_download(say)
    say(f"{name}: {len(tiles) - failed} tiles saved" + (f", {failed} failed (run again to retry)." if failed else "."))


def remove_imagery(key):
    areas = imagery_areas()
    area = areas.pop(key, None)
    if area:
        for zoom, x, y in tiles_for_bbox(area["bbox"], IMAGERY_MIN_ZOOM, area["zmax"]):
            try:
                os.remove(imagery_tile_path(area["source"], zoom, x, y))
            except OSError:
                pass
        save_imagery_areas(areas)


# ----- cell towers (OpenCellID-format CSV) and modem signal -----
CELLS_DIR = os.path.join(MAPS_DIR, "cells")
CELL_DB = os.path.join(CELLS_DIR, "cells.db")
OCID_URLS = ("https://opencellid.org/ocid/downloads?token={token}&type=mcc&file={mcc}.csv.gz",
             "https://opencellid.org/downloads.php?token={token}&type=mcc&file={mcc}.csv.gz")
US_MCCS = (310, 311, 312, 313, 316)
CELL_TOKEN = os.path.join(CELLS_DIR, "token")


def cell_db():
    import sqlite3
    os.makedirs(CELLS_DIR, exist_ok=True)
    db = sqlite3.connect(CELL_DB)
    db.execute("CREATE TABLE IF NOT EXISTS cells (radio TEXT, mcc INT, net INT, area INT, cell INT, "
               "lon REAL, lat REAL, range INT, samples INT)")
    db.execute("CREATE INDEX IF NOT EXISTS cells_pos ON cells (lat, lon)")
    db.execute("CREATE INDEX IF NOT EXISTS cells_id ON cells (mcc, net, cell)")
    return db


def import_cell_csv(path, progress=None, bboxes=None):
    """Load an OpenCellID CSV (plain or .gz): radio,mcc,net,area,cell,unit,lon,lat,range,samples,..."""
    import csv
    import gzip
    opener = gzip.open if path.endswith(".gz") else open
    db, rows, total = cell_db(), [], 0

    def flush():
        db.executemany("INSERT INTO cells VALUES (?,?,?,?,?,?,?,?,?)", rows)
        rows.clear()
    with opener(path, "rt", newline="") as handle:
        for line in csv.reader(handle):
            try:
                if bboxes:
                    lat, lon = float(line[7]), float(line[6])
                    if not any(b[0] <= lat <= b[2] and b[1] <= lon <= b[3] for b in bboxes):
                        continue
                rows.append((line[0].upper(), int(line[1]), int(line[2]), int(line[3]), int(line[4]),
                             float(line[6]), float(line[7]), int(float(line[8] or 0)), int(float(line[9] or 0))))
            except (IndexError, ValueError):
                continue
            total += 1
            if len(rows) >= 20000:
                flush()
                if progress:
                    progress(f"Importing towers… {total:,}")
    flush()
    db.commit()
    db.close()
    if not total and not bboxes:
        raise RouteError("No towers found - expected an OpenCellID CSV.")
    return total


def clear_cells():
    try:
        os.remove(CELL_DB)
    except OSError:
        pass


def cell_count():
    if not os.path.exists(CELL_DB):
        return 0
    db = cell_db()
    try:
        return db.execute("SELECT COUNT(*) FROM cells").fetchone()[0]
    finally:
        db.close()


def cells_in_bbox(south, west, north, east, limit=500):
    if not os.path.exists(CELL_DB):
        return []
    db = cell_db()
    try:
        return db.execute("SELECT radio, mcc, net, area, cell, lat, lon FROM cells WHERE lat BETWEEN ? AND ? "
                          "AND lon BETWEEN ? AND ? LIMIT ?", (south, north, west, east, limit)).fetchall()
    finally:
        db.close()


def load_cell_token():
    try:
        with open(CELL_TOKEN) as handle:
            return handle.read().strip()
    except OSError:
        return ""


def save_cell_token(token):
    os.makedirs(CELLS_DIR, exist_ok=True)
    fd = os.open(CELL_TOKEN, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        handle.write(token.strip())


def downloaded_county_bboxes():
    """{geoid: bbox} for every county with offline routing or imagery."""
    boxes = {}
    for area in imagery_areas().values():
        boxes[area["name"]] = tuple(area["bbox"])
    cache_path = os.path.join(CELLS_DIR, "bboxes.json")
    try:
        with open(cache_path) as handle:
            cache = json.load(handle)
    except (OSError, ValueError):
        cache = {}
    try:
        geoids = os.listdir(os.path.join(MAPS_DIR, "areas"))
    except OSError:
        geoids = []
    for geoid in geoids:
        if geoid not in cache:
            try:
                cache[geoid] = geojson_bbox(county_polygon(geoid))
            except Exception:
                continue
        boxes["county " + geoid] = tuple(cache[geoid])
    os.makedirs(CELLS_DIR, exist_ok=True)
    with open(cache_path, "w") as handle:
        json.dump(cache, handle)
    return boxes


def download_cells(token, mcc, progress=None, bboxes=None):
    import tempfile
    import urllib.error
    say = progress or (lambda _t: None)
    say(f"Downloading towers for MCC {mcc} (large file, please wait)…")
    with tempfile.TemporaryDirectory() as tmp:
        path = os.path.join(tmp, f"{mcc}.csv.gz")
        reason = "no data file was returned"
        for template in OCID_URLS:
            try:
                download_file(template.format(token=token, mcc=mcc), path)
            except urllib.error.HTTPError as error:
                reason = f"HTTP {error.code}"
                continue
            except OSError as error:
                raise RouteError(f"OpenCellID download failed ({error}). Check internet.")
            with open(path, "rb") as handle:
                head = handle.read(300)
            if head[:2] == b"\x1f\x8b":
                break
            try:
                reason = json.loads(head.decode("utf-8", "replace")).get("message", reason)
            except ValueError:
                reason = "the token was not accepted"
        else:
            raise RouteError(f"OpenCellID refused the download for MCC {mcc}: {reason}. "
                             "Check the API token; each file can be fetched twice a day.")
        return import_cell_csv(path, say, bboxes)


def download_cells_for_areas(token, progress=None, mccs=US_MCCS):
    """Fetch towers only for counties already downloaded for routing or imagery."""
    say = progress or (lambda _t: None)
    boxes = list(downloaded_county_bboxes().values())
    if not boxes:
        raise RouteError("No counties downloaded yet. Download a county for routing or imagery first.")
    if not token:
        raise RouteError("Enter your OpenCellID API token first.")
    save_cell_token(token)
    db = cell_db()
    for south, west, north, east in boxes:
        db.execute("DELETE FROM cells WHERE lat BETWEEN ? AND ? AND lon BETWEEN ? AND ?",
                   (south, north, west, east))
    db.commit()
    db.close()
    total, last_error = 0, None
    for mcc in mccs:
        try:
            total += download_cells(token, mcc, say, boxes)
        except RouteError as error:
            last_error = error
            if "HTTP 4" in str(error) or "did not return" in str(error):
                if total == 0 and mcc == mccs[0]:
                    raise
    if not total and last_error:
        raise last_error
    say(f"{total:,} towers added for {len(boxes)} downloaded area(s).")
    return total


CELL_API = "https://opencellid.org/cell/getInArea?key={key}&BBOX={s},{w},{n},{e}&format=json&limit=50&offset={off}"


API_DAILY_BUDGET = 900


def download_cells_api(token, boxes, centre=None, progress=None):
    """Fetch towers for whole areas through the OpenCellID area API, nearest squares first.

    The API allows 4 sq km and 1,000 requests a day, so big areas take several days: squares already
    fetched are remembered and the next run carries on where this one stopped."""
    import urllib.error
    import urllib.request
    from concurrent.futures import ThreadPoolExecutor
    say = progress or (lambda _t: None)
    if not token:
        raise RouteError("Enter your OpenCellID API token first.")
    if not boxes:
        raise RouteError("No counties downloaded yet. Download a county for routing or imagery first.")
    save_cell_token(token)
    progress_path = os.path.join(CELLS_DIR, "api_progress.json")
    try:
        with open(progress_path) as handle:
            record = json.load(handle)
    except (OSError, ValueError):
        record = {}
    today = datetime.date.today().isoformat()
    if record.get("day") != today:
        record["day"], record["used"] = today, 0
    done_squares = set(record.get("done", []))
    step_lat = 1.9 / 111.0
    squares = []
    for south, west, north, east in boxes:
        mid = math.radians((south + north) / 2)
        step_lon = 1.9 / (111.0 * max(math.cos(mid), 0.2))
        lat_v = south
        while lat_v < north:
            lon_v = west
            while lon_v < east:
                key = f"{lat_v:.4f},{lon_v:.4f}"
                if key not in done_squares:
                    squares.append((lat_v, lon_v, step_lon, key))
                lon_v += step_lon
            lat_v += step_lat
    total_squares = len(squares) + len(done_squares)
    if centre:
        squares.sort(key=lambda q: (q[0] - centre[0]) ** 2 + ((q[1] - centre[1]) * 0.77) ** 2)
    state = {"stop": None}
    found, finished = [], []

    def fetch(url):
        record["used"] += 1
        request = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) dell-gps-monitor"})
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                return json.loads(response.read().decode("utf-8", "replace"))
        except urllib.error.HTTPError as error:
            state["stop"] = ("Daily OpenCellID request limit reached." if error.code == 429 else
                             "OpenCellID did not recognise that API key." if error.code == 401 else
                             f"OpenCellID error {error.code}.")
        except (OSError, ValueError):
            state["stop"] = "Could not reach OpenCellID."
        return {}

    def one(square):
        sq_lat, sq_lon, step_lon, key = square
        offset = 0
        while not state["stop"] and record["used"] < API_DAILY_BUDGET:
            data = fetch(CELL_API.format(key=token, s=sq_lat, w=sq_lon, n=sq_lat + step_lat,
                                         e=sq_lon + step_lon, off=offset))
            if state["stop"]:
                return
            cells = data.get("cells") or []
            for c in cells:
                found.append((str(c.get("radio", "")).upper(), int(c["mcc"]), int(c["mnc"]), int(c["lac"]),
                              int(c["cellid"]), float(c["lon"]), float(c["lat"]),
                              int(c.get("range") or 0), int(c.get("samples") or 0)))
            if len(cells) < 50:
                finished.append(key)
                return
            offset += 50
    count = 0
    with ThreadPoolExecutor(max_workers=4) as pool:
        for _ in pool.map(one, squares):
            count += 1
            if count % 20 == 0:
                say(f"Asking OpenCellID… {len(finished) + len(done_squares)} of {total_squares} squares, "
                    f"{len(found):,} towers")
    unique = set(found)
    db = cell_db()
    db.executemany("DELETE FROM cells WHERE mcc=? AND net=? AND cell=?", {(t[1], t[2], t[4]) for t in unique})
    db.executemany("INSERT INTO cells VALUES (?,?,?,?,?,?,?,?,?)", unique)
    db.commit()
    db.close()
    record["done"] = sorted(done_squares | set(finished))
    os.makedirs(CELLS_DIR, exist_ok=True)
    with open(progress_path, "w") as handle:
        json.dump(record, handle)
    left = total_squares - len(record["done"])
    if state["stop"] and not unique and not finished:
        raise RouteError(state["stop"])
    say(f"{len(unique):,} towers added. " + ("All squares of your downloaded counties are done." if not left else
        f"{left} of {total_squares} squares left - tap again tomorrow (limit is about {API_DAILY_BUDGET} "
        "requests a day)."))
    return len(unique)


def auto_cells_after_download(progress=None):
    """Best-effort tower fetch after a county download, when a token is saved."""
    token = load_cell_token()
    if token:
        try:
            download_cells_for_areas(token, progress)
        except Exception as error:
            if progress:
                progress(f"Tower download skipped: {error}")


def signal_color(quality):
    """Tower colour from modem signal quality 0-100; None means never heard (red)."""
    if not quality:
        return "#d32f2f"
    return "#2e7d32" if quality >= 60 else "#fbc02d" if quality >= 40 else "#ef8f00"


def parse_mmcli_keyvalue(text):
    values = {}
    for line in text.splitlines():
        key, sep, value = line.partition(":")
        if sep:
            values[key.strip()] = value.strip()
    return values


def read_modem():
    """Serving-cell info from ModemManager: dict with state, quality, mcc, mnc, area, cid (or {})."""
    def run(*args):
        try:
            return subprocess.run(["mmcli", "-m", "any", *args, "-K"], capture_output=True, text=True,
                                  timeout=10).stdout
        except (OSError, subprocess.SubprocessError):
            return ""
    info = parse_mmcli_keyvalue(run())
    if not info:
        return {}
    out = {"state": info.get("modem.generic.state", ""), "failed": info.get("modem.generic.state-failed-reason", "")}
    try:
        out["quality"] = int(info.get("modem.generic.signal-quality.value", "0"))
    except ValueError:
        out["quality"] = 0
    if out["state"] in ("registered", "connected", "searching"):
        location = parse_mmcli_keyvalue(run("--location-get"))
        try:
            out["mcc"] = int(location["modem.location.3gpp.mcc"])
            out["mnc"] = int(location["modem.location.3gpp.mnc"])
            out["cid"] = int(location.get("modem.location.3gpp.cid") or "0", 16)
            out["area"] = int(location.get("modem.location.3gpp.tac") or location.get("modem.location.3gpp.lac")
                              or "0", 16)
        except (KeyError, ValueError):
            pass
    return out


def parse_route_text(text):
    """Parse routino's --output-text-all table into a list of point dicts."""
    points = []
    for line in text.splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        cols = [c.strip() for c in line.split("\t")]
        try:
            point = {"lat": float(cols[0]), "lon": float(cols[1]), "type": cols[3]}
            point["total_km"] = float(cols[6])
            point["total_min"] = float(cols[7])
            point["segment_km"] = float(cols[4])
        except (IndexError, ValueError):
            continue
        point["road"] = cols[10] if len(cols) > 10 and cols[10] not in ("", "(null)") else "unnamed road"
        points.append(point)
    return points


def route_steps(points):
    """Collapse the route into 'road, distance' legs."""
    steps = []
    for index, point in enumerate(points[1:], 1):
        if steps and steps[-1]["road"] == point["road"]:
            steps[-1]["km"] += point["segment_km"]
            steps[-1]["last"] = index
        else:
            steps.append({"road": point["road"], "km": point["segment_km"], "first": index - 1, "last": index})
    return steps


def format_duration(minutes):
    minutes = int(round(minutes))
    return f"{minutes // 60} h {minutes % 60} min" if minutes >= 60 else f"{minutes} min"


SNAP_RADII_KM = (0.5, 1, 2, 3, 5, 8, 12, 20, 30, 50)


def router_command(folder, lat1, lon1, lat2, lon2, output, transport="motorcar"):
    return ["routino-router", f"--dir={folder}", "--prefix=routing",
            f"--profiles={ROUTINO_SHARE}/profiles.xml",
            f"--translations={ROUTINO_SHARE}/translations.xml", f"--transport={transport}",
            "--quickest", f"--lat1={lat1}", f"--lon1={lon1}", f"--lat2={lat2}", f"--lon2={lon2}",
            output, "--quiet"]


def snap_to_road(folder, lat, lon, work, transport="motorcar"):
    """Return (road_lat, road_lon, metres) for the drivable point nearest (lat, lon).

    Routino only snaps within about 1 km, so probe outward for any road, then keep probing
    closer rings around the original point until no probe finds a nearer road point.
    """
    cache = {}

    def probe(la, lo):
        key = (round(la, 6), round(lo, 6))
        if key not in cache:
            point = None
            result = subprocess.run(router_command(folder, la, lo, la, lo, "--output-text-all", transport),
                                    capture_output=True, text=True, cwd=work)
            if result.returncode == 0:
                try:
                    with open(os.path.join(work, "quickest-all.txt")) as handle:
                        found = parse_route_text(handle.read())
                    point = (found[0]["lat"], found[0]["lon"])
                except (OSError, IndexError, KeyError):
                    point = None
            cache[key] = point
        return cache[key]

    def around(radius_m, steps):
        for step in range(steps):
            angle = math.radians(step * 360.0 / steps)
            yield (lat + math.cos(angle) * radius_m / 111320.0,
                   lon + math.sin(angle) * radius_m / (111320.0 * max(math.cos(math.radians(lat)), 0.01)))

    best = probe(lat, lon)
    if best is None:
        for radius in SNAP_RADII_KM:
            for la, lo in around(radius * 1000.0, 16):
                best = probe(la, lo)
                if best:
                    break
            if best:
                break
    if best is None:
        raise RouteError("No drivable road within 50 km of that point in the downloaded areas.")
    best_distance = bearing_distance(lat, lon, *best)[0]
    for _ in range(5):
        improved = False
        for fraction in (0.15, 0.3, 0.5, 0.7, 0.85, 1.0):
            for la, lo in around(best_distance * fraction, 24):
                candidate = probe(la, lo)
                if candidate:
                    distance = bearing_distance(lat, lon, *candidate)[0]
                    if distance < best_distance - 1.0:
                        best, best_distance, improved = candidate, distance, True
        if not improved:
            break
    return best[0], best[1], best_distance if best_distance > 5 else 0.0


def trail_to(folder, work, road, outer):
    """Points from a road point out to (and ending at) the target, following trails when they get closer."""
    gap = bearing_distance(*road, *outer)[0]
    try:
        trail = snap_to_road(folder, outer[0], outer[1], work, "foot")
        if trail[2] < gap - 50:
            run_tool(router_command(folder, road[0], road[1], trail[0], trail[1], "--output-text-all", "foot"),
                     cwd=work)
            with open(os.path.join(work, "quickest-all.txt")) as handle:
                found = parse_route_text(handle.read())
            gain = gap - trail[2]
            # Skip trails that wander: the walk must be roughly as long as the ground it gains.
            if len(found) > 1 and found[-1]["total_km"] * 1000 <= 2 * gain + 200:
                return [(p["lat"], p["lon"]) for p in found] + [outer], found[-1]["total_km"], trail[2]
    except (RouteError, OSError):
        pass
    return [road, outer], 0.0, gap


def compute_route(lat1, lon1, lat2, lon2):
    folder = os.path.join(MAPS_DIR, "routing")
    if not os.path.exists(os.path.join(folder, "routing-nodes.mem")):
        raise RouteError("No offline area downloaded yet. Use Download County Area first.")
    if not shutil.which("routino-router"):
        raise RouteError("routino is not installed (sudo apt install routino).")
    import tempfile
    with tempfile.TemporaryDirectory() as work:
        start = snap_to_road(folder, lat1, lon1, work)
        end = snap_to_road(folder, lat2, lon2, work)
        run_tool(router_command(folder, start[0], start[1], end[0], end[1], "--output-text-all"), cwd=work)
        with open(os.path.join(work, "quickest-all.txt")) as handle:
            points = parse_route_text(handle.read())
        if len(points) < 2:
            raise RouteError("No route found.")
        start_path = end_path = []
        notes = []
        if start[2]:
            path, trail_km, left = trail_to(folder, work, (start[0], start[1]), (lat1, lon1))
            start_path = path[::-1]
            notes.append(f"You are {format_distance(start[2])} from the nearest road; "
                         + (f"a {trail_km:.1f} km trail/path gets you there (dashed red/purple)."
                            if trail_km else "the straight dashed line is off-road."))
        if end[2]:
            end_path, trail_km, left = trail_to(folder, work, (end[0], end[1]), (lat2, lon2))
            notes.append(f"The road ends {format_distance(end[2])} from the destination. "
                         + (f"A {trail_km:.1f} km trail/path continues to within {format_distance(left)}; "
                            "the rest is off-road (dashed red/purple)."
                            if trail_km else "The rest is off-road (dashed red/purple)."))
    steps = route_steps(points)
    return {"points": points, "km": points[-1]["total_km"], "minutes": points[-1]["total_min"],
            "steps": steps, "notes": notes, "off_road": (start_path, end_path)}


def route_path(route):
    """Every (lat, lon) along a route, off-road legs included, in travel order."""
    start_path, end_path = route.get("off_road", ([], []))
    return list(start_path) + [(p["lat"], p["lon"]) for p in route["points"]] + list(end_path)


def sample_path(path, count=80):
    """Evenly spaced (km_from_start, lat, lon) samples along a path."""
    cumulative = [0.0]
    for a, b in zip(path, path[1:]):
        cumulative.append(cumulative[-1] + bearing_distance(*a, *b)[0])
    total = cumulative[-1]
    if total <= 0 or len(path) < 2:
        return []
    samples, index = [], 0
    for step in range(count):
        target = total * step / (count - 1)
        while index < len(path) - 2 and cumulative[index + 1] < target:
            index += 1
        span = cumulative[index + 1] - cumulative[index]
        t = (target - cumulative[index]) / span if span else 0
        samples.append((target / 1000, path[index][0] + (path[index + 1][0] - path[index][0]) * t,
                        path[index][1] + (path[index + 1][1] - path[index][1]) * t))
    return samples


def elevation_profile(route, count=80):
    """[(km, metres)] along a route using the free Open-Meteo elevation service (needs internet)."""
    import urllib.parse
    import urllib.request
    samples = sample_path(route_path(route), count)
    if not samples:
        raise RouteError("Route too short for an elevation profile.")
    url = "https://api.open-meteo.com/v1/elevation?" + urllib.parse.urlencode(
        {"latitude": ",".join(f"{p[1]:.5f}" for p in samples),
         "longitude": ",".join(f"{p[2]:.5f}" for p in samples)})
    try:
        with urllib.request.urlopen(url, timeout=20) as response:
            heights = json.load(response)["elevation"]
    except (OSError, KeyError, ValueError) as error:
        raise RouteError(f"Elevation needs an internet connection ({error}).")
    return [(p[0], h) for p, h in zip(samples, heights)]


def profile_stats(profile):
    heights = [h for _, h in profile]
    gain = sum(max(b - a, 0) for a, b in zip(heights, heights[1:]))
    loss = sum(max(a - b, 0) for a, b in zip(heights, heights[1:]))
    return {"min": min(heights), "max": max(heights), "gain": gain, "loss": loss}


def system_is_dark():
    """True when the Ubuntu/GNOME appearance setting is dark."""
    def get(schema, key):
        try:
            return subprocess.run(["gsettings", "get", schema, key], capture_output=True,
                                  text=True, timeout=3).stdout.strip().strip("'")
        except (OSError, subprocess.SubprocessError):
            return ""
    scheme = get("org.gnome.desktop.interface", "color-scheme")
    if scheme in ("prefer-dark", "prefer-light"):
        return scheme == "prefer-dark"
    return "dark" in get("org.gnome.desktop.interface", "gtk-theme").lower()


DESKTOP_ID = "dell-gps-monitor.desktop"


def pin_to_dock():
    """Add the app to the Ubuntu dock once; a later manual unpin is respected."""
    import ast
    import os
    marker = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
                          "dell-rugged-7404", "dock-pinned")
    if os.path.exists(marker):
        return False
    try:
        out = subprocess.run(["gsettings", "get", "org.gnome.shell", "favorite-apps"],
                             capture_output=True, text=True, timeout=5)
        if out.returncode != 0:
            return False
        favorites = ast.literal_eval(out.stdout.strip().replace("@as ", ""))
        if DESKTOP_ID not in favorites:
            favorites.append(DESKTOP_ID)
            subprocess.run(["gsettings", "set", "org.gnome.shell", "favorite-apps", str(favorites)],
                           check=True, timeout=5)
        os.makedirs(os.path.dirname(marker), exist_ok=True)
        open(marker, "w").close()
        return True
    except (OSError, ValueError, SyntaxError, subprocess.SubprocessError):
        return False


TABS = ("LIVE", "SIGNALS", "NAVIGATE", "MAP", "TRACK", "TOOLS")
