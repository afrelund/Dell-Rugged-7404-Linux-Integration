#!/usr/bin/python3
"""Dell Rugged 7404 Setup: click to install each fix and see whether it is installed.

Nothing is installed until you press a button. Run with --first-run from the login
autostart entry: the window then opens only once per user.
"""
import json
import os
import shutil
import subprocess
import sys
import threading

STATUS_TOOL = "/usr/bin/dell-rugged-7404-status"
MARKER = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
                      "dell-rugged-7404", "setup-seen")
GREEN, ORANGE, RED = "#2e7d32", "#ef6c00", "#c62828"
STATES = {  # state -> (badge text, colour, button text)
    "installed": ("● Working", GREEN, "Working ✓"),
    "partial": ("● Error", ORANGE, "Fix"),
    "missing": ("● Not installed", RED, "Install"),
}
AMBER = "#f2b01e"


def load_status():
    out = subprocess.run([STATUS_TOOL, "--json"], capture_output=True, text=True, timeout=90).stdout
    return json.loads(out)


def install_command(key):
    """The speaker helper is per-user; everything else needs administrator rights."""
    if key == "speaker" or os.geteuid() == 0:
        return [STATUS_TOOL, "--apply", key]
    return ["pkexec", STATUS_TOOL, "--apply", key]


def mark_seen():
    try:
        os.makedirs(os.path.dirname(MARKER), exist_ok=True)
        open(MARKER, "w").close()
    except OSError:
        pass


ROWS = (
    ("touchscreen", "Touchscreen repair", "Keeps the eGalax touchscreen working (checks every few minutes)."),
    ("speaker", "Speaker fix", "Unmutes the HDA Intel PCH Headphone/Headset outputs that drive the speaker."),
    ("gps", "GPS support", "Installs gpsd and the GPS tools and attaches the u-blox receiver."),
    ("graphics", "Graphics driver", "Detects the GPUs and installs a driver only if Ubuntu recommends one."),
    ("smartcard", "Smart card / ID card (CAC)", "Installs the smart card service and tools so the ID card reader works."),
    ("rfid", "RFID / NFC reader", "Adds contactless tag support on top of the smart card service."),
    ("lte", "4G LTE modem", "Dell Wireless 5808e: enables ModemManager and checks the modem is detected."),
    ("sdr", "Software-defined radio", "RTL-SDR USB dongle: installs rtl-sdr and the Gqrx receiver."),
    ("battery", "Battery health", "Shows battery wear (informational; nothing to install)."),
    ("firmware", "Firmware updates", "Refreshes Dell firmware/BIOS updates (never installs them for you)."),
)


def build_css():
    css = "button.touch { min-height: 48px; padding: 6px 14px; }\n"
    css += "button.touch.wide { min-width: 120px; }\n"
    for name, colour in (("red", RED), ("orange", ORANGE), ("green", GREEN)):
        css += (f"button.state-{name} {{ background: {colour}; color: #ffffff; "
                f"background-image: none; }}\n")
    css += f"button.state-amber {{ background: {AMBER}; color: #000000; background-image: none; }}\n"
    css += ".card { padding: 10px; border-radius: 8px; background: alpha(currentColor, 0.07); }\n"
    for name, colour in (("red", RED), ("orange", ORANGE), ("green", GREEN), ("amber", AMBER)):
        css += f"label.badge-{name} {{ color: {colour}; font-weight: bold; }}\n"
    css += "label.dim { opacity: 0.7; }\n"
    return css


COLOUR_NAME = {GREEN: "green", ORANGE: "orange", RED: "red"}


def run_app():
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import GLib, Gtk, Pango

    GLib.set_prgname("dell-rugged-7404-setup")
    GLib.set_application_name("Dell Rugged 7404 Setup")

    class SetupWindow(Gtk.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Dell Rugged 7404 Setup")
            self.set_default_size(720, 760)
            self.set_icon_name("dell-rugged-7404-setup")
            self.rows = {}
            self.busy = None
            self.queue = []
            self.failed = set()
            self.state_classes = {}

            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            for side in ("top", "bottom", "start", "end"):
                getattr(outer, f"set_margin_{side}")(14)
            self.set_child(outer)

            title = Gtk.Label(label="Dell Latitude 14 Rugged Extreme 7404", xalign=0)
            title.set_markup("<span size='large' weight='bold'>Dell Latitude 14 Rugged Extreme 7404</span>")
            title.set_xalign(0)
            outer.append(title)
            intro = Gtk.Label(label="Click Install next to anything you want. Nothing changes until you click.",
                              xalign=0, wrap=True)
            outer.append(intro)

            scroller = Gtk.ScrolledWindow(vexpand=True, hexpand=True)
            scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroller.set_kinetic_scrolling(True)
            self.cards = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            scroller.set_child(self.cards)
            outer.append(scroller)
            for key, name, description in ROWS:
                self.make_row(key, name, description)

            controls = Gtk.Box(spacing=8)
            controls.set_homogeneous(False)
            self.all_button = self.plain_button(controls, "Install everything missing", lambda *_: self.start(
                [k for k, r in self.rows.items() if r["state"] in ("missing", "partial")]))
            self.refresh_button = self.plain_button(controls, "Refresh", lambda *_: self.refresh())
            gps = self.plain_button(controls, "Open GPS Monitor",
                                    lambda *_: subprocess.Popen(["/usr/bin/dell-gps-monitor"]))
            gps.set_sensitive(shutil.which("dell-gps-monitor") is not None)
            self.plain_button(controls, "Close", lambda *_: self.close())
            outer.append(controls)

            progress = Gtk.Label(label="Progress", xalign=0)
            progress.add_css_class("heading")
            outer.append(progress)
            self.log = Gtk.TextView(editable=False, cursor_visible=False, monospace=True,
                                    wrap_mode=Gtk.WrapMode.WORD_CHAR)
            self.log.set_left_margin(6)
            log_scroll = Gtk.ScrolledWindow(min_content_height=130)
            log_scroll.set_child(self.log)
            outer.append(log_scroll)
            self.log_scroll = log_scroll

            mark_seen()
            self.write("Checking what is installed ...")
            self.refresh()

        def plain_button(self, box, text, handler):
            button = Gtk.Button(label=text)
            button.add_css_class("touch")
            button.connect("clicked", handler)
            box.append(button)
            return button

        def make_row(self, key, name, description):
            card = Gtk.Box(spacing=10)
            card.add_css_class("card")
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            title = Gtk.Label(xalign=0)
            title.set_markup(f"<b>{GLib.markup_escape_text(name)}</b>")
            desc = Gtk.Label(label=description, xalign=0, wrap=True)
            desc.add_css_class("dim")
            detail = Gtk.Label(label="checking...", xalign=0, wrap=True)
            detail.add_css_class("dim")
            for widget in (title, desc, detail):
                text.append(widget)
            badge = Gtk.Label(label="…", width_chars=15)
            badge.set_valign(Gtk.Align.CENTER)
            button = Gtk.Button(label="Install", sensitive=False)
            button.add_css_class("touch")
            button.add_css_class("wide")
            button.set_valign(Gtk.Align.CENTER)
            button.connect("clicked", lambda *_: self.start([key]))
            for widget in (text, badge, button):
                card.append(widget)
            self.cards.append(card)
            self.rows[key] = {"badge": badge, "button": button, "detail": detail, "state": None,
                              "badge_class": None, "button_class": None}

        def style(self, row, badge_colour, button_colour):
            for widget, field, prefix, colour in (
                    (row["badge"], "badge_class", "badge-", badge_colour),
                    (row["button"], "button_class", "state-", button_colour)):
                if row[field]:
                    widget.remove_css_class(row[field])
                row[field] = prefix + colour
                widget.add_css_class(row[field])

        def write(self, text):
            buffer = self.log.get_buffer()
            buffer.insert(buffer.get_end_iter(), text.rstrip("\n") + "\n")
            mark = buffer.create_mark(None, buffer.get_end_iter(), False)
            self.log.scroll_mark_onscreen(mark)
            buffer.delete_mark(mark)
            return False

        def set_buttons(self, enabled):
            for row in self.rows.values():
                row["button"].set_sensitive(enabled)
            self.all_button.set_sensitive(enabled)
            return False

        def render(self, items):
            for item in items:
                row = self.rows[item["id"]]
                row["state"] = item["state"]
                state = item["state"]
                if item["id"] in self.failed and state != "installed":
                    state = "partial"
                badge, colour, action = STATES[state]
                row["badge"].set_label(badge)
                row["detail"].set_label(item["detail"])
                row["button"].set_label(action)
                self.style(row, COLOUR_NAME[colour], COLOUR_NAME[colour])
            self.set_buttons(True)
            return False

        def refresh(self):
            self.set_buttons(False)

            def work():
                try:
                    items = load_status()
                    GLib.idle_add(self.render, items)
                except (OSError, ValueError, subprocess.SubprocessError) as error:
                    GLib.idle_add(self.write, f"Could not read status: {error}")
                    GLib.idle_add(self.set_buttons, True)
            threading.Thread(target=work, daemon=True).start()

        def run_next(self):
            if not self.queue:
                self.busy = None
                self.write("Done.")
                self.refresh()
                return False
            key = self.queue.pop(0)
            self.busy = key
            row = self.rows[key]
            row["badge"].set_label("⟳ Installing...")
            row["button"].set_label("Working...")
            self.style(row, "amber", "amber")
            self.write(f"--- {key} ---")

            def work():
                try:
                    process = subprocess.Popen(install_command(key), stdout=subprocess.PIPE,
                                               stderr=subprocess.STDOUT, text=True)
                    for line in process.stdout:
                        GLib.idle_add(self.write, line)
                    code = process.wait()
                    if code in (126, 127):
                        GLib.idle_add(self.write, "Administrator authentication was cancelled or unavailable.")
                    elif code:
                        GLib.idle_add(self.write, f"Finished with exit code {code}.")
                    GLib.idle_add(self.failed.add if code else self.failed.discard, key)
                except OSError as error:
                    GLib.idle_add(self.write, f"Could not start: {error}")
                GLib.idle_add(self.run_next)
            threading.Thread(target=work, daemon=True).start()
            return False

        def start(self, keys):
            if self.busy is not None or not keys:
                return
            self.set_buttons(False)
            self.queue = list(keys)
            self.run_next()

    def on_activate(app):
        provider = Gtk.CssProvider()
        provider.load_from_data(build_css().encode())
        from gi.repository import Gdk
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        SetupWindow(app).present()

    app = Gtk.Application()
    app.connect("activate", on_activate)
    return app.run([sys.argv[0]])


def main():
    if "--first-run" in sys.argv and os.path.exists(MARKER):
        return 0
    return run_app()


if __name__ == "__main__":
    sys.exit(main())
