def run_app():
    import csv
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    from gi.repository import Gdk, GLib, Gtk, Pango

    state, stop = GpsState(), threading.Event()
    for target in (gpsd_reader, hw_poller):
        threading.Thread(target=target, args=(state, stop), daemon=True).start()

    GLib.set_prgname("dell-gps-monitor")
    GLib.set_application_name("Dell Rugged GPS Monitor")
    app = Gtk.Application()
    theme = {"dark": system_is_dark()}
    pal = dict(DARK if theme["dark"] else LIGHT)
    waypoints_file = os.path.join(DATA_DIR, "waypoints.json")
    waypoints = load_waypoints(waypoints_file)
    track = []
    log = {"writer": None, "handle": None, "path": None, "last": None, "export": None}
    nav = {"target": None, "tpv": {}, "alert": False, "message": None, "selected": None, "full_map": False}
    shown = {"text": ""}
    ui = {}

    def label(text="", css=None, wrap=False, xalign=0.0):
        widget = Gtk.Label(label=text, xalign=xalign, wrap=wrap, selectable=False)
        if css:
            widget.add_css_class(css)
        return widget

    def button(text, callback, css="action"):
        widget = Gtk.Button(label=text)
        widget.add_css_class(css)
        widget.connect("clicked", lambda _b: callback())
        return widget

    def scrolled(child):
        window = Gtk.ScrolledWindow(hexpand=True, vexpand=True, kinetic_scrolling=True,
                                    hscrollbar_policy=Gtk.PolicyType.NEVER)
        window.set_child(child)
        return window

    def message_dialog(title, text, on_yes=None):
        dialog = Gtk.Window(title=title, modal=True, transient_for=ui["win"], resizable=False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin_top=16,
                      margin_bottom=16, margin_start=16, margin_end=16)
        box.append(label(text, wrap=True))
        row = Gtk.Box(spacing=8, homogeneous=True)

        def finish(yes):
            dialog.destroy()
            if yes and on_yes:
                on_yes()
        if on_yes:
            row.append(button("Cancel", lambda: finish(False)))
            row.append(button("Continue", lambda: finish(True)))
        else:
            row.append(button("OK", lambda: finish(False)))
        box.append(row)
        dialog.set_child(box)
        dialog.present()

    def ask_name(default, on_done):
        dialog = Gtk.Window(title="Waypoint", modal=True, transient_for=ui["win"], resizable=False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=16,
                      margin_bottom=16, margin_start=16, margin_end=16)
        box.append(label("Name:"))
        entry = Gtk.Entry(text=default, width_chars=28)
        box.append(entry)
        row = Gtk.Box(spacing=8, homogeneous=True)

        def finish(ok):
            name = entry.get_text().strip()
            dialog.destroy()
            if ok and name:
                on_done(name)
        row.append(button("Cancel", lambda: finish(False)))
        row.append(button("Add", lambda: finish(True)))
        entry.connect("activate", lambda _e: finish(True))
        box.append(row)
        dialog.set_child(box)
        dialog.present()

    def copy_text(text, note="Copied"):
        ui["win"].get_clipboard().set(text)
        ui["copy_button"].set_label(f"{note}: {text[:34]}")
        GLib.timeout_add(1500, lambda: ui["copy_button"].set_label("Copy coordinates and time") and False)

    # ----- cairo helpers -----
    def text_at(cr, x, y, text, size=11, color=None, bold=False, anchor="c", mono=False):
        cr.select_font_face("monospace" if mono else "DejaVu Sans", 0, 1 if bold else 0)
        cr.set_font_size(size)
        ext = cr.text_extents(text)
        if anchor == "c":
            px, py = x - ext.width / 2 - ext.x_bearing, y + ext.height / 2
        elif anchor == "l":
            px, py = x, y + ext.height / 2
        elif anchor == "nw":
            px, py = x, y + ext.height
        elif anchor == "sw":
            px, py = x, y
        else:  # "se"
            px, py = x - ext.width, y
        cr.set_source_rgb(*hex_rgb(color or pal["fg"]))
        cr.move_to(px, py)
        cr.show_text(text)

    def fill_bg(cr, width, height):
        cr.set_source_rgb(*hex_rgb(pal["sky"]))
        cr.paint()

    def line(cr, x0, y0, x1, y1, color, width=1, dash=None):
        cr.set_source_rgb(*hex_rgb(color))
        cr.set_line_width(width)
        cr.set_dash(dash or [])
        cr.move_to(x0, y0)
        cr.line_to(x1, y1)
        cr.stroke()
        cr.set_dash([])

    def circle(cr, x, y, r, outline=None, fill=None, width=1):
        cr.new_path()
        cr.arc(x, y, r, 0, 2 * math.pi)
        if fill:
            cr.set_source_rgb(*hex_rgb(fill))
            cr.fill_preserve()
        if outline:
            cr.set_source_rgb(*hex_rgb(outline))
            cr.set_line_width(width)
            cr.stroke()
        cr.new_path()

    def arrow(cr, cx, cy, x, y, color, width, head):
        line(cr, cx, cy, cx + x, cy + y, color, width)
        angle = math.atan2(y, x)
        tip = (cx + x, cy + y)
        cr.set_source_rgb(*hex_rgb(color))
        cr.move_to(*tip)
        for side in (0.4, -0.4):
            cr.line_to(tip[0] - head * math.cos(angle + side), tip[1] - head * math.sin(angle + side))
        cr.close_path()
        cr.fill()

    # ----- drawing -----
    def draw_sky(_area, cr, width, height):
        fill_bg(cr, width, height)
        cx, cy, radius = width / 2, height / 2, max(min(width, height) / 2 - 26, 20)
        for elevation in (0, 30, 60):
            r = (90 - elevation) / 90 * radius
            circle(cr, cx, cy, r, outline=pal["ring"])
            if elevation:
                text_at(cr, cx + 4, cy - r + 2, f"{elevation}°", 10, pal["ringtext"], anchor="nw")
        line(cr, cx - radius, cy, cx + radius, cy, pal["cross"])
        line(cr, cx, cy - radius, cx, cy + radius, pal["cross"])
        for text, azimuth in (("N", 0), ("E", 90), ("S", 180), ("W", 270)):
            x, y = sky_xy(azimuth, -4, radius)
            text_at(cr, cx + x, cy + y, text, 13, bold=True)
        for sat in ui["sky"]:
            if "az" not in sat or "el" not in sat:
                continue
            _name, color = CONSTELLATIONS.get(sat.get("gnssid"), ("?", "#616161"))
            x, y = sky_xy(sat["az"], sat["el"], radius)
            r, used = 12, sat.get("used")
            circle(cr, cx + x, cy + y, r, outline=color, fill=color if used else pal["hollow"], width=2)
            text_at(cr, cx + x, cy + y, str(sat.get("svid", sat.get("PRN", ""))), 9,
                    "#ffffff" if used else color, bold=True)
            text_at(cr, cx + x, cy + y + r + 8, f"{sat.get('ss', 0):.0f}", 8, pal["ss"])

    def draw_bars(_area, cr, width, height):
        fill_bg(cr, width, height)
        top, foot, left_pad = 8, 24, 26
        plot = height - top - foot
        for level in (20, 40):
            y = top + plot * (1 - level / 55)
            line(cr, left_pad, y, width, y, pal["cross"])
            text_at(cr, 2, y, str(level), 9, pal["ringtext"], anchor="l")
        sats = sorted((s for s in ui["sky"] if s.get("ss") is not None),
                      key=lambda s: (s.get("gnssid", 9), s.get("svid", 0)))
        if not sats:
            text_at(cr, width / 2, height / 2, "no satellites", 11)
            return
        slot = (width - left_pad - 4) / len(sats)
        for index, sat in enumerate(sats):
            color = CONSTELLATIONS.get(sat.get("gnssid"), ("?", "#616161"))[1]
            x0 = left_pad + index * slot + slot * 0.12
            x1 = left_pad + (index + 1) * slot - slot * 0.12
            y0 = top + plot * (1 - min(sat["ss"], 55) / 55)
            cr.rectangle(x0, y0, x1 - x0, top + plot - y0)
            cr.set_source_rgb(*hex_rgb(color))
            if sat.get("used"):
                cr.fill_preserve()
            cr.set_line_width(2)
            cr.stroke()
            if slot >= 14:
                text_at(cr, (x0 + x1) / 2, top + plot + 11, str(sat.get("svid", "")), 9)

    def draw_jam_history(_area, cr, width, height):
        fill_bg(cr, width, height)
        history = ui["history"]
        left_pad, top, foot = 30, 6, 16
        plot = height - top - foot

        def y_of(value):
            return top + plot * (1 - value / 255)
        for level, color in ((40, AMBER), (100, "#c62828")):
            line(cr, left_pad, y_of(level), width, y_of(level), color, 1, [4, 3])
            text_at(cr, 2, y_of(level), str(level), 9, pal["ringtext"], anchor="l")
        if len(history) < 2:
            text_at(cr, width / 2, height / 2, "collecting data...", 11)
            return
        start, end = history[0][0], history[-1][0]
        span = max(end - start, 1)
        points = [(left_pad + (t - start) / span * (width - left_pad - 4), y_of(v), v) for t, v in history]
        for (x0, y0, _), (x1, y1, v1) in zip(points, points[1:]):
            line(cr, x0, y0, x1, y1, jam_level(v1)[1], 2)
        text_at(cr, left_pad, height - 2, f"-{span / 60:.0f} min", 9, pal["ringtext"], anchor="sw")
        text_at(cr, width - 4, height - 2, "now", 9, pal["ringtext"], anchor="se")

    def draw_jam_bar(_area, cr, width, height):
        cr.set_source_rgb(*hex_rgb(pal["bar"]))
        cr.paint()
        value = ui["jam_value"]
        if value is not None:
            cr.set_source_rgb(*hex_rgb(jam_level(value)[1]))
            cr.rectangle(0, 0, width * value / 255, height)
            cr.fill()

    def draw_compass(_area, cr, width, height):
        fill_bg(cr, width, height)
        cx, cy = width / 2, height / 2
        radius = max(min(width, height) / 2 - 20, 20)
        circle(cr, cx, cy, radius, outline=pal["ring"], width=2)
        for text, angle in (("N", 0), ("E", 90), ("S", 180), ("W", 270)):
            x, y = sky_xy(angle, -6, radius + 1)
            text_at(cr, cx + x, cy + y, text, 13, bold=True)
        for angle in range(0, 360, 30):
            x0, y0 = sky_xy(angle, 0, radius)
            x1, y1 = sky_xy(angle, 6, radius)
            line(cr, cx + x0, cy + y0, cx + x1, cy + y1, pal["ring"])
        if ui["bearing"] is not None:
            x, y = sky_xy(ui["bearing"], 8, radius)
            arrow(cr, cx, cy, x, y, "#1565c0", 5, 16)
        if ui["heading"] is not None:
            x, y = sky_xy(ui["heading"], 12, radius)
            arrow(cr, cx, cy, x, y, AMBER, 3, 13)
        circle(cr, cx, cy, 4, fill=pal["fg"])

    def drawing(func, height=-1, width=-1, expand=False):
        area = Gtk.DrawingArea(content_height=max(height, 0), content_width=max(width, 0), hexpand=True,
                           vexpand=expand)
        area.set_draw_func(func)
        return area

    ui.update(sky=[], history=[], jam_value=None, heading=None, bearing=None)

    # ----- window -----
    def activate(application):
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = Gtk.ApplicationWindow(application=application, title="Dell Rugged GPS Monitor",
                                    default_width=1180, default_height=720, icon_name="dell-gps-monitor")
        ui["win"] = win
        root = Gtk.Box(spacing=8, margin_top=8, margin_bottom=8, margin_start=8, margin_end=8)
        win.set_child(root)

        # left: sky view
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, hexpand=True)
        ui["status"] = label("", "status", xalign=1.0)
        ui["status"].set_halign(Gtk.Align.END)
        ui["status"].set_valign(Gtk.Align.START)
        ui["status"].set_margin_top(8)
        ui["status"].set_margin_end(12)
        ui["sky_area"] = drawing(draw_sky, 400, 400, expand=True)
        sky_overlay = Gtk.Overlay(vexpand=True)
        sky_overlay.set_child(ui["sky_area"])
        sky_overlay.add_overlay(ui["status"])
        top_stack = Gtk.Stack(vexpand=True)
        top_stack.add_named(sky_overlay, "sky")
        dir_panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        top_stack.add_named(dir_panel, "dir")
        ui["top_stack"], ui["dir_panel"] = top_stack, dir_panel
        left.append(top_stack)
        legend = Gtk.Box(spacing=8)
        for name, color in CONSTELLATIONS.values():
            tag = Gtk.Label(use_markup=True)
            tag.set_markup(f'<span foreground="{color}" weight="bold">● {GLib.markup_escape_text(name)}</span>')
            legend.append(tag)
        left.append(legend)
        left.append(label("Filled = used in fix, hollow = tracked only; number below satellite = dB-Hz",
                          "hint", wrap=True))
        root.append(left)
        ui["left"] = left

        # right: status + tabs
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, width_request=500)
        tabbar = Gtk.Box(spacing=4, homogeneous=True, margin_top=4, margin_bottom=6)
        stack = Gtk.Stack(vexpand=True, hexpand=True)
        ui["stack"] = stack
        group, tab_buttons = None, {}
        for name in TABS:
            toggle = Gtk.ToggleButton(label=name, hexpand=True)
            toggle.add_css_class("tab-button")
            if group is None:
                group = toggle
            else:
                toggle.set_group(group)
            toggle.connect("toggled", lambda b, n=name: b.get_active() and show(n))
            tab_buttons[name] = toggle
            tabbar.append(toggle)
        right.append(tabbar)
        ui["tabbar"], ui["right"] = tabbar, right
        right.append(stack)
        root.append(right)

        def show(name):
            stack.set_visible_child_name(name)
            refresh()

        # LIVE
        live = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        ui["live_box"] = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        ui["live_scroll"] = scrolled(ui["live_box"])
        live.append(ui["live_scroll"])
        live.append(label("JAMMING INDICATOR", "bold"))
        ui["jam_bar"] = drawing(draw_jam_bar, 26)
        live.append(ui["jam_bar"])
        ui["jam_text"] = label("", "mono")
        live.append(ui["jam_text"])
        live.append(label("Tap any value above to copy it", "hint"))
        ui["copy_button"] = button("Copy coordinates and time",
                                   lambda: copy_text(shown["text"], "Copied all"))
        live.append(ui["copy_button"])
        stack.add_named(live, "LIVE")

        # SIGNALS
        sig = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        dash = Gtk.Box(homogeneous=True, spacing=6)
        ui["dash"] = {}
        for key in ("FIX", "HDOP", "VDOP", "PDOP", "ACCURACY"):
            cell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            cell.append(label(key, "hint", xalign=0.5))
            ui["dash"][key] = Gtk.Label(use_markup=True)
            cell.append(ui["dash"][key])
            dash.append(cell)
        sig.append(dash)
        sig.append(label("SIGNAL STRENGTH (dB-Hz)", "bold"))
        sig.append(drawing(draw_bars, 200, expand=True))
        sig.append(label("JAMMING HISTORY", "bold"))
        sig.append(drawing(draw_jam_history, 170, expand=True))
        sig.append(label("Amber line = possible interference, red line = strong interference", "hint"))
        stack.add_named(sig, "SIGNALS")

        # NAVIGATE
        navp = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        ui["compass"] = drawing(draw_compass, 240)
        navp.append(ui["compass"])
        ui["nav_text"] = label("", "mono")
        navp.append(ui["nav_text"])
        ui["wp_list"] = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        ui["wp_list"].connect("row-selected", lambda _l, row: nav.update(
            selected=waypoints[row.get_index()] if row is not None else None))
        navp.append(scrolled(ui["wp_list"]))
        wp_buttons = Gtk.Box(spacing=4, homogeneous=True)
        for text, command in (("Add waypoint here", add_waypoint), ("Go to selected", set_target),
                              ("Clear target", clear_target), ("Delete", delete_waypoint)):
            btn = button(text, command)
            wp_buttons.append(btn)
        navp.append(wp_buttons)
        stack.add_named(navp, "NAVIGATE")

        # MAP
        mapp = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        try:
            gi.require_version("Shumate", "1.0")
            from gi.repository import Shumate
            simple = Shumate.SimpleMap(vexpand=True, hexpand=True)
            registry = Shumate.MapSourceRegistry.new_with_defaults()
            simple.set_map_source(registry.get_by_id(Shumate.MAP_SOURCE_OSM_MAPNIK))
            if theme["dark"]:
                simple.add_css_class("dark-map")
            ui["map_widget"] = simple
            viewport = simple.get_viewport()
            # Touch only pans; zoom comes from the +/- buttons or keys.
            for gesture in list(simple.get_map().observe_controllers()):
                if isinstance(gesture, (Gtk.GestureZoom, Gtk.GestureRotate, Gtk.GestureClick)):
                    simple.get_map().remove_controller(gesture)
            viewport.set_zoom_level(3)
            layer = Shumate.MarkerLayer.new(viewport)
            marker = Shumate.Marker()
            marker_label = Gtk.Label(label="\u25cf")
            marker_label.add_css_class("map-marker")
            marker.set_child(marker_label)
            layer.add_marker(marker)
            simple.add_overlay_layer(layer)
            wp_layer = Shumate.MarkerLayer.new(viewport)
            simple.add_overlay_layer(wp_layer)
            ui["map"] = {"simple": simple, "viewport": viewport, "marker": marker, "follow": True, "placed": False}

            def draw_map_waypoints():
                wp_layer.remove_all()
                for wp in waypoints:
                    pin = Shumate.Marker()
                    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                    box.append(Gtk.Label(label=wp["name"], css_classes=["wp-tag"]))
                    box.append(Gtk.Label(label="\u25b2", css_classes=["wp-pin"]))
                    pin.set_child(box)
                    pin.set_location(wp["lat"], wp["lon"])
                    wp_layer.add_marker(pin)
            ui["draw_map_waypoints"] = draw_map_waypoints

            cell_layer = Shumate.MarkerLayer.new(viewport)
            simple.add_overlay_layer(cell_layer)
            cells = {"on": False, "seen": {}, "pending": False, "serving": ""}
            ui["cell_note"] = label("", "hint", wrap=True)

            def tower_symbol(color):
                def draw(_area, cr, width, height):
                    r, g, b = hex_rgb(color)
                    cx = width / 2

                    def tower(dx=0, dy=0):
                        x = cx + dx
                        cr.move_to(x - width * 0.05, height * 0.06 + dy)
                        cr.line_to(x + width * 0.05, height * 0.06 + dy)
                        cr.line_to(x + width * 0.10, height * 0.88 + dy)
                        cr.line_to(x + width * 0.26, height * 0.94 + dy)
                        cr.line_to(x - width * 0.26, height * 0.94 + dy)
                        cr.line_to(x - width * 0.10, height * 0.88 + dy)
                        cr.close_path()
                        for side in (-1, 1):
                            px = x + side * width * 0.14
                            cr.rectangle(px - width * 0.05, height * 0.05 + dy, width * 0.10, height * 0.30)

                    cr.set_source_rgba(0, 0, 0, 0.35)
                    tower(width * 0.05, height * 0.04)
                    cr.fill()
                    cr.set_source_rgb(r, g, b)
                    tower()
                    cr.fill()
                return draw

            def draw_cells():
                cell_layer.remove_all()
                if not cells["on"]:
                    return
                width, height = simple.get_width(), simple.get_height()
                if viewport.get_zoom_level() < 11 or width < 10:
                    ui["cell_note"].set_label("Zoom in (11+) to see towers. " + cells["serving"])
                    return
                n, w = viewport.widget_coords_to_location(simple, 0, 0)
                s_, e = viewport.widget_coords_to_location(simple, width, height)
                found = cells_in_bbox(min(s_, n), min(w, e), max(s_, n), max(w, e), 1000)
                centre_lat, centre_lon = (n + s_) / 2, (w + e) / 2
                found.sort(key=lambda t: (t[5] - centre_lat) ** 2 + (t[6] - centre_lon) ** 2)
                found = found[:120]
                for radio, mcc, net, area, cell, lat, lon in found:
                    quality = cells["seen"].get((mcc, net, cell))
                    icon = Gtk.DrawingArea(content_width=26, content_height=30)
                    icon.set_draw_func(tower_symbol(signal_color(quality)))
                    icon.set_tooltip_text(f"{radio} {mcc}-{net} area {area} cell {cell}"
                                          + (f" - signal {quality}%" if quality else " - not heard"))
                    pin = Shumate.Marker()
                    pin.set_child(icon)
                    pin.set_location(lat, lon)
                    cell_layer.add_marker(pin)
                ui["cell_note"].set_label((f"{len(found)} towers shown" if found else
                                           "No towers here - import a tower CSV (Cell Towers CSV)") +
                                          ". " + cells["serving"])

            def schedule_cells(*_args):
                # Redraw only once the map has stopped moving, so zoom and pan stay responsive.
                if not cells["on"]:
                    return
                if cells["pending"]:
                    GLib.source_remove(cells["pending"])

                def run():
                    cells["pending"] = False
                    draw_cells()
                    return False
                cells["pending"] = GLib.timeout_add(800, run)
            for prop in ("latitude", "longitude", "zoom-level"):
                viewport.connect(f"notify::{prop}", schedule_cells)

            def poll_modem():
                def work():
                    info = read_modem()
                    GLib.idle_add(apply_modem, info)
                threading.Thread(target=work, daemon=True).start()
                return True

            def apply_modem(info):
                if not info:
                    cells["serving"] = "No cellular modem found."
                elif "cid" in info:
                    cells["seen"][(info["mcc"], info["mnc"], info["cid"])] = info["quality"]
                    cells["serving"] = (f"Serving cell {info['mcc']}-{info['mnc']} #{info['cid']}, "
                                        f"signal {info['quality']}%.")
                    if cells["on"] and cells.get("last") != (info["cid"], info["quality"]):
                        cells["last"] = (info["cid"], info["quality"])
                        draw_cells()
                else:
                    reason = info.get("failed") or info.get("state") or "unknown"
                    cells["serving"] = ("Modem: no SIM card, so no towers can be heard." if reason == "sim-missing"
                                        else f"Modem: {reason}; not registered on a network.")
                return False
            GLib.timeout_add(8000, poll_modem)

            def toggle_cells():
                cells["on"] = not cells["on"]
                ui["cell_button"].set_label("Cell towers: " + ("On" if cells["on"] else "Off"))
                ui["cell_note"].set_visible(cells["on"])
                if cells["on"]:
                    poll_modem()
                draw_cells()

            def cell_dialog():
                dialog = Gtk.Window(title="Cell Towers CSV", modal=True, transient_for=ui["win"],
                                    default_width=520)
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=12,
                              margin_bottom=12, margin_start=12, margin_end=12)
                box.append(label("Tower locations from an OpenCellID-format CSV.", "bold"))
                box.append(label("Get a CSV from opencellid.org (free account), or download it below with "
                                 "your API token. Towers are coloured by signal heard by the cellular modem: "
                                 "red = not heard, amber = weak, yellow = fair, green = good.",
                                 "hint", wrap=True))
                status = label(f"{cell_count():,} towers loaded.", "mono", wrap=True)
                box.append(status)
                busy = {"on": False}

                def say(text):
                    GLib.idle_add(lambda: status.set_label(text) or False)

                def run_job(job):
                    if busy["on"]:
                        return
                    busy["on"] = True

                    def work():
                        try:
                            job()
                            say(f"{cell_count():,} towers loaded.")
                        except Exception as error:
                            say(f"Error: {error}")
                        busy["on"] = False
                        GLib.idle_add(lambda: draw_cells() or False)
                    threading.Thread(target=work, daemon=True).start()

                def choose_file():
                    chooser = Gtk.FileDialog(title="Choose an OpenCellID CSV")

                    def chosen(source, result):
                        try:
                            path = source.open_finish(result).get_path()
                        except GLib.Error:
                            return
                        run_job(lambda: import_cell_csv(path, say))
                    chooser.open(dialog, None, chosen)
                box.append(button("Import CSV file…", choose_file))
                token = Gtk.Entry(placeholder_text="OpenCellID API token")
                token.set_text(load_cell_token())
                token.set_size_request(-1, 44)
                mcc = Gtk.Entry(placeholder_text="Country code (MCC), e.g. 310 for the US")
                mcc.set_size_request(-1, 44)
                box.append(token)
                box.append(mcc)
                box.append(button("Download towers for my downloaded counties", lambda: run_job(
                    lambda: download_cells_for_areas(token.get_text().strip(), say))))
                box.append(label("The token is saved, and towers are then fetched automatically whenever you "
                                 "download a county for routing or imagery. Or use a country code:",
                                 "hint", wrap=True))
                def by_api():
                    tpv = nav["tpv"]
                    here = (tpv["lat"], tpv["lon"]) if tpv.get("mode", 0) >= 2 and "lat" in tpv else None
                    run_job(lambda: download_cells_api(token.get_text().strip(),
                                                       list(downloaded_county_bboxes().values()), here, say))
                box.append(button("Download my counties via API (resumes daily)", by_api))
                box.append(button("Download by country code", lambda: run_job(
                    lambda: download_cells(token.get_text().strip(), mcc.get_text().strip(), say))))
                box.append(button("Remove all tower data", lambda: run_job(clear_cells)))
                box.append(button("Close", dialog.destroy))
                dialog.set_child(box)
                dialog.present()

            route_layer = Shumate.PathLayer.new(viewport)
            route_layer.set_stroke_width(6)
            route_layer.set_stroke_color(Gdk.RGBA(red=0.1, green=0.5, blue=1.0, alpha=0.9))
            simple.add_overlay_layer(route_layer)
            off_road_layers = []
            # Red and purple dashes alternate: the purple pattern is shifted by half a period.
            for _ in range(2):
                pair = []
                for color, dash in ((Gdk.RGBA(red=0.9, green=0.1, blue=0.1, alpha=1), [8, 8]),
                                    (Gdk.RGBA(red=0.6, green=0.2, blue=0.85, alpha=1), [0, 8, 8, 0])):
                    layer = Shumate.PathLayer.new(viewport)
                    layer.set_stroke_width(5)
                    layer.set_stroke_color(color)
                    layer.set_dash(dash)
                    simple.add_overlay_layer(layer)
                    pair.append(layer)
                off_road_layers.append(pair)
            nav["route"] = None

            def draw_elevation(_area, cr, width, height):
                fill_bg(cr, width, height)
                profile = ui.get("elevation")
                if not profile:
                    text_at(cr, width / 2, height / 2, ui.get("elevation_note", "loading elevation..."), 11)
                    return
                stats = profile_stats(profile)
                low, high = stats["min"], max(stats["max"], stats["min"] + 10)
                left_pad, top, foot = 48, 18, 16
                plot_h, plot_w = height - top - foot, width - left_pad - 6
                km_total = max(profile[-1][0], 0.001)
                points = [(left_pad + km / km_total * plot_w, top + plot_h * (1 - (h - low) / (high - low)))
                          for km, h in profile]
                cr.move_to(points[0][0], top + plot_h)
                for x, y in points:
                    cr.line_to(x, y)
                cr.line_to(points[-1][0], top + plot_h)
                cr.close_path()
                cr.set_source_rgba(0.95, 0.70, 0.12, 0.35)
                cr.fill()
                for (x0, y0), (x1, y1) in zip(points, points[1:]):
                    line(cr, x0, y0, x1, y1, AMBER, 2)
                text_at(cr, 2, top, f"{high:.0f} m", 9, pal["ringtext"], anchor="l")
                text_at(cr, 2, top + plot_h, f"{low:.0f} m", 9, pal["ringtext"], anchor="l")
                text_at(cr, left_pad, height - 2, "0 km", 9, pal["ringtext"], anchor="sw")
                text_at(cr, width - 4, height - 2, f"{km_total:.1f} km", 9, pal["ringtext"], anchor="se")
                text_at(cr, width / 2, 8, f"ELEVATION  ▲ {stats['gain']:.0f} m  ▼ {stats['loss']:.0f} m  "
                        f"({stats['gain'] * 3.28084:.0f} / {stats['loss'] * 3.28084:.0f} ft)", 10)

            elevation_area = drawing(draw_elevation, 120)
            elevation_area.set_visible(False)
            ui["elevation_area"] = elevation_area

            def load_elevation(route):
                ui["elevation"], ui["elevation_note"] = None, "loading elevation..."
                elevation_area.set_visible(True)
                elevation_area.queue_draw()

                def work():
                    try:
                        profile, note = elevation_profile(route), ""
                    except Exception as error:
                        profile, note = None, str(error)
                    GLib.idle_add(show_elevation, route, profile, note)
                threading.Thread(target=work, daemon=True).start()

            def show_elevation(route, profile, note):
                if nav["route"] is route:
                    ui["elevation"], ui["elevation_note"] = profile, note
                    elevation_area.queue_draw()
                return False

            def update_directions(lat, lon):
                route, rows = nav["route"], ui.get("dir_rows")
                if not route or not rows:
                    return
                nearest = min(range(len(route["points"])),
                              key=lambda i: bearing_distance(lat, lon, route["points"][i]["lat"],
                                                             route["points"][i]["lon"])[0])
                current = next((i for i, st in enumerate(route["steps"]) if st["last"] >= nearest),
                               len(rows) - 1)
                if ui.get("dir_current") == current:
                    return
                ui["dir_current"] = current
                for i, row in enumerate(rows):
                    for name in ("step-done", "step-current", "step-next"):
                        row.remove_css_class(name)
                    row.add_css_class("step-done" if i < current else "step-current" if i == current
                                      else "step-next" if i == current + 1 else "step-row")
                    row.add_css_class("step-row")
                adjustment = ui["dir_scroll"].get_vadjustment()
                GLib.idle_add(lambda: adjustment.set_value(max(rows[current].get_allocation().y - 40, 0)) and False)

            ui["update_directions"] = update_directions

            def clear_route():
                ui["top_stack"].set_visible_child_name("sky")
                ui["dir_rows"], ui["dir_current"] = None, None
                ui["elevation"] = None
                elevation_area.set_visible(False)
                for layer in [route_layer] + [x for pair in off_road_layers for x in pair]:
                    for node in list(layer.get_nodes()):
                        layer.remove_node(node)
                nav["route"] = None
                ui["route_button"].set_label("Route to target")

            def show_directions(route):
                panel = ui["dir_panel"]
                while panel.get_first_child():
                    panel.remove(panel.get_first_child())
                panel.append(label(f"DIRECTIONS  {route['km']:.1f} km · {format_duration(route['minutes'])}",
                                   "bold"))
                if route["notes"]:
                    panel.append(label("\n".join(route["notes"]), "hint", wrap=True))
                listing = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                rows = []
                for n, step in enumerate(route["steps"], 1):
                    row = label(f"{n}. {step['road']} \u2013 {step['km']:.1f} km", wrap=True, xalign=0)
                    row.add_css_class("step-row")
                    listing.append(row)
                    rows.append(row)
                ui["dir_rows"], ui["dir_current"] = rows, None
                ui["dir_scroll"] = scrolled(listing)
                ui["dir_scroll"].set_vexpand(True)
                panel.append(ui["dir_scroll"])
                panel.append(button("Back to satellites", lambda: ui["top_stack"].set_visible_child_name("sky")))
                ui["top_stack"].set_visible_child_name("dir")
                tpv = nav["tpv"]
                update_directions(tpv.get("lat", route["points"][0]["lat"]),
                                  tpv.get("lon", route["points"][0]["lon"]))

            def route_to_target():
                if nav["route"] is not None:
                    clear_route()
                    return
                choose_destination()

            def choose_destination():
                dialog = Gtk.Window(title="Route to…", modal=True, transient_for=ui["win"],
                                    default_width=520, default_height=600)
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=12,
                              margin_bottom=12, margin_start=12, margin_end=12)
                box.append(label("Choose a destination", "bold"))

                def pick_waypoint(wp):
                    dialog.destroy()
                    nav["target"] = wp
                    refresh_waypoints()
                    start_route(wp["lat"], wp["lon"])

                def pick_on_map():
                    dialog.destroy()
                    placing(True, "route")
                box.append(button("Pick a point on the map", pick_on_map))
                box.append(label("ADDRESS OR GRID COORDINATE", "bold"))
                search = Gtk.Entry(placeholder_text="Address, lat/lon, DMS, UTM or MGRS")
                search.set_size_request(-1, 48)
                box.append(search)
                found = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)

                def go_to(lat, lon):
                    dialog.destroy()
                    start_route(lat, lon)

                def show_results(results, note):
                    child = found.get_first_child()
                    while child:
                        following = child.get_next_sibling()
                        found.remove(child)
                        child = following
                    found.append(label(note, "hint", wrap=True))
                    for name, lat, lon in results:
                        found.append(button(f"{name}\n{lat:.5f}, {lon:.5f}",
                                            lambda la=lat, lo=lon: go_to(la, lo)))

                def lookup(*_):
                    query = search.get_text().strip()
                    if not query:
                        return
                    parsed = parse_coordinate(query)
                    if parsed:
                        lat, lon, kind = parsed
                        show_results([(f"Route to {kind} point", lat, lon)], f"Recognised as {kind}.")
                        return
                    show_results([], "Looking up address…")

                    def work():
                        try:
                            results, note = geocode_address(query), ""
                        except Exception as error:
                            results, note = [], str(error)
                        GLib.idle_add(show_results, results,
                                      note or ("Pick the match:" if results else "No address found."))
                    threading.Thread(target=work, daemon=True).start()
                search.connect("activate", lookup)
                box.append(button("Find", lookup))
                box.append(found)
                box.append(label("WAYPOINTS", "bold"))
                names = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                if not waypoints:
                    names.append(label("No waypoints saved yet.", "hint"))
                for wp in waypoints:
                    names.append(button(f"{wp['name']}   {wp['lat']:.4f}, {wp['lon']:.4f}",
                                        lambda w=wp: pick_waypoint(w)))
                box.append(scrolled(names))
                box.append(button("Cancel", dialog.destroy))
                dialog.set_child(box)
                dialog.present()

            def start_route(dest_lat, dest_lon):
                tpv = nav["tpv"]
                if tpv.get("mode", 0) < 2 or "lat" not in tpv:
                    message_dialog("Route", "No GPS fix yet.")
                    return
                ui["route_note"].set_label("Routing…")

                def work():
                    try:
                        result = compute_route(tpv["lat"], tpv["lon"], dest_lat, dest_lon)
                    except Exception as error:
                        GLib.idle_add(finish, None, str(error))
                        return
                    GLib.idle_add(finish, result, "")

                def finish(result, error):
                    ui["route_note"].set_label("")
                    if result is None:
                        message_dialog("Route", error)
                        return False
                    nav["route"] = result
                    for lat, lon in [(p["lat"], p["lon"]) for p in result["points"]]:
                        route_layer.add_node(Shumate.Coordinate.new_full(lat, lon))
                    for pair, path in zip(off_road_layers, result["off_road"]):
                        for layer in pair:
                            for lat, lon in path:
                                layer.add_node(Shumate.Coordinate.new_full(lat, lon))
                    ui["route_button"].set_label("Clear route")
                    load_elevation(result)
                    ui["route_note"].set_label(f"{result['km']:.1f} km · {format_duration(result['minutes'])}")
                    show_directions(result)
                    return False
                threading.Thread(target=work, daemon=True).start()

            def area_dialog():
                dialog = Gtk.Window(title="Download County Area", modal=True, transient_for=ui["win"],
                                    default_width=520)
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=12,
                              margin_bottom=12, margin_start=12, margin_end=12)
                box.append(label("Download a county's roads for offline routing.", "bold"))
                box.append(label("Gets the state's OpenStreetMap data (from tens to a few hundred MB), "
                                 "cuts out the county and builds a local routing database. "
                                 "Needs internet only for this step.", "hint", wrap=True))
                fips = sorted(STATES, key=lambda k: STATES[k])
                state_pick = Gtk.DropDown.new_from_strings([STATES[k] for k in fips])
                county_pick = Gtk.DropDown.new_from_strings(["Loading…"])
                box.append(state_pick)
                box.append(county_pick)
                status = label("", "hint", wrap=True)
                counties = []
                busy = {"on": False}
                go = button("Download", lambda: start_download())
                box.append(go)
                box.append(status)
                box.append(label("DOWNLOADED AREAS", "bold"))
                listing = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                box.append(listing)
                box.append(button("Close", dialog.destroy))

                def say(text):
                    GLib.idle_add(lambda: status.set_label(text) or False)

                def refresh_listing():
                    child = listing.get_first_child()
                    while child is not None:
                        following = child.get_next_sibling()
                        listing.remove(child)
                        child = following
                    found = downloaded_areas()
                    if not found:
                        listing.append(label("None yet.", "hint"))
                    for area in found:
                        row = Gtk.Box(spacing=8)
                        row.append(label(f"{area['name']}, {area['state']}  ({area['downloaded']})",
                                         "mono", xalign=0.0))
                        row.get_first_child().set_hexpand(True)
                        row.append(button("Delete", lambda g=area["geoid"]: delete(g)))
                        listing.append(row)

                def delete(geoid):
                    if busy["on"]:
                        return
                    run_background(lambda: remove_area(geoid, say), "Area removed.")

                def run_background(job, done_text):
                    busy["on"] = True
                    go.set_sensitive(False)

                    def work():
                        try:
                            job()
                            say(done_text if done_text else "Done.")
                        except Exception as error:
                            say(f"Error: {error}")
                        GLib.idle_add(finished)

                    def finished():
                        busy["on"] = False
                        go.set_sensitive(True)
                        refresh_listing()
                        return False
                    threading.Thread(target=work, daemon=True).start()

                def start_download():
                    index = county_pick.get_selected()
                    if busy["on"] or index >= len(counties) or index < 0:
                        return
                    name, geoid = counties[index]
                    state_fips = fips[state_pick.get_selected()]
                    run_background(lambda: download_county(state_fips, geoid, name, say), "")

                def load_counties(*_args):
                    state_fips = fips[state_pick.get_selected()]
                    county_pick.set_model(Gtk.StringList.new(["Loading…"]))
                    counties.clear()

                    def work():
                        try:
                            found = list_counties(state_fips)
                        except Exception as error:
                            say(f"Could not load counties (internet needed): {error}")
                            return

                        def apply():
                            if fips[state_pick.get_selected()] == state_fips:
                                counties[:] = found
                                county_pick.set_model(Gtk.StringList.new([n for n, _g in found]))
                            return False
                        GLib.idle_add(apply)
                    threading.Thread(target=work, daemon=True).start()
                state_pick.connect("notify::selected", load_counties)
                dialog.set_child(box)
                refresh_listing()
                load_counties()
                dialog.present()

            styles = [("street", "Street map")] + [(k, v["name"]) for k, v in IMAGERY_SOURCES.items()]
            sources = {}

            def apply_style(key):
                ui["map_style"] = key
                if key == "street":
                    source = registry.get_by_id(Shumate.MAP_SOURCE_OSM_MAPNIK)
                else:
                    if "port" not in sources:
                        sources["port"] = start_tile_server()
                    if key not in sources:
                        info = IMAGERY_SOURCES[key]
                        sources[key] = Shumate.RasterRenderer.new_full_from_url(
                            f"local-{key}", info["name"], info["license"], info["license_uri"], 0,
                            info["max_zoom"], 256, Shumate.MapProjection.MERCATOR,
                            f"http://127.0.0.1:{sources['port']}/{key}/{{z}}/{{x}}/{{y}}.jpg")
                    source = sources[key]
                simple.set_map_source(source)
                if key == "street" and theme["dark"]:
                    simple.add_css_class("dark-map")
                else:
                    simple.remove_css_class("dark-map")
                ui["style_button"].set_label("Map: " + dict(styles)[key])

            def cycle_style():
                keys = [k for k, _n in styles]
                apply_style(keys[(keys.index(ui.get("map_style", "street")) + 1) % len(keys)])

