[Unit]
Description=Check and recover the eGalax touchscreen classification
After=systemd-udevd.service
ConditionPathExists=/etc/udev/rules.d/99-egalax-touchscreen.rules
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/egalax-touchscreen-check
TimeoutStartSec=45
User=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/sys /run
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
