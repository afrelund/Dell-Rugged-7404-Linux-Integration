# ----- offline county areas and local routing -----
MAPS_DIR = os.path.join(DATA_DIR, "maps")
TIGER_URL = ("https://tigerweb.geo.census.gov/arcgis/rest/services/TIGERweb/State_County/MapServer/1/query?")
GEOFABRIK_URL = "https://download.geofabrik.de/north-america/us/{}-latest.osm.pbf"
ROUTINO_SHARE = "/usr/share/routino"
STATES = {
    "01": "Alabama", "02": "Alaska", "04": "Arizona", "05": "Arkansas", "06": "California",
