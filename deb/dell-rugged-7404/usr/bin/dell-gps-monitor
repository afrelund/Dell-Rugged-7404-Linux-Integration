}


class RouteError(Exception):
    pass


def geofabrik_slug(state_name):
    return state_name.lower().replace(" ", "-")


def http_json(params):
    import urllib.parse
    import urllib.request
    url = TIGER_URL + urllib.parse.urlencode(params)
    with urllib.request.urlopen(url, timeout=60) as response:
        return json.load(response)


def list_counties(state_fips):
    data = http_json({"where": f"STATE='{state_fips}'", "outFields": "NAME,GEOID",
                      "returnGeometry": "false", "f": "json", "orderByFields": "NAME"})
    return [(f["attributes"]["NAME"], f["attributes"]["GEOID"]) for f in data.get("features", [])]


def county_polygon(geoid):
    data = http_json({"where": f"GEOID='{geoid}'", "outFields": "NAME", "returnGeometry": "true",
                      "outSR": "4326", "f": "geojson"})
    if not data.get("features"):
        raise RouteError("County boundary not found.")
    return data


def download_file(url, dest, progress=None):
    import urllib.request
    with urllib.request.urlopen(url, timeout=60) as response, open(dest, "wb") as handle:
        total = int(response.headers.get("Content-Length") or 0)
        done = 0
        while True:
            chunk = response.read(1 << 20)
            if not chunk:
                break
            handle.write(chunk)
            done += len(chunk)
            if progress and total:
                progress(f"Downloading state data… {done // 1048576} of {total // 1048576} MB")


def tools_missing():
    return [name for name in ("osmium", "planetsplitter", "routino-router") if not shutil.which(name)]


def downloaded_areas():
    areas = []
    base = os.path.join(MAPS_DIR, "areas")
    for geoid in sorted(os.listdir(base)) if os.path.isdir(base) else []:
        try:
            with open(os.path.join(base, geoid, "meta.json")) as handle:
                areas.append(dict(json.load(handle), geoid=geoid))
        except (OSError, ValueError):
            continue
    return areas


def run_tool(args, **kwargs):
    result = subprocess.run(args, capture_output=True, text=True, **kwargs)
    if result.returncode != 0:
        lines = (result.stderr or result.stdout).strip().splitlines()
        raise RouteError(f"{os.path.basename(args[0])} failed: {lines[-1] if lines else result.returncode}")
    return result


def build_routing_db(progress=None):
    folder = os.path.join(MAPS_DIR, "routing")
    shutil.rmtree(folder, ignore_errors=True)
    files = [os.path.join(MAPS_DIR, "areas", a["geoid"], "area.osm.pbf") for a in downloaded_areas()]
    if not files:
        return
    os.makedirs(folder)
    if progress:
        progress("Building the routing database (can take several minutes)…")
    run_tool(["planetsplitter", f"--dir={folder}", "--prefix=routing",
              f"--tagging={ROUTINO_SHARE}/tagging.xml"] + files)


def download_county(state_fips, geoid, name, progress=None):
    missing = tools_missing()
    if missing:
        raise RouteError("Missing: " + ", ".join(missing) + ". Install with: sudo apt install routino osmium-tool")
    say = progress or (lambda _text: None)
    area = os.path.join(MAPS_DIR, "areas", geoid)
    cache = os.path.join(MAPS_DIR, "cache")
    os.makedirs(area, exist_ok=True)
    os.makedirs(cache, exist_ok=True)
    state_file = os.path.join(cache, f"state-{state_fips}.osm.pbf")
    try:
        say("Getting the county boundary…")
        polygon = os.path.join(cache, f"{geoid}.geojson")
        with open(polygon, "w") as handle:
            json.dump(county_polygon(geoid), handle)
        download_file(GEOFABRIK_URL.format(geofabrik_slug(STATES[state_fips])), state_file, say)
        say("Cutting out the county…")
        run_tool(["osmium", "extract", "-p", polygon, state_file, "-o",
                  os.path.join(area, "area.osm.pbf"), "--overwrite"])
        with open(os.path.join(area, "meta.json"), "w") as handle:
            json.dump({"name": name, "state": STATES[state_fips],
                       "downloaded": datetime.date.today().isoformat()}, handle)
        build_routing_db(say)
    finally:
        shutil.rmtree(cache, ignore_errors=True)
    say(f"{name}, {STATES[state_fips]} is ready for offline routing.")


def remove_area(geoid, progress=None):
    shutil.rmtree(os.path.join(MAPS_DIR, "areas", geoid), ignore_errors=True)
    build_routing_db(progress)


def parse_route_text(text):
    """Parse routino's --output-text-all table into a list of point dicts."""
    points = []
    for line in text.splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        cols = [c.strip() for c in line.split("\t")]
        try:
            point = {"lat": float(cols[0]), "lon": float(cols[1]), "type": cols[3]}
            point["total_km"] = float(cols[6])
            point["total_min"] = float(cols[7])
            point["segment_km"] = float(cols[4])
        except (IndexError, ValueError):
            continue
        point["road"] = cols[10] if len(cols) > 10 and cols[10] not in ("", "(null)") else "unnamed road"
        points.append(point)
    return points


def route_steps(points):
    """Collapse the route into 'road, distance' legs."""
    steps = []
    for point in points[1:]:
        if steps and steps[-1]["road"] == point["road"]:
            steps[-1]["km"] += point["segment_km"]
        else:
            steps.append({"road": point["road"], "km": point["segment_km"]})
    return steps


def format_duration(minutes):
    minutes = int(round(minutes))
    return f"{minutes // 60} h {minutes % 60} min" if minutes >= 60 else f"{minutes} min"


def compute_route(lat1, lon1, lat2, lon2):
    folder = os.path.join(MAPS_DIR, "routing")
    if not os.path.exists(os.path.join(folder, "routing-nodes.mem")):
        raise RouteError("No offline area downloaded yet. Use Download County Area first.")
    if not shutil.which("routino-router"):
        raise RouteError("routino is not installed (sudo apt install routino).")
    import tempfile
    with tempfile.TemporaryDirectory() as work:
        run_tool(["routino-router", f"--dir={folder}", "--prefix=routing",
                  f"--profiles={ROUTINO_SHARE}/profiles.xml",
                  f"--translations={ROUTINO_SHARE}/translations.xml", "--transport=motorcar",
                  "--quickest", f"--lat1={lat1}", f"--lon1={lon1}", f"--lat2={lat2}", f"--lon2={lon2}",
                  "--output-text-all", "--quiet"], cwd=work)
        with open(os.path.join(work, "quickest-all.txt")) as handle:
            points = parse_route_text(handle.read())
    if len(points) < 2:
        raise RouteError("No route found.")
    return {"points": points, "km": points[-1]["total_km"], "minutes": points[-1]["total_min"],
            "steps": route_steps(points)}


def system_is_dark():
    """True when the Ubuntu/GNOME appearance setting is dark."""
    def get(schema, key):
        try:
            return subprocess.run(["gsettings", "get", schema, key], capture_output=True,
                                  text=True, timeout=3).stdout.strip().strip("'")
        except (OSError, subprocess.SubprocessError):
            return ""
    scheme = get("org.gnome.desktop.interface", "color-scheme")
    if scheme in ("prefer-dark", "prefer-light"):
        return scheme == "prefer-dark"
    return "dark" in get("org.gnome.desktop.interface", "gtk-theme").lower()


DESKTOP_ID = "dell-gps-monitor.desktop"


def pin_to_dock():
    """Add the app to the Ubuntu dock once; a later manual unpin is respected."""
    import ast
    import os
    marker = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
                          "dell-rugged-7404", "dock-pinned")
    if os.path.exists(marker):
        return False
    try:
        out = subprocess.run(["gsettings", "get", "org.gnome.shell", "favorite-apps"],
                             capture_output=True, text=True, timeout=5)
        if out.returncode != 0:
            return False
        favorites = ast.literal_eval(out.stdout.strip().replace("@as ", ""))
        if DESKTOP_ID not in favorites:
            favorites.append(DESKTOP_ID)
            subprocess.run(["gsettings", "set", "org.gnome.shell", "favorite-apps", str(favorites)],
                           check=True, timeout=5)
        os.makedirs(os.path.dirname(marker), exist_ok=True)
        open(marker, "w").close()
        return True
    except (OSError, ValueError, SyntaxError, subprocess.SubprocessError):
        return False


TABS = ("LIVE", "SIGNALS", "NAVIGATE", "MAP", "TRACK", "TOOLS")
AMBER = "#f2b01e"
RECEIVER_RATES = (("1 Hz", 1000), ("2 Hz", 500), ("5 Hz", 200))
RECEIVER_CONSTELLATIONS = ("GALILEO", "GLONASS", "BEIDOU")

def hex_rgb(color):
    return tuple(int(color[i:i + 2], 16) / 255 for i in (1, 3, 5))


CSS = f"""
.tab-button {{ min-height: 56px; font-weight: bold; }}
.tab-button:checked {{ background: {AMBER}; color: #1a1200; }}
.section {{ background: {AMBER}; color: #1a1200; font-weight: bold; padding: 4px 8px; }}
.value-button {{ padding: 4px 8px; min-height: 40px; }}
.value-button label {{ font-family: monospace; }}
.row-title {{ font-weight: bold; font-family: monospace; padding: 6px 8px 0 8px; }}
.action {{ min-height: 48px; }}
.mono {{ font-family: monospace; }}
.hint {{ font-size: 9pt; opacity: 0.8; }}
.status {{ font-size: 14pt; font-weight: bold; }}
.bold {{ font-weight: bold; }}
.wp-row {{ min-height: 44px; font-family: monospace; }}
.dark-map {{ filter: invert(1) hue-rotate(180deg) brightness(0.9); }}
.wp-tag {{ background: {AMBER}; color: #1a1200; font-weight: bold; padding: 1px 6px; border-radius: 4px; }}
.wp-pin {{ color: {AMBER}; font-size: 18pt; }}
.wp-target {{ color: {AMBER}; font-size: 64pt; text-shadow: 0 0 3px #000; }}
.map-marker {{ color: #d32f2f; font-size: 28pt; }}
"""


def run_app():
    import csv
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    from gi.repository import Gdk, GLib, Gtk

    state, stop = GpsState(), threading.Event()
    for target in (gpsd_reader, hw_poller):
        threading.Thread(target=target, args=(state, stop), daemon=True).start()

    GLib.set_prgname("dell-gps-monitor")
    GLib.set_application_name("Dell Rugged GPS Monitor")
    app = Gtk.Application()
    theme = {"dark": system_is_dark()}
    pal = dict(DARK if theme["dark"] else LIGHT)
    waypoints_file = os.path.join(DATA_DIR, "waypoints.json")
    waypoints = load_waypoints(waypoints_file)
    track = []
    log = {"writer": None, "handle": None, "path": None, "last": None, "export": None}
    nav = {"target": None, "tpv": {}, "alert": False, "message": None, "selected": None, "full_map": False}
    shown = {"text": ""}
    ui = {}

    def label(text="", css=None, wrap=False, xalign=0.0):
        widget = Gtk.Label(label=text, xalign=xalign, wrap=wrap, selectable=False)
        if css:
            widget.add_css_class(css)
        return widget

    def button(text, callback, css="action"):
        widget = Gtk.Button(label=text)
        widget.add_css_class(css)
        widget.connect("clicked", lambda _b: callback())
        return widget

    def scrolled(child):
        window = Gtk.ScrolledWindow(hexpand=True, vexpand=True, kinetic_scrolling=True,
                                    hscrollbar_policy=Gtk.PolicyType.NEVER)
        window.set_child(child)
        return window

    def message_dialog(title, text, on_yes=None):
        dialog = Gtk.Window(title=title, modal=True, transient_for=ui["win"], resizable=False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin_top=16,
                      margin_bottom=16, margin_start=16, margin_end=16)
        box.append(label(text, wrap=True))
        row = Gtk.Box(spacing=8, homogeneous=True)

        def finish(yes):
            dialog.destroy()
            if yes and on_yes:
                on_yes()
        if on_yes:
            row.append(button("Cancel", lambda: finish(False)))
            row.append(button("Continue", lambda: finish(True)))
        else:
            row.append(button("OK", lambda: finish(False)))
        box.append(row)
        dialog.set_child(box)
        dialog.present()

    def ask_name(default, on_done):
        dialog = Gtk.Window(title="Waypoint", modal=True, transient_for=ui["win"], resizable=False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=16,
                      margin_bottom=16, margin_start=16, margin_end=16)
        box.append(label("Name:"))
        entry = Gtk.Entry(text=default, width_chars=28)
        box.append(entry)
        row = Gtk.Box(spacing=8, homogeneous=True)

        def finish(ok):
            name = entry.get_text().strip()
            dialog.destroy()
            if ok and name:
                on_done(name)
        row.append(button("Cancel", lambda: finish(False)))
        row.append(button("Add", lambda: finish(True)))
        entry.connect("activate", lambda _e: finish(True))
        box.append(row)
        dialog.set_child(box)
        dialog.present()

    def copy_text(text, note="Copied"):
        ui["win"].get_clipboard().set(text)
        ui["copy_button"].set_label(f"{note}: {text[:34]}")
        GLib.timeout_add(1500, lambda: ui["copy_button"].set_label("Copy coordinates and time") and False)

    # ----- cairo helpers -----
    def text_at(cr, x, y, text, size=11, color=None, bold=False, anchor="c", mono=False):
        cr.select_font_face("monospace" if mono else "DejaVu Sans", 0, 1 if bold else 0)
        cr.set_font_size(size)
        ext = cr.text_extents(text)
        if anchor == "c":
            px, py = x - ext.width / 2 - ext.x_bearing, y + ext.height / 2
        elif anchor == "l":
            px, py = x, y + ext.height / 2
        elif anchor == "nw":
            px, py = x, y + ext.height
        elif anchor == "sw":
            px, py = x, y
        else:  # "se"
            px, py = x - ext.width, y
        cr.set_source_rgb(*hex_rgb(color or pal["fg"]))
        cr.move_to(px, py)
        cr.show_text(text)

    def fill_bg(cr, width, height):
        cr.set_source_rgb(*hex_rgb(pal["sky"]))
        cr.paint()

    def line(cr, x0, y0, x1, y1, color, width=1, dash=None):
        cr.set_source_rgb(*hex_rgb(color))
        cr.set_line_width(width)
        cr.set_dash(dash or [])
        cr.move_to(x0, y0)
        cr.line_to(x1, y1)
        cr.stroke()
        cr.set_dash([])

    def circle(cr, x, y, r, outline=None, fill=None, width=1):
        cr.new_path()
        cr.arc(x, y, r, 0, 2 * math.pi)
        if fill:
            cr.set_source_rgb(*hex_rgb(fill))
            cr.fill_preserve()
        if outline:
            cr.set_source_rgb(*hex_rgb(outline))
            cr.set_line_width(width)
            cr.stroke()
        cr.new_path()

    def arrow(cr, cx, cy, x, y, color, width, head):
        line(cr, cx, cy, cx + x, cy + y, color, width)
        angle = math.atan2(y, x)
        tip = (cx + x, cy + y)
        cr.set_source_rgb(*hex_rgb(color))
        cr.move_to(*tip)
        for side in (0.4, -0.4):
            cr.line_to(tip[0] - head * math.cos(angle + side), tip[1] - head * math.sin(angle + side))
        cr.close_path()
        cr.fill()

    # ----- drawing -----
    def draw_sky(_area, cr, width, height):
        fill_bg(cr, width, height)
        cx, cy, radius = width / 2, height / 2, max(min(width, height) / 2 - 26, 20)
        for elevation in (0, 30, 60):
            r = (90 - elevation) / 90 * radius
            circle(cr, cx, cy, r, outline=pal["ring"])
            if elevation:
                text_at(cr, cx + 4, cy - r + 2, f"{elevation}°", 10, pal["ringtext"], anchor="nw")
        line(cr, cx - radius, cy, cx + radius, cy, pal["cross"])
        line(cr, cx, cy - radius, cx, cy + radius, pal["cross"])
        for text, azimuth in (("N", 0), ("E", 90), ("S", 180), ("W", 270)):
            x, y = sky_xy(azimuth, -4, radius)
            text_at(cr, cx + x, cy + y, text, 13, bold=True)
        for sat in ui["sky"]:
            if "az" not in sat or "el" not in sat:
                continue
            _name, color = CONSTELLATIONS.get(sat.get("gnssid"), ("?", "#616161"))
            x, y = sky_xy(sat["az"], sat["el"], radius)
            r, used = 12, sat.get("used")
            circle(cr, cx + x, cy + y, r, outline=color, fill=color if used else pal["hollow"], width=2)
            text_at(cr, cx + x, cy + y, str(sat.get("svid", sat.get("PRN", ""))), 9,
                    "#ffffff" if used else color, bold=True)
            text_at(cr, cx + x, cy + y + r + 8, f"{sat.get('ss', 0):.0f}", 8, pal["ss"])

    def draw_bars(_area, cr, width, height):
        fill_bg(cr, width, height)
        top, foot, left_pad = 8, 24, 26
        plot = height - top - foot
        for level in (20, 40):
            y = top + plot * (1 - level / 55)
            line(cr, left_pad, y, width, y, pal["cross"])
            text_at(cr, 2, y, str(level), 9, pal["ringtext"], anchor="l")
        sats = sorted((s for s in ui["sky"] if s.get("ss") is not None),
                      key=lambda s: (s.get("gnssid", 9), s.get("svid", 0)))
        if not sats:
            text_at(cr, width / 2, height / 2, "no satellites", 11)
            return
        slot = (width - left_pad - 4) / len(sats)
        for index, sat in enumerate(sats):
            color = CONSTELLATIONS.get(sat.get("gnssid"), ("?", "#616161"))[1]
            x0 = left_pad + index * slot + slot * 0.12
            x1 = left_pad + (index + 1) * slot - slot * 0.12
            y0 = top + plot * (1 - min(sat["ss"], 55) / 55)
            cr.rectangle(x0, y0, x1 - x0, top + plot - y0)
            cr.set_source_rgb(*hex_rgb(color))
            if sat.get("used"):
                cr.fill_preserve()
            cr.set_line_width(2)
            cr.stroke()
            if slot >= 14:
                text_at(cr, (x0 + x1) / 2, top + plot + 11, str(sat.get("svid", "")), 9)

    def draw_jam_history(_area, cr, width, height):
        fill_bg(cr, width, height)
        history = ui["history"]
        left_pad, top, foot = 30, 6, 16
        plot = height - top - foot

        def y_of(value):
            return top + plot * (1 - value / 255)
        for level, color in ((40, AMBER), (100, "#c62828")):
            line(cr, left_pad, y_of(level), width, y_of(level), color, 1, [4, 3])
            text_at(cr, 2, y_of(level), str(level), 9, pal["ringtext"], anchor="l")
        if len(history) < 2:
            text_at(cr, width / 2, height / 2, "collecting data...", 11)
            return
        start, end = history[0][0], history[-1][0]
        span = max(end - start, 1)
        points = [(left_pad + (t - start) / span * (width - left_pad - 4), y_of(v), v) for t, v in history]
        for (x0, y0, _), (x1, y1, v1) in zip(points, points[1:]):
            line(cr, x0, y0, x1, y1, jam_level(v1)[1], 2)
        text_at(cr, left_pad, height - 2, f"-{span / 60:.0f} min", 9, pal["ringtext"], anchor="sw")
        text_at(cr, width - 4, height - 2, "now", 9, pal["ringtext"], anchor="se")

    def draw_jam_bar(_area, cr, width, height):
        cr.set_source_rgb(*hex_rgb(pal["bar"]))
        cr.paint()
        value = ui["jam_value"]
        if value is not None:
            cr.set_source_rgb(*hex_rgb(jam_level(value)[1]))
            cr.rectangle(0, 0, width * value / 255, height)
            cr.fill()

    def draw_compass(_area, cr, width, height):
        fill_bg(cr, width, height)
        cx, cy = width / 2, height / 2
        radius = max(min(width, height) / 2 - 20, 20)
        circle(cr, cx, cy, radius, outline=pal["ring"], width=2)
        for text, angle in (("N", 0), ("E", 90), ("S", 180), ("W", 270)):
            x, y = sky_xy(angle, -6, radius + 1)
            text_at(cr, cx + x, cy + y, text, 13, bold=True)
        for angle in range(0, 360, 30):
            x0, y0 = sky_xy(angle, 0, radius)
            x1, y1 = sky_xy(angle, 6, radius)
            line(cr, cx + x0, cy + y0, cx + x1, cy + y1, pal["ring"])
        if ui["bearing"] is not None:
            x, y = sky_xy(ui["bearing"], 8, radius)
            arrow(cr, cx, cy, x, y, "#1565c0", 5, 16)
        if ui["heading"] is not None:
            x, y = sky_xy(ui["heading"], 12, radius)
            arrow(cr, cx, cy, x, y, AMBER, 3, 13)
        circle(cr, cx, cy, 4, fill=pal["fg"])

    def drawing(func, height=-1, width=-1, expand=False):
        area = Gtk.DrawingArea(content_height=max(height, 0), content_width=max(width, 0), hexpand=True,
                           vexpand=expand)
        area.set_draw_func(func)
        return area

    ui.update(sky=[], history=[], jam_value=None, heading=None, bearing=None)

    # ----- window -----
    def activate(application):
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = Gtk.ApplicationWindow(application=application, title="Dell Rugged GPS Monitor",
                                    default_width=1180, default_height=720, icon_name="dell-gps-monitor")
        ui["win"] = win
        root = Gtk.Box(spacing=8, margin_top=8, margin_bottom=8, margin_start=8, margin_end=8)
        win.set_child(root)

        # left: sky view
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, hexpand=True)
        ui["sky_area"] = drawing(draw_sky, 400, 400, expand=True)
        left.append(ui["sky_area"])
        legend = Gtk.Box(spacing=8)
        for name, color in CONSTELLATIONS.values():
            tag = Gtk.Label(use_markup=True)
            tag.set_markup(f'<span foreground="{color}" weight="bold">● {GLib.markup_escape_text(name)}</span>')
            legend.append(tag)
        left.append(legend)
        left.append(label("Filled = used in fix, hollow = tracked only; number below satellite = dB-Hz",
                          "hint", wrap=True))
        root.append(left)
        ui["left"] = left

        # right: status + tabs
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, width_request=500)
        ui["status"] = label("", "status")
        right.append(ui["status"])
        tabbar = Gtk.Box(spacing=4, homogeneous=True, margin_top=4, margin_bottom=6)
        stack = Gtk.Stack(vexpand=True, hexpand=True)
        ui["stack"] = stack
        group, tab_buttons = None, {}
        for name in TABS:
            toggle = Gtk.ToggleButton(label=name, hexpand=True)
            toggle.add_css_class("tab-button")
            if group is None:
                group = toggle
            else:
                toggle.set_group(group)
            toggle.connect("toggled", lambda b, n=name: b.get_active() and show(n))
            tab_buttons[name] = toggle
            tabbar.append(toggle)
        right.append(tabbar)
        ui["tabbar"], ui["right"] = tabbar, right
        right.append(stack)
        root.append(right)

        def show(name):
            stack.set_visible_child_name(name)
            refresh()

        # LIVE
        live = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        ui["live_box"] = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        ui["live_scroll"] = scrolled(ui["live_box"])
        live.append(ui["live_scroll"])
        live.append(label("JAMMING INDICATOR", "bold"))
        ui["jam_bar"] = drawing(draw_jam_bar, 26)
        live.append(ui["jam_bar"])
        ui["jam_text"] = label("", "mono")
        live.append(ui["jam_text"])
        live.append(label("Tap any value above to copy it", "hint"))
        ui["copy_button"] = button("Copy coordinates and time",
                                   lambda: copy_text(shown["text"], "Copied all"))
        live.append(ui["copy_button"])
        stack.add_named(live, "LIVE")

        # SIGNALS
        sig = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        dash = Gtk.Box(homogeneous=True, spacing=6)
        ui["dash"] = {}
        for key in ("FIX", "HDOP", "VDOP", "PDOP", "ACCURACY"):
            cell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            cell.append(label(key, "hint", xalign=0.5))
            ui["dash"][key] = Gtk.Label(use_markup=True)
            cell.append(ui["dash"][key])
            dash.append(cell)
        sig.append(dash)
        sig.append(label("SIGNAL STRENGTH (dB-Hz)", "bold"))
        sig.append(drawing(draw_bars, 200, expand=True))
        sig.append(label("JAMMING HISTORY", "bold"))
        sig.append(drawing(draw_jam_history, 170, expand=True))
        sig.append(label("Amber line = possible interference, red line = strong interference", "hint"))
        stack.add_named(sig, "SIGNALS")

        # NAVIGATE
        navp = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        ui["compass"] = drawing(draw_compass, 240)
        navp.append(ui["compass"])
        ui["nav_text"] = label("", "mono")
        navp.append(ui["nav_text"])
        ui["wp_list"] = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        ui["wp_list"].connect("row-selected", lambda _l, row: nav.update(
            selected=waypoints[row.get_index()] if row is not None else None))
        navp.append(scrolled(ui["wp_list"]))
        wp_buttons = Gtk.Box(spacing=4, homogeneous=True)
        for text, command in (("Add waypoint here", add_waypoint), ("Go to selected", set_target),
                              ("Clear target", clear_target), ("Delete", delete_waypoint)):
            btn = button(text, command)
            wp_buttons.append(btn)
        navp.append(wp_buttons)
        stack.add_named(navp, "NAVIGATE")

        # MAP
        mapp = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        try:
            gi.require_version("Shumate", "1.0")
            from gi.repository import Shumate
            simple = Shumate.SimpleMap(vexpand=True, hexpand=True)
            registry = Shumate.MapSourceRegistry.new_with_defaults()
            simple.set_map_source(registry.get_by_id(Shumate.MAP_SOURCE_OSM_MAPNIK))
            if theme["dark"]:
                simple.add_css_class("dark-map")
            ui["map_widget"] = simple
            viewport = simple.get_viewport()
            # Touch only pans; zoom comes from the +/- buttons or keys.
            for gesture in list(simple.get_map().observe_controllers()):
                if isinstance(gesture, (Gtk.GestureZoom, Gtk.GestureRotate, Gtk.GestureClick)):
                    simple.get_map().remove_controller(gesture)
            viewport.set_zoom_level(3)
            layer = Shumate.MarkerLayer.new(viewport)
            marker = Shumate.Marker()
            marker_label = Gtk.Label(label="\u25cf")
            marker_label.add_css_class("map-marker")
            marker.set_child(marker_label)
            layer.add_marker(marker)
            simple.add_overlay_layer(layer)
            wp_layer = Shumate.MarkerLayer.new(viewport)
            simple.add_overlay_layer(wp_layer)
            ui["map"] = {"simple": simple, "viewport": viewport, "marker": marker, "follow": True, "placed": False}

            def draw_map_waypoints():
                wp_layer.remove_all()
                for wp in waypoints:
                    pin = Shumate.Marker()
                    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                    box.append(Gtk.Label(label=wp["name"], css_classes=["wp-tag"]))
                    box.append(Gtk.Label(label="\u25b2", css_classes=["wp-pin"]))
                    pin.set_child(box)
                    pin.set_location(wp["lat"], wp["lon"])
                    wp_layer.add_marker(pin)
            ui["draw_map_waypoints"] = draw_map_waypoints

            route_layer = Shumate.PathLayer.new(viewport)
            route_layer.set_stroke_width(6)
            route_layer.set_stroke_color(Gdk.RGBA(red=0.1, green=0.5, blue=1.0, alpha=0.9))
            simple.add_overlay_layer(route_layer)
            nav["route"] = None

            def clear_route():
                for node in list(route_layer.get_nodes()):
                    route_layer.remove_node(node)
                nav["route"] = None
                ui["route_button"].set_label("Route to target")

            def show_directions(route):
                dialog = Gtk.Window(title="Directions", modal=True, transient_for=ui["win"],
                                    default_width=520, default_height=480)
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=12,
                              margin_bottom=12, margin_start=12, margin_end=12)
                box.append(label(f"{route['km']:.1f} km · {format_duration(route['minutes'])} by car",
                                 "status"))
                steps = "\n".join(f"{n}. {step['road']} – {step['km']:.1f} km"
                                   for n, step in enumerate(route["steps"], 1))
                box.append(scrolled(label(steps, "mono", wrap=True)))
                box.append(button("Close", dialog.destroy))
                dialog.set_child(box)
                dialog.present()

            def route_to_target():
                if nav["route"] is not None:
                    clear_route()
                    return
                tpv, wp = nav["tpv"], nav["target"]
                if wp is None:
                    message_dialog("Route", "Pick a target waypoint on the NAVIGATE tab first "
                                            "(select it and tap Set target).")
                    return
                if tpv.get("mode", 0) < 2 or "lat" not in tpv:
                    message_dialog("Route", "No GPS fix yet.")
                    return
                ui["route_note"].set_label("Routing…")

                def work():
                    try:
                        result = compute_route(tpv["lat"], tpv["lon"], wp["lat"], wp["lon"])
                    except Exception as error:
                        GLib.idle_add(finish, None, str(error))
                        return
                    GLib.idle_add(finish, result, "")

                def finish(result, error):
                    ui["route_note"].set_label("")
                    if result is None:
                        message_dialog("Route", error)
                        return False
                    nav["route"] = result
                    for point in result["points"]:
                        route_layer.add_node(Shumate.Coordinate.new_full(point["lat"], point["lon"]))
                    ui["route_button"].set_label("Clear route")
                    ui["route_note"].set_label(f"{result['km']:.1f} km · {format_duration(result['minutes'])}")
                    show_directions(result)
                    return False
                threading.Thread(target=work, daemon=True).start()

            def area_dialog():
                dialog = Gtk.Window(title="Download County Area", modal=True, transient_for=ui["win"],
                                    default_width=520)
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=12,
                              margin_bottom=12, margin_start=12, margin_end=12)
                box.append(label("Download a county's roads for offline routing.", "bold"))
                box.append(label("Gets the state's OpenStreetMap data (from tens to a few hundred MB), "
                                 "cuts out the county and builds a local routing database. "
                                 "Needs internet only for this step.", "hint", wrap=True))
                fips = sorted(STATES, key=lambda k: STATES[k])
                state_pick = Gtk.DropDown.new_from_strings([STATES[k] for k in fips])
                county_pick = Gtk.DropDown.new_from_strings(["Loading…"])
                box.append(state_pick)
                box.append(county_pick)
                status = label("", "hint", wrap=True)
                counties = []
                busy = {"on": False}
                go = button("Download", lambda: start_download())
                box.append(go)
                box.append(status)
                box.append(label("DOWNLOADED AREAS", "bold"))
                listing = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                box.append(listing)
                box.append(button("Close", dialog.destroy))

                def say(text):
                    GLib.idle_add(lambda: status.set_label(text) or False)

                def refresh_listing():
                    child = listing.get_first_child()
                    while child is not None:
                        following = child.get_next_sibling()
                        listing.remove(child)
                        child = following
                    found = downloaded_areas()
                    if not found:
                        listing.append(label("None yet.", "hint"))
                    for area in found:
                        row = Gtk.Box(spacing=8)
                        row.append(label(f"{area['name']}, {area['state']}  ({area['downloaded']})",
                                         "mono", xalign=0.0))
                        row.get_first_child().set_hexpand(True)
                        row.append(button("Delete", lambda g=area["geoid"]: delete(g)))
                        listing.append(row)

                def delete(geoid):
                    if busy["on"]:
                        return
                    run_background(lambda: remove_area(geoid, say), "Area removed.")

                def run_background(job, done_text):
                    busy["on"] = True
                    go.set_sensitive(False)

                    def work():
                        try:
                            job()
                            say(done_text if done_text else "Done.")
                        except Exception as error:
                            say(f"Error: {error}")
                        GLib.idle_add(finished)

                    def finished():
                        busy["on"] = False
                        go.set_sensitive(True)
                        refresh_listing()
                        return False
                    threading.Thread(target=work, daemon=True).start()

                def start_download():
                    index = county_pick.get_selected()
                    if busy["on"] or index >= len(counties) or index < 0:
                        return
                    name, geoid = counties[index]
                    state_fips = fips[state_pick.get_selected()]
                    run_background(lambda: download_county(state_fips, geoid, name, say), "")

                def load_counties(*_args):
                    state_fips = fips[state_pick.get_selected()]
                    county_pick.set_model(Gtk.StringList.new(["Loading…"]))
                    counties.clear()

                    def work():
                        try:
                            found = list_counties(state_fips)
                        except Exception as error:
                            say(f"Could not load counties (internet needed): {error}")
                            return

                        def apply():
                            if fips[state_pick.get_selected()] == state_fips:
                                counties[:] = found
                                county_pick.set_model(Gtk.StringList.new([n for n, _g in found]))
                            return False
                        GLib.idle_add(apply)
                    threading.Thread(target=work, daemon=True).start()
                state_pick.connect("notify::selected", load_counties)
                dialog.set_child(box)
                refresh_listing()
                load_counties()
                dialog.present()

            def waypoint_at(x, y):
                lat, lon = viewport.widget_coords_to_location(simple, x, y)
                add_waypoint(lat, lon)

            def placing(on):
                ui["target"].set_visible(on)
                ui["place_row"].set_visible(on)
                ui["buttons_row"].set_visible(not on)
                ui["tools_row"].set_visible(not on)

            def confirm_waypoint():
                placing(False)
                add_waypoint(viewport.get_latitude(), viewport.get_longitude())

            press = Gtk.GestureLongPress()
            press.connect("pressed", lambda _g, x, y: waypoint_at(x, y))
            simple.add_controller(press)

            def toggle_full():
                full = not nav["full_map"]
                nav["full_map"] = full
                ui["left"].set_visible(not full)
                ui["tabbar"].set_visible(not full)
                ui["status"].set_visible(not full)
                ui["right"].set_size_request(-1 if full else 500, -1)
                ui["full_button"].set_label("Exit full map" if full else "Full map")

            def center_on_me():
                ui["map"]["follow"] = True
                tpv = nav["tpv"]
                if "lat" in tpv and "lon" in tpv:
                    simple.get_map().go_to_full(tpv["lat"], tpv["lon"], max(viewport.get_zoom_level(), 14))
            drag = Gtk.GestureDrag()
            drag.connect("drag-begin", lambda *_a: (ui["map"].update(follow=False),
                                                    simple.get_map().grab_focus()))
            simple.add_controller(drag)
            overlay = Gtk.Overlay(vexpand=True, hexpand=True)
            overlay.set_child(simple)
            target = Gtk.Label(label="\u2316", halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER,
                               can_target=False, visible=False)
            target.add_css_class("wp-target")
            overlay.add_overlay(target)
            ui["target"] = target
            mapp.append(overlay)
            buttons = Gtk.Box(spacing=4, homogeneous=True)
            buttons.append(button("Center on me", center_on_me))
            buttons.append(button("Add waypoint", lambda: placing(True)))
            ui["full_button"] = button("Full map", toggle_full)
            buttons.append(ui["full_button"])
            ui["buttons_row"] = buttons
            mapp.append(buttons)
            tools_row = Gtk.Box(spacing=4, homogeneous=True)
            tools_row.append(button("Download County Area", area_dialog))
            ui["route_button"] = button("Route to target", route_to_target)
            tools_row.append(ui["route_button"])
            ui["route_note"] = label("", "bold", xalign=0.5)
            tools_row.append(ui["route_note"])
            ui["tools_row"] = tools_row
            mapp.append(tools_row)
            place_row = Gtk.Box(spacing=4, homogeneous=True, visible=False)
            place_row.append(button("Confirm waypoint", confirm_waypoint))
            place_row.append(button("Cancel", lambda: placing(False)))
            ui["place_row"] = place_row
            mapp.append(place_row)
            mapp.append(label("OpenStreetMap, darkened in dark mode (needs internet; viewed tiles are cached). "
                              "Drag to pan; zoom with the +/- buttons or the + and - keys. Tap Add waypoint, drag the map so the amber target is where you want it, then Confirm. Press and hold also adds one.",
                              "hint", wrap=True))
        except (ImportError, ValueError):
            mapp.append(label("The map needs the package gir1.2-shumate-1.0:\n"
                              "sudo apt install gir1.2-shumate-1.0", "hint", wrap=True))
        stack.add_named(mapp, "MAP")

        # TRACK
        trackp = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        trackp.append(label("TRACK LOG", "bold"))
        ui["log_text"] = label("", "mono", wrap=True)
        trackp.append(ui["log_text"])
        row = Gtk.Box(spacing=4, homogeneous=True)
        ui["log_button"] = button("Start track log", toggle_log)
        row.append(ui["log_button"])
        row.append(button("Export GPX", export_gpx))
        row.append(button("Open folder", open_folder))
        trackp.append(row)
        trackp.append(label(f"Logs are saved as CSV (one point per second while there is a fix) in "
                            f"{DATA_DIR}. Export GPX writes this session's track plus your waypoints "
                            "for use in mapping apps.", "hint", wrap=True))
        stack.add_named(scrolled(trackp), "TRACK")

        # TOOLS
        tools = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        tools.append(label("SUN (at your position)", "bold"))
        ui["sun_text"] = label("", "mono")
        tools.append(ui["sun_text"])
        tools.append(label("RECEIVER SETUP", "bold"))
        tools.append(label("These write to the GPS receiver (asks first). Changes are not saved to its "
                           "flash; a receiver reset restores the defaults.", "hint", wrap=True))
        for name in RECEIVER_CONSTELLATIONS:
            row = Gtk.Box(spacing=4, homogeneous=True)
            row.append(label(name.title(), "mono"))
            row.append(button("Enable", lambda n=name: receiver(["-e", n], f"Enable {n.title()} tracking.")))
            row.append(button("Disable", lambda n=name: receiver(["-d", n], f"Disable {n.title()} tracking.")))
            tools.append(row)
        row = Gtk.Box(spacing=4, homogeneous=True)
        row.append(label("Update rate", "mono"))
        for text, milliseconds in RECEIVER_RATES:
            row.append(button(text, lambda t=text, ms=milliseconds: receiver(
                ["-p", f"RATE,{ms}"], f"Set the position update rate to {t}.")))
        tools.append(row)
        ui["tool_out"] = label("", "hint", wrap=True)
        tools.append(ui["tool_out"])
        stack.add_named(scrolled(tools), "TOOLS")

        win.connect("close-request", lambda _w: close() or False)
        refresh_waypoints()
        tab_buttons["LIVE"].set_active(True)
        win.present()
        GLib.timeout_add(1000, lambda: refresh() or True)
        GLib.timeout_add(3000, watch_theme)

    # ----- waypoints -----
    def refresh_waypoints():
        lst = ui["wp_list"]
        child = lst.get_first_child()
        while child is not None:
            following = child.get_next_sibling()
            lst.remove(child)
            child = following
        for wp in waypoints:
            mark = "► " if nav["target"] is wp else "  "
            row_label = label(f"{mark}{wp['name']}  {wp['lat']:.5f}, {wp['lon']:.5f}", "wp-row")
            lst.append(row_label)
        if nav["selected"] in waypoints:
            lst.select_row(lst.get_row_at_index(waypoints.index(nav["selected"])))
        ui.get("draw_map_waypoints", lambda: None)()

    def add_waypoint(lat=None, lon=None):
        tpv = nav["tpv"]
        here = lat is None
        if here and (tpv.get("mode", 0) < 2 or "lat" not in tpv):
            message_dialog("Waypoint", "No GPS fix yet.")
            return

        def done(name):
            waypoints.append({"name": name, "lat": tpv["lat"] if here else lat,
                              "lon": tpv["lon"] if here else lon,
                              "alt": tpv.get("altHAE", tpv.get("alt")) if here else None})
            save_waypoints(waypoints_file, waypoints)
            refresh_waypoints()
        ask_name(f"WP{len(waypoints) + 1}", done)

    def set_target():
        nav["target"] = nav["selected"]
        refresh_waypoints()

    def delete_waypoint():
        wp = nav["selected"]
        if wp is not None and wp in waypoints:
            if nav["target"] is wp:
                nav["target"] = None
            waypoints.remove(wp)
            nav["selected"] = None
            save_waypoints(waypoints_file, waypoints)
            refresh_waypoints()

    def clear_target():
        nav["target"] = None
        refresh_waypoints()

    # ----- track -----
    def toggle_log():
        if log["handle"] is not None:
            log["handle"].close()
            log["handle"] = log["writer"] = None
            ui["log_button"].set_label("Start track log")
            return
        os.makedirs(DATA_DIR, exist_ok=True)
        log["path"] = os.path.join(DATA_DIR, time.strftime("track-%Y%m%d-%H%M%S.csv"))
        log["handle"] = open(log["path"], "w", newline="")
        log["writer"] = csv.writer(log["handle"])
        log["writer"].writerow(["time_utc", "lat", "lon", "alt_m", "speed_mps", "track_deg"])
        log["last"] = None
        track.clear()
        ui["log_button"].set_label("Stop track log")

    def export_gpx():
        if not track and not waypoints:
            message_dialog("Export GPX", "Nothing to export yet. Start the track log first.")
            return
        os.makedirs(DATA_DIR, exist_ok=True)
        path = os.path.join(DATA_DIR, time.strftime("export-%Y%m%d-%H%M%S.gpx"))
        with open(path, "w") as handle:
            handle.write(gpx_text(track, waypoints))
        log["export"] = path

    def open_folder():
        os.makedirs(DATA_DIR, exist_ok=True)
        if shutil.which("xdg-open"):
            subprocess.Popen(["xdg-open", DATA_DIR])

    # ----- receiver setup -----
    def receiver(args, description):
        if not shutil.which("ubxtool"):
            message_dialog("Receiver setup", "ubxtool is not installed (package gpsd-clients).")
            return

        def go():
            ui["tool_out"].set_label("Working...")

            def work():
                try:
                    out = subprocess.run(["ubxtool", "-P", "15", *args], capture_output=True,
                                         text=True, timeout=30).stdout
                    if "ACK-NAK" in out:
                        message = "Receiver rejected the change."
                    elif "ACK-ACK" in out:
                        message = "Receiver accepted the change."
                    else:
                        message = "\n".join(out.strip().splitlines()[-4:]) or "No reply from receiver."
                except (OSError, subprocess.SubprocessError) as error:
                    message = f"Failed: {error}"
                nav["message"] = message

            threading.Thread(target=work, daemon=True).start()
        message_dialog("Change receiver settings", f"{description}\n\nContinue?", go)

    # ----- theme -----
    def watch_theme():
        dark = system_is_dark()
        if dark != theme["dark"]:
            theme["dark"] = dark
            pal.update(DARK if dark else LIGHT)
            if "map_widget" in ui:
                if dark:
                    ui["map_widget"].add_css_class("dark-map")
                else:
                    ui["map_widget"].remove_css_class("dark-map")
            redraw_all()
        return True

    def redraw_all():
        for widget in (ui["sky_area"], ui["jam_bar"], ui["compass"]):
            widget.queue_draw()
        queue_signal_areas()

    def queue_signal_areas():
        page = ui["stack"].get_child_by_name("SIGNALS")
        child = page.get_first_child()
        while child is not None:
            if isinstance(child, Gtk.DrawingArea):
                child.queue_draw()
            child = child.get_next_sibling()

    def fix_label(mode):
        return {0: "none", 1: "none", 2: "2D", 3: "3D"}.get(mode, "?")

    def colored(text, color):
        return f'<span foreground="{color}" weight="bold" size="large">{GLib.markup_escape_text(text)}</span>'

    def rebuild_live(lines):
        box = ui["live_box"]
        child = box.get_first_child()
        while child is not None:
            following = child.get_next_sibling()
            box.remove(child)
            child = following
        for name, value in lines:
            if value is None:
                heading = label(name, "section")
                heading.set_margin_top(8)
                box.append(heading)
                continue
            box.append(label(f"{name}:", "row-title"))
            value_button = Gtk.Button(has_frame=False)
            value_button.add_css_class("value-button")
            value_button.add_css_class("flat")
            value_label = label(f"  {value}", "mono")
            value_button.set_child(value_label)
            value_button.connect("clicked", lambda _b, v=value: copy_text(v))
            box.append(value_button)

    # ----- refresh loop -----
    def refresh():
        with state.lock:
            tpv, sky, dops, hw = dict(state.tpv), list(state.sky), dict(state.dops), dict(state.hw)
            connected, device = state.connected, state.device
            history = list(state.jam_history)
        nav["tpv"] = tpv
        mode = tpv.get("mode", 0)
        ui["sky"], ui["history"] = sky, history
        if nav["message"]:
            ui["tool_out"].set_label(nav["message"])
            nav["message"] = None
        jam_value = hw.get("jam")
        ui["jam_value"] = jam_value
        alert = (jam_value is not None and jam_value >= 100) or hw.get("jam_state") == "critical"
        if alert and not nav["alert"]:
            ui["win"].get_display().beep()
        nav["alert"] = alert
        if not connected:
            ui["status"].set_markup(colored("gpsd not running", "#c62828"))
        elif device is None:
            ui["status"].set_markup(colored("No GPS attached to gpsd", "#c62828"))
        else:
            fix = {0: "No data", 1: "No fix", 2: "2D fix", 3: "3D fix"}.get(mode, "?")
            ui["status"].set_markup(colored(("⚠ JAMMING ALERT  " if alert else "") + fix,
                                            "#c62828" if alert else "#2e7d32" if mode >= 2 else "#ef6c00"))

        if "map" in ui and mode >= 2 and "lat" in tpv and "lon" in tpv:
            m = ui["map"]
            m["marker"].set_location(tpv["lat"], tpv["lon"])
            if m["follow"]:
                if not m["placed"]:
                    m["simple"].get_map().go_to_full(tpv["lat"], tpv["lon"], 15)
                    m["placed"] = True
                else:
                    m["simple"].get_map().center_on(tpv["lat"], tpv["lon"])

        lines = []
        header = lambda name: lines.append((name, None))
        if mode >= 2 and "lat" in tpv and "lon" in tpv:
            header("COORDINATES")
            for item in coordinate_lines(tpv["lat"], tpv["lon"], tpv.get("altHAE", tpv.get("alt"))):
                lines.append(item)
            if "eph" in tpv or "speed" in tpv:
                header("MOTION / ACCURACY")
            if "eph" in tpv:
                lines.append(("Accuracy (est.)", f"±{tpv['eph']:.1f} m horiz"
                              + (f", ±{tpv['epv']:.1f} m vert" if "epv" in tpv else "")))
            if "speed" in tpv:
                lines.append(("Speed / track", f"{tpv['speed'] * 3.6:.1f} km/h"
                              + (f", {tpv['track']:.0f}°" if "track" in tpv else "")))
        if "time" in tpv:
            header("TIME")
            lines.extend(time_lines(parse_gps_utc(tpv["time"])))
        used = sum(1 for s in sky if s.get("used"))
        header("SATELLITES")
        lines.append(("Satellites", f"{used} used / {len(sky)} seen"
                      + (f"   HDOP {dops['hdop']}" if "hdop" in dops else "")))
        text = "\n".join(f"\n== {name} ==" if value is None else f"{name}:\n  {value}"
                         for name, value in lines).strip()
        if text != shown["text"]:
            shown["text"] = text
            adjustment = ui["live_scroll"].get_vadjustment()
            position = adjustment.get_value()
            rebuild_live(lines)
            GLib.idle_add(lambda: adjustment.set_value(position) and False)

        level, color = jam_level(jam_value)
        extra = [f"{jam_value}/255 - {level}" if jam_value is not None
                 else "waiting for receiver (needs ubxtool)"]
        if "jam_state" in hw:
            extra.append(f"Receiver jamming state: {hw['jam_state']}")
        if "antenna" in hw:
            extra.append(f"Antenna: {hw['antenna']}")
        ui["jam_text"].set_markup(
            f'<span foreground="{color}">{GLib.markup_escape_text(chr(10).join(extra))}</span>'
            if jam_value is not None else GLib.markup_escape_text("\n".join(extra)))
        ui["jam_bar"].queue_draw()
        ui["sky_area"].queue_draw()

        has_fix = mode >= 2 and "lat" in tpv and "lon" in tpv
        page = ui["stack"].get_visible_child_name()
        if page == "SIGNALS":
            for key, value in (("HDOP", dops.get("hdop")), ("VDOP", dops.get("vdop")),
                               ("PDOP", dops.get("pdop"))):
                ui["dash"][key].set_markup(colored("-" if value is None else f"{value}",
                                                   dop_quality(value)[1]))
            ui["dash"]["FIX"].set_markup(colored(fix_label(mode), "#2e7d32" if mode >= 2 else "#c62828"))
            accuracy = tpv.get("eph")
            ui["dash"]["ACCURACY"].set_markup(colored(
                "-" if accuracy is None else f"±{accuracy:.1f}m",
                dop_quality(None if accuracy is None else accuracy / 2.5)[1]))
            queue_signal_areas()

        heading = tpv.get("track") if tpv.get("speed", 0) >= 0.5 else None
        bearing, lines_nav = None, []
        speed_text = f"{tpv['speed'] * 3.6:.1f} km/h" if "speed" in tpv else "-"
        lines_nav.append(f"Speed:   {speed_text}")
        lines_nav.append("Heading: " + (f"{heading:.0f}° {compass_point(heading)}" if heading is not None
                                       else "- (move to get a heading)"))
        target = nav["target"]
        if target is not None and has_fix:
            metres, bearing = bearing_distance(tpv["lat"], tpv["lon"], target["lat"], target["lon"])
            lines_nav.append(f"Target:  {target['name']}")
            lines_nav.append(f"Dist:    {format_distance(metres)}")
            lines_nav.append(f"Bearing: {bearing:.0f}° {compass_point(bearing)}"
                             + (f"  turn {turn_hint(heading, bearing)}" if heading is not None else ""))
        elif target is not None:
            lines_nav.append(f"Target:  {target['name']} (waiting for fix)")
        ui["heading"], ui["bearing"] = heading, bearing
        if page == "NAVIGATE":
            ui["nav_text"].set_label("\n".join(lines_nav))
            ui["compass"].queue_draw()

        if log["handle"] is not None and has_fix and tpv.get("time") and tpv["time"] != log["last"]:
            log["last"] = tpv["time"]
            point = {"time": tpv["time"], "lat": tpv["lat"], "lon": tpv["lon"],
                     "alt": tpv.get("altHAE", tpv.get("alt")), "speed": tpv.get("speed"),
                     "track": tpv.get("track")}
            if len(track) < 200000:
                track.append(point)
            log["writer"].writerow([point["time"], point["lat"], point["lon"], point["alt"],
                                    point["speed"], point["track"]])
            log["handle"].flush()
        if page == "TRACK":
            lines_log = [f"Logging: {'ON' if log['handle'] is not None else 'off'}",
                         f"Points:  {len(track)}", f"Waypoints: {len(waypoints)}"]
            if log["path"]:
                lines_log.append(f"File: {os.path.basename(log['path'])}")
            if log["export"]:
                lines_log.append(f"Exported: {os.path.basename(log['export'])}")
            ui["log_text"].set_label("\n".join(lines_log))
        if page == "TOOLS":
            sun = sun_times(tpv["lat"], tpv["lon"], datetime.date.today()) if has_fix else None
            if not has_fix:
                ui["sun_text"].set_label("waiting for a fix")
            elif sun is None:
                ui["sun_text"].set_label("no sunrise/sunset today (polar day or night)")
            else:
                rise, sunset = sun[0].astimezone(), sun[1].astimezone()
                length = sun[1] - sun[0]
                ui["sun_text"].set_label(f"Sunrise: {rise:%H:%M}\nSunset:  {sunset:%H:%M}\n"
                                         f"Daylight: {length.seconds // 3600}h {length.seconds % 3600 // 60:02d}m")

    def close():
        stop.set()
        if log["handle"] is not None:
            log["handle"].close()
            log["handle"] = None

    app.connect("activate", activate)
    app.run(None)
    close()


if __name__ == "__main__":
    import sys
    if "--pin-dock" in sys.argv:
        sys.exit(0 if pin_to_dock() else 1)
    pin_to_dock()
    run_app()
