                def run_background(job):
                    busy["on"] = True
                    go.set_sensitive(False)

                    def work():
                        try:
                            job()
                        except Exception as error:
                            say(f"Error: {error}")
                        GLib.idle_add(finished)

                    def finished():
                        busy["on"] = False
                        go.set_sensitive(True)
                        refresh_listing()
                        return False
                    threading.Thread(target=work, daemon=True).start()

                def remove(key):
                    if not busy["on"]:
                        run_background(lambda: (remove_imagery(key), say("Imagery removed.")))

                def start_download():
                    index = county_pick.get_selected()
                    if busy["on"] or not 0 <= index < len(counties):
                        return
                    name, geoid = counties[index]
                    zmax = detail_levels[detail_pick.get_selected()]
                    run_background(lambda: download_imagery("usgs", geoid, f"{name}, "
                                   f"{STATES[fips[state_pick.get_selected()]]}", zmax, say))

                def load_counties(*_args):
                    state_fips = fips[state_pick.get_selected()]
                    county_pick.set_model(Gtk.StringList.new(["Loading…"]))
                    counties.clear()

                    def work():
                        try:
                            found = list_counties(state_fips)
                        except Exception as error:
                            say(f"Could not load counties (internet needed): {error}")
                            return

                        def apply():
                            if fips[state_pick.get_selected()] == state_fips:
                                counties[:] = found
                                county_pick.set_model(Gtk.StringList.new([n for n, _g in found]))
                            return False
                        GLib.idle_add(apply)
                    threading.Thread(target=work, daemon=True).start()
                state_pick.connect("notify::selected", load_counties)

                def estimate(*_args):
                    index = county_pick.get_selected()
                    if not 0 <= index < len(counties):
                        return
                    geoid = counties[index][1]
                    zmax = detail_levels[detail_pick.get_selected()]

                    def work():
                        try:
                            if geoid not in bboxes:
                                bboxes[geoid] = geojson_bbox(county_polygon(geoid))
                            tiles = count_tiles(bboxes[geoid], IMAGERY_MIN_ZOOM, zmax)
                            say(f"About {tiles:,} tiles, roughly {tiles * 25 // 1024} MB.")
                        except Exception:
                            pass
