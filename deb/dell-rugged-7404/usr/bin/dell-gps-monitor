#!/usr/bin/python3
"""Dell Rugged GPS Monitor: sky view, coordinates, GPS/local time, jamming indicator,
signal charts, navigation, track logging and sun times.

Reads the u-blox receiver through gpsd (localhost:2947). Nothing is written to the receiver
unless you use the confirmed buttons on the TOOLS tab.
"""
import datetime
import json
import math
import os
import re
import shutil
import socket
import subprocess
import threading
import time
from collections import deque

GPS_EPOCH = datetime.datetime(1980, 1, 6, tzinfo=datetime.timezone.utc)
GPS_UTC_LEAP_SECONDS = 18  # GPS time is ahead of UTC by this many seconds (since 2017)
CONSTELLATIONS = {0: ("GPS", "#2e7d32"), 1: ("SBAS", "#6a1b9a"), 2: ("Galileo", "#1565c0"),
                  3: ("BeiDou", "#c62828"), 5: ("QZSS", "#ef6c00"), 6: ("GLONASS", "#00838f")}


# ---------- coordinate formats ----------
def dms(value, positive, negative, places=2):
    hemisphere = positive if value >= 0 else negative
    value = abs(value)
    degrees = int(value)
    minutes_full = (value - degrees) * 60
    minutes = int(minutes_full)
    seconds = round((minutes_full - minutes) * 60, places)
    if seconds >= 60:
        seconds, minutes = 0.0, minutes + 1
    if minutes >= 60:
        minutes, degrees = 0, degrees + 1
    return f"{degrees}°{minutes:02d}'{seconds:0{places + 3}.{places}f}\"{hemisphere}"


def ddm(value, positive, negative, places=4):
    hemisphere = positive if value >= 0 else negative
    value = abs(value)
    degrees = int(value)
    return f"{degrees}°{(value - degrees) * 60:0{places + 3}.{places}f}'{hemisphere}"


def utm_zone(lat, lon):
    zone = int((lon + 180) // 6) + 1
    if 56 <= lat < 64 and 3 <= lon < 12:
        zone = 32
    elif 72 <= lat < 84 and lon >= 0:
        for limit, number in ((9, 31), (21, 33), (33, 35), (42, 37)):
            if lon < limit:
                zone = number
                break
    return min(max(zone, 1), 60)


def to_utm(lat, lon):
    """WGS84 latitude/longitude to (zone, hemisphere, easting, northing) using Krueger series."""
    a, f = 6378137.0, 1 / 298.257223563
    n = f / (2 - f)
    big_a = a / (1 + n) * (1 + n ** 2 / 4 + n ** 4 / 64)
    alpha = [n / 2 - 2 * n ** 2 / 3 + 5 * n ** 3 / 16,
             13 * n ** 2 / 48 - 3 * n ** 3 / 5,
             61 * n ** 3 / 240]
    zone = utm_zone(lat, lon)
    lon0 = math.radians((zone - 1) * 6 - 180 + 3)
    phi, dlon = math.radians(lat), math.radians(lon) - lon0
    t = math.sinh(math.atanh(math.sin(phi)) - 2 * math.sqrt(n) / (1 + n)
                  * math.atanh(2 * math.sqrt(n) / (1 + n) * math.sin(phi)))
    xi = math.atan2(t, math.cos(dlon))
    eta = math.atanh(math.sin(dlon) / math.sqrt(1 + t * t))
    easting = eta
    northing = xi
    for j, coefficient in enumerate(alpha, start=1):
        easting += coefficient * math.cos(2 * j * xi) * math.sinh(2 * j * eta)
        northing += coefficient * math.sin(2 * j * xi) * math.cosh(2 * j * eta)
    easting = 500000 + 0.9996 * big_a * easting
    northing = 0.9996 * big_a * northing
    if lat < 0:
        northing += 10000000
    return zone, "N" if lat >= 0 else "S", easting, northing


def latitude_band(lat):
    return "CDEFGHJKLMNPQRSTUVWXX"[min(int((lat + 80) // 8), 20)]


def to_mgrs(lat, lon, digits=5):
    if not -80 <= lat <= 84:
        return "n/a (outside MGRS UTM range)"
    zone, _, easting, northing = to_utm(lat, lon)
    column = ("ABCDEFGH", "JKLMNPQR", "STUVWXYZ")[(zone - 1) % 3][int(easting // 100000) - 1]
    row = "ABCDEFGHJKLMNPQRSTUV"[(int(northing // 100000) + (5 if zone % 2 == 0 else 0)) % 20]
    scale = 10 ** (5 - digits)
    return (f"{zone}{latitude_band(lat)} {column}{row} "
            f"{int(easting % 100000 // scale):0{digits}d} {int(northing % 100000 // scale):0{digits}d}")


def maidenhead(lat, lon):
    lon, lat = lon + 180, lat + 90
    text = chr(65 + int(lon // 20)) + chr(65 + int(lat // 10))
    text += str(int(lon % 20 // 2)) + str(int(lat % 10))
    text += chr(97 + int(lon % 2 * 12)) + chr(97 + int(lat % 1 * 24))
    return text


def coordinate_lines(lat, lon, altitude=None):
    zone, hemisphere, easting, northing = to_utm(lat, lon)
    lines = [
        ("Decimal degrees", f"{lat:.6f}, {lon:.6f}"),
        ("Deg / dec minutes", f"{ddm(lat, 'N', 'S')}  {ddm(lon, 'E', 'W')}"),
        ("Deg / min / sec", f"{dms(lat, 'N', 'S')}  {dms(lon, 'E', 'W')}"),
        ("UTM", f"{zone}{latitude_band(lat)} {easting:.0f} mE {northing:.0f} mN"
                if -80 <= lat <= 84 else f"{zone}{hemisphere} {easting:.0f} {northing:.0f}"),
        ("MGRS / US National Grid", to_mgrs(lat, lon)),
        ("Maidenhead", maidenhead(lat, lon)),
    ]
    if altitude is not None:
        lines.append(("Altitude", f"{altitude:.1f} m  /  {altitude * 3.28084:.0f} ft"))
    return lines


# ---------- time ----------
def parse_gps_utc(text):
    return datetime.datetime.fromisoformat(text.replace("Z", "+00:00"))


def time_lines(utc):
    gps = utc + datetime.timedelta(seconds=GPS_UTC_LEAP_SECONDS)
    since = gps - GPS_EPOCH
    week, tow = divmod(since.total_seconds(), 7 * 86400)
    local = utc.astimezone()
    return [
        ("GPS time", gps.strftime("%Y-%m-%d %H:%M:%S") + f"  (week {int(week)}, TOW {tow:.0f} s)"),
        ("UTC (from GPS)", utc.strftime("%Y-%m-%d %H:%M:%S")),
        ("Local time", local.strftime("%Y-%m-%d %H:%M:%S %Z (UTC%z)")),
    ]


# ---------- jamming ----------
def parse_mon_hw(text):
    """Extract jamInd, antenna status and (if reported) jamming state from ubxtool MON-HW output."""
    result = {}
    match = re.search(r"jamInd\s+(\d+)", text)
    if match:
        result["jam"] = int(match.group(1))
    match = re.search(r"aStatus\s+(\d+)", text)
    if match:
        result["antenna"] = {0: "initializing", 1: "unknown", 2: "OK", 3: "short circuit",
                             4: "open circuit"}.get(int(match.group(1)), "unknown")
    match = re.search(r"\bflags\s+x([0-9a-fA-F]+)", text)
    if match:
        result["jam_state"] = {0: "unknown", 1: "OK", 2: "warning", 3: "critical"}[
            (int(match.group(1), 16) >> 2) & 3]
    return result


def jam_level(value):
    if value is None:
        return "unknown", "#757575"
    if value < 40:
        return "none / low", "#2e7d32"
    if value < 100:
        return "possible interference", "#ef6c00"
    return "STRONG interference", "#c62828"


def sky_xy(azimuth, elevation, radius):
    distance = (90 - elevation) / 90 * radius
    angle = math.radians(azimuth)
    return distance * math.sin(angle), -distance * math.cos(angle)


# ---------- gpsd data ----------
class GpsState:
    def __init__(self):
        self.lock = threading.Lock()
        self.connected = False
        self.device = None
        self.tpv = {}
        self.sky = []
        self.dops = {}
        self.hw = {}
        self.jam_history = deque(maxlen=720)


def gpsd_reader(state, stop):
    while not stop.is_set():
        try:
            with socket.create_connection(("127.0.0.1", 2947), timeout=5) as connection:
                connection.sendall(b'?WATCH={"enable":true,"json":true}\n')
                connection.settimeout(5)
                with state.lock:
                    state.connected = True
                buffer = b""
                while not stop.is_set():
                    try:
                        chunk = connection.recv(8192)
                    except socket.timeout:
                        continue
                    if not chunk:
                        break
                    buffer += chunk
                    *lines, buffer = buffer.split(b"\n")
                    for raw in lines:
                        try:
                            message = json.loads(raw)
                        except ValueError:
                            continue
                        with state.lock:
                            apply_message(state, message)
        except OSError:
            pass
        with state.lock:
            state.connected = False
        stop.wait(2)


def apply_message(state, message):
    kind = message.get("class")
    if kind == "TPV":
        state.tpv = message
    elif kind == "SKY":
        if "satellites" in message:
            state.sky = message["satellites"]
        state.dops = {key: message[key] for key in ("hdop", "vdop", "pdop") if key in message}
    elif kind == "DEVICES":
        devices = message.get("devices") or []
        state.device = devices[0].get("path") if devices else None
    elif kind == "DEVICE":
        state.device = message.get("path")


def hw_poller(state, stop):
    while not stop.is_set():
        if shutil.which("ubxtool"):
            try:
                out = subprocess.run(["ubxtool", "-p", "MON-HW"], capture_output=True,
                                     text=True, timeout=15).stdout
                parsed = parse_mon_hw(out)
                if parsed:
                    with state.lock:
                        state.hw = parsed
                        if "jam" in parsed:
                            state.jam_history.append((time.time(), parsed["jam"]))
            except (OSError, subprocess.SubprocessError):
                pass
        stop.wait(5)


# ---------- navigation, sun, track export ----------
DATA_DIR = os.path.expanduser("~/GPS-Tracks")
COMPASS_POINTS = ("N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE",
                  "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW")


def bearing_distance(lat1, lon1, lat2, lon2):
    """Great-circle distance in metres and initial bearing in degrees from point 1 to point 2."""
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dlat, dlon = p2 - p1, math.radians(lon2 - lon1)
    a = math.sin(dlat / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dlon / 2) ** 2
    distance = 2 * 6371008.8 * math.asin(min(1, math.sqrt(a)))
    y = math.sin(dlon) * math.cos(p2)
    x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dlon)
    return distance, (math.degrees(math.atan2(y, x)) + 360) % 360


def compass_point(degrees):
    return COMPASS_POINTS[int((degrees % 360) / 22.5 + 0.5) % 16]


def format_distance(metres):
    if metres < 1000:
        return f"{metres:.0f} m"
    return f"{metres / 1000:.2f} km  ({metres / 1609.344:.2f} mi)"


def turn_hint(heading, bearing):
    delta = (bearing - heading + 540) % 360 - 180
    if abs(delta) < 3:
        return "on course"
    return f"{abs(delta):.0f}° {'right' if delta > 0 else 'left'}"


def dop_quality(value):
    """Rate a dilution-of-precision value; lower is better."""
    if value is None:
        return "-", "#757575"
    if value <= 2:
        return "good", "#2e7d32"
    if value <= 5:
        return "fair", "#ef6c00"
    return "poor", "#c62828"


def sun_times(lat, lon, day):
    """Sunrise and sunset (aware UTC datetimes) for a date, or None in polar day/night."""
    days = (day - datetime.date(2000, 1, 1)).days
    jstar = days - lon / 360
    anomaly = (357.5291 + 0.98560028 * jstar) % 360
    m = math.radians(anomaly)
    center = 1.9148 * math.sin(m) + 0.02 * math.sin(2 * m) + 0.0003 * math.sin(3 * m)
    ecliptic = math.radians((anomaly + center + 180 + 102.9372) % 360)
    transit = jstar + 0.0053 * math.sin(m) - 0.0069 * math.sin(2 * ecliptic)
    sin_dec = math.sin(ecliptic) * math.sin(math.radians(23.4397))
    cos_dec = math.sqrt(1 - sin_dec ** 2)
    phi = math.radians(lat)
    cos_h = (math.sin(math.radians(-0.833)) - math.sin(phi) * sin_dec) / (math.cos(phi) * cos_dec)
    if abs(cos_h) > 1:
        return None
    half = math.degrees(math.acos(cos_h)) / 360
    base = datetime.datetime(2000, 1, 1, 12, tzinfo=datetime.timezone.utc)
    return (base + datetime.timedelta(days=transit - half),
            base + datetime.timedelta(days=transit + half))


def gpx_text(track, waypoints, name="Dell Rugged track"):
    from xml.sax.saxutils import escape

    def ele(value):
        return f"<ele>{value:.1f}</ele>" if value is not None else ""

    out = ['<?xml version="1.0" encoding="UTF-8"?>',
           '<gpx version="1.1" creator="Dell Rugged GPS Monitor" xmlns="http://www.topografix.com/GPX/1/1">']
    for wp in waypoints:
        out.append(f'  <wpt lat="{wp["lat"]:.7f}" lon="{wp["lon"]:.7f}">{ele(wp.get("alt"))}'
                   f'<name>{escape(wp["name"])}</name></wpt>')
    out.append(f"  <trk><name>{escape(name)}</name><trkseg>")
    for p in track:
        out.append(f'    <trkpt lat="{p["lat"]:.7f}" lon="{p["lon"]:.7f}">{ele(p.get("alt"))}'
                   f'<time>{p["time"]}</time></trkpt>')
    out += ["  </trkseg></trk>", "</gpx>"]
    return "\n".join(out) + "\n"


def load_waypoints(path):
    try:
        with open(path) as handle:
            return [w for w in json.load(handle) if {"name", "lat", "lon"} <= set(w)]
    except (OSError, ValueError, TypeError):
        return []


def save_waypoints(path, waypoints):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as handle:
        json.dump(waypoints, handle, indent=1)


# ---------- UI ----------
LIGHT = {"bg": "#f6f5f4", "fg": "#2e3436", "sky": "#ffffff", "ring": "#bdbdbd", "ringtext": "#9e9e9e",
         "cross": "#e0e0e0", "bar": "#e0e0e0", "ss": "#616161", "hollow": "#ffffff", "btn": "#e8e6e3"}
DARK = {"bg": "#2b2b2b", "fg": "#eeeeec", "sky": "#1e1e1e", "ring": "#5a5a5a", "ringtext": "#8a8a8a",
        "cross": "#3a3a3a", "bar": "#3d3d3d", "ss": "#b0b0b0", "hollow": "#1e1e1e", "btn": "#3d3d3d"}


def system_is_dark():
    """True when the Ubuntu/GNOME appearance setting is dark."""
    def get(schema, key):
        try:
            return subprocess.run(["gsettings", "get", schema, key], capture_output=True,
                                  text=True, timeout=3).stdout.strip().strip("'")
        except (OSError, subprocess.SubprocessError):
            return ""
    scheme = get("org.gnome.desktop.interface", "color-scheme")
    if scheme in ("prefer-dark", "prefer-light"):
        return scheme == "prefer-dark"
    return "dark" in get("org.gnome.desktop.interface", "gtk-theme").lower()


DESKTOP_ID = "dell-gps-monitor.desktop"


def pin_to_dock():
    """Add the app to the Ubuntu dock once; a later manual unpin is respected."""
    import ast
    import os
    marker = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
                          "dell-rugged-7404", "dock-pinned")
    if os.path.exists(marker):
        return False
    try:
        out = subprocess.run(["gsettings", "get", "org.gnome.shell", "favorite-apps"],
                             capture_output=True, text=True, timeout=5)
        if out.returncode != 0:
            return False
        favorites = ast.literal_eval(out.stdout.strip().replace("@as ", ""))
        if DESKTOP_ID not in favorites:
            favorites.append(DESKTOP_ID)
            subprocess.run(["gsettings", "set", "org.gnome.shell", "favorite-apps", str(favorites)],
                           check=True, timeout=5)
        os.makedirs(os.path.dirname(marker), exist_ok=True)
        open(marker, "w").close()
        return True
    except (OSError, ValueError, SyntaxError, subprocess.SubprocessError):
        return False


TABS = ("LIVE", "SIGNALS", "NAVIGATE", "TRACK", "TOOLS")
AMBER = "#f2b01e"
RECEIVER_RATES = (("1 Hz", 1000), ("2 Hz", 500), ("5 Hz", 200))
RECEIVER_CONSTELLATIONS = ("GALILEO", "GLONASS", "BEIDOU")


def run_app():
    import csv
    import tkinter as tk
    from tkinter import font as tkfont, messagebox, simpledialog

    state, stop = GpsState(), threading.Event()
    for target in (gpsd_reader, hw_poller):
        threading.Thread(target=target, args=(state, stop), daemon=True).start()

    root = tk.Tk(className="dell-gps-monitor")
    root.option_add("*Button.padY", 8)
    root.title("Dell Rugged GPS Monitor")
    root.geometry("1180x720")
    theme = {"dark": system_is_dark()}
    pal = dict(DARK if theme["dark"] else LIGHT)
    mono = tkfont.Font(family="DejaVu Sans Mono", size=11)
    bold = tkfont.Font(family="DejaVu Sans Mono", size=11, weight="bold")
    big = tkfont.Font(family="DejaVu Sans", size=14, weight="bold")
    small = tkfont.Font(family="DejaVu Sans", size=9, weight="bold")
    plain_fg = []

    def label(parent, **kwargs):
        widget = tk.Label(parent, **kwargs)
        plain_fg.append(widget)
        return widget

    waypoints_file = os.path.join(DATA_DIR, "waypoints.json")
    waypoints = load_waypoints(waypoints_file)
    track = []
    log = {"writer": None, "handle": None, "path": None, "last": None, "export": None}
    nav = {"target": None, "tpv": {}, "alert": False, "message": None}

    # ----- left: sky view -----
    left = tk.Frame(root)
    left.pack(side="left", fill="both", expand=True, padx=8, pady=8)
    canvas = tk.Canvas(left, width=480, height=520, bg=pal["sky"], highlightthickness=0)
    canvas.pack(fill="both", expand=True)
    legend = tk.Frame(left)
    legend.pack(fill="x")
    for name, color in CONSTELLATIONS.values():
        tk.Label(legend, text="● " + name, fg=color, font=bold).pack(side="left", padx=4)
    hint = label(left, anchor="w", font=("DejaVu Sans", 9),
                 text="Filled = used in fix, hollow = tracked only; number below satellite = dB-Hz")
    hint.pack(fill="x")

    # ----- right: status + tabs -----
    right = tk.Frame(root)
    right.pack(side="right", fill="both", padx=8, pady=8)
    status = tk.Label(right, font=big, anchor="w")
    status.pack(fill="x")
    tabbar = tk.Frame(right)
    tabbar.pack(fill="x", pady=(4, 6))
    container = tk.Frame(right)
    container.pack(fill="both", expand=True)
    pages, tab_buttons, current = {}, {}, {"page": "LIVE"}

    def show(name):
        current["page"] = name
        for key, page in pages.items():
            page.pack_forget()
        pages[name].pack(fill="both", expand=True)
        for key, button in tab_buttons.items():
            active = key == name
            button.config(bg=AMBER if active else pal["btn"], fg="#1a1200" if active else pal["fg"],
                          activebackground=AMBER, relief="sunken" if active else "raised")

    for name in TABS:
        pages[name] = tk.Frame(container)
        tab_buttons[name] = tk.Button(tabbar, text=name, font=bold, padx=6, pady=12,
                                      command=lambda n=name: show(n))
        # Touch screens can jitter between press and release, which cancels a normal click.
        tab_buttons[name].bind("<ButtonPress-1>", lambda e, n=name: show(n))
        tab_buttons[name].pack(side="left", fill="x", expand=True, padx=2)

    # ----- LIVE tab -----
    live = pages["LIVE"]
    body = tk.Text(live, font=mono, width=46, height=22, relief="flat", wrap="none",
                   bg=root.cget("bg"), highlightthickness=0, cursor="arrow")
    body.tag_configure("title", font=bold)
    body.tag_configure("section", font=bold, background=AMBER, foreground="#1a1200",
                       spacing1=10, spacing3=4)
    bottom = tk.Frame(live)
    bottom.pack(side="bottom", fill="x")
    scroll = tk.Scrollbar(live, command=body.yview)
    body.configure(yscrollcommand=scroll.set)
    scroll.pack(side="right", fill="y")
    body.pack(fill="both", expand=True)
    jam_title = label(bottom, text="JAMMING INDICATOR", font=bold, anchor="w")
    jam_title.pack(fill="x", pady=(10, 0))
    jam_bar = tk.Canvas(bottom, width=420, height=26, bg="#eeeeee", highlightthickness=0)
    jam_bar.pack(fill="x")
    jam_text = tk.Label(bottom, font=mono, anchor="w", justify="left")
    jam_text.pack(fill="x")
    label(bottom, anchor="w", font=("DejaVu Sans", 9),
          text="Click any value above to copy it").pack(fill="x")
    shown = {"text": ""}

    def flash(text):
        copy_button.config(text=text)
        root.after(1500, lambda: copy_button.config(text="Copy coordinates and time"))

    def copy_text(text, note="Copied"):
        root.clipboard_clear()
        root.clipboard_append(text)
        flash(f"{note}: {text[:34]}")

    copy_button = tk.Button(bottom, text="Copy coordinates and time",
                            command=lambda: copy_text(shown["text"], "Copied all"))
    copy_button.pack(anchor="w", pady=6)

    # ----- SIGNALS tab -----
    sig = pages["SIGNALS"]
    dash = tk.Frame(sig)
    dash.pack(fill="x")
    dash_values = {}
    for column, key in enumerate(("FIX", "HDOP", "VDOP", "PDOP", "ACCURACY")):
        cell = tk.Frame(dash)
        cell.grid(row=0, column=column, padx=6)
        label(cell, text=key, font=small).pack()
        dash_values[key] = tk.Label(cell, font=big)
        dash_values[key].pack()
    label(sig, text="SIGNAL STRENGTH (dB-Hz)", font=bold, anchor="w").pack(fill="x", pady=(10, 0))
    sig_canvas = tk.Canvas(sig, width=420, height=200, highlightthickness=0)
    sig_canvas.pack(fill="x")
    label(sig, text="JAMMING HISTORY", font=bold, anchor="w").pack(fill="x", pady=(10, 0))
    jam_canvas = tk.Canvas(sig, width=420, height=170, highlightthickness=0)
    jam_canvas.pack(fill="x")
    label(sig, anchor="w", font=("DejaVu Sans", 9),
          text="Amber line = possible interference, red line = strong interference").pack(fill="x")

    # ----- NAVIGATE tab -----
    navp = pages["NAVIGATE"]
    compass = tk.Canvas(navp, width=240, height=240, highlightthickness=0)
    compass.pack()
    nav_text = label(navp, font=mono, anchor="w", justify="left")
    nav_text.pack(fill="x")
    list_frame = tk.Frame(navp)
    list_frame.pack(fill="both", expand=True, pady=4)
    wp_list = tk.Listbox(list_frame, height=5, font=("DejaVu Sans Mono", 10), exportselection=False)
    wp_list.pack(side="left", fill="both", expand=True)
    wp_scroll = tk.Scrollbar(list_frame, command=wp_list.yview)
    wp_scroll.pack(side="right", fill="y")
    wp_list.config(yscrollcommand=wp_scroll.set)
    wp_buttons = tk.Frame(navp)
    wp_buttons.pack(fill="x")

    def refresh_waypoints():
        wp_list.delete(0, "end")
        for wp in waypoints:
            mark = "► " if nav["target"] is wp else "  "
            wp_list.insert("end", f"{mark}{wp['name']}  {wp['lat']:.5f}, {wp['lon']:.5f}")

    def add_waypoint():
        tpv = nav["tpv"]
        if tpv.get("mode", 0) < 2 or "lat" not in tpv:
            messagebox.showinfo("Waypoint", "No GPS fix yet.", parent=root)
            return
        name = simpledialog.askstring("Waypoint", "Name:", initialvalue=f"WP{len(waypoints) + 1}",
                                      parent=root)
        if not name:
            return
        waypoints.append({"name": name.strip(), "lat": tpv["lat"], "lon": tpv["lon"],
                          "alt": tpv.get("altHAE", tpv.get("alt"))})
        save_waypoints(waypoints_file, waypoints)
        refresh_waypoints()

    def selected_waypoint():
        picked = wp_list.curselection()
        return waypoints[picked[0]] if picked else None

    def set_target():
        nav["target"] = selected_waypoint()
        refresh_waypoints()

    def delete_waypoint():
        wp = selected_waypoint()
        if wp is not None:
            if nav["target"] is wp:
                nav["target"] = None
            waypoints.remove(wp)
            save_waypoints(waypoints_file, waypoints)
            refresh_waypoints()

    def clear_target():
        nav["target"] = None
        refresh_waypoints()

    for text, command in (("Add waypoint here", add_waypoint), ("Go to selected", set_target),
                          ("Clear target", clear_target), ("Delete", delete_waypoint)):
        tk.Button(wp_buttons, text=text, command=command, font=("DejaVu Sans", 9)).pack(side="left", padx=2)

    # ----- TRACK tab -----
    trackp = pages["TRACK"]
    label(trackp, text="TRACK LOG", font=bold, anchor="w").pack(fill="x")
    log_text = label(trackp, font=mono, anchor="w", justify="left", wraplength=430)
    log_text.pack(fill="x", pady=4)
    track_buttons = tk.Frame(trackp)
    track_buttons.pack(fill="x")

    def toggle_log():
        if log["handle"] is not None:
            log["handle"].close()
            log["handle"] = log["writer"] = None
            log_button.config(text="Start track log")
            return
        os.makedirs(DATA_DIR, exist_ok=True)
        log["path"] = os.path.join(DATA_DIR, time.strftime("track-%Y%m%d-%H%M%S.csv"))
        log["handle"] = open(log["path"], "w", newline="")
        log["writer"] = csv.writer(log["handle"])
        log["writer"].writerow(["time_utc", "lat", "lon", "alt_m", "speed_mps", "track_deg"])
        log["last"] = None
        track.clear()
        log_button.config(text="Stop track log")

    def export_gpx():
        if not track and not waypoints:
            messagebox.showinfo("Export GPX", "Nothing to export yet. Start the track log first.",
                                parent=root)
            return
        os.makedirs(DATA_DIR, exist_ok=True)
        path = os.path.join(DATA_DIR, time.strftime("export-%Y%m%d-%H%M%S.gpx"))
        with open(path, "w") as handle:
            handle.write(gpx_text(track, waypoints))
        log["export"] = path

    def open_folder():
        os.makedirs(DATA_DIR, exist_ok=True)
        if shutil.which("xdg-open"):
            subprocess.Popen(["xdg-open", DATA_DIR])

    log_button = tk.Button(track_buttons, text="Start track log", command=toggle_log)
    log_button.pack(side="left", padx=2)
    tk.Button(track_buttons, text="Export GPX", command=export_gpx).pack(side="left", padx=2)
    tk.Button(track_buttons, text="Open folder", command=open_folder).pack(side="left", padx=2)
    label(trackp, anchor="w", justify="left", font=("DejaVu Sans", 9), wraplength=430,
          text=f"Logs are saved as CSV (one point per second while there is a fix) in {DATA_DIR}. "
               "Export GPX writes this session's track plus your waypoints for use in "
               "mapping apps.").pack(fill="x", pady=8)

    # ----- TOOLS tab -----
    tools = pages["TOOLS"]
    label(tools, text="SUN (at your position)", font=bold, anchor="w").pack(fill="x")
    sun_text = label(tools, font=mono, anchor="w", justify="left")
    sun_text.pack(fill="x", pady=(2, 10))
    label(tools, text="RECEIVER SETUP", font=bold, anchor="w").pack(fill="x")
    label(tools, anchor="w", justify="left", font=("DejaVu Sans", 9), wraplength=430,
          text="These write to the GPS receiver (asks first). Changes are not saved to its flash; "
               "a receiver reset restores the defaults.").pack(fill="x")

    def receiver(args, description):
        if not shutil.which("ubxtool"):
            messagebox.showerror("Receiver setup", "ubxtool is not installed (package gpsd-clients).",
                                 parent=root)
            return
        if not messagebox.askyesno("Change receiver settings", f"{description}\n\nContinue?", parent=root):
            return
        tool_out.config(text="Working...")

        def work():
            try:
                out = subprocess.run(["ubxtool", "-P", "15", *args], capture_output=True,
                                     text=True, timeout=30).stdout
                if "ACK-NAK" in out:
                    message = "Receiver rejected the change."
                elif "ACK-ACK" in out:
                    message = "Receiver accepted the change."
                else:
                    message = "\n".join(out.strip().splitlines()[-4:]) or "No reply from receiver."
            except (OSError, subprocess.SubprocessError) as error:
                message = f"Failed: {error}"
            nav["message"] = message

        threading.Thread(target=work, daemon=True).start()

    for name in RECEIVER_CONSTELLATIONS:
        row = tk.Frame(tools)
        row.pack(fill="x", pady=1)
        label(row, text=name.title(), font=mono, width=9, anchor="w").pack(side="left")
        tk.Button(row, text="Enable", command=lambda n=name: receiver(
            ["-e", n], f"Enable {n.title()} tracking.")).pack(side="left", padx=2)
        tk.Button(row, text="Disable", command=lambda n=name: receiver(
            ["-d", n], f"Disable {n.title()} tracking.")).pack(side="left", padx=2)
    rate_row = tk.Frame(tools)
    rate_row.pack(fill="x", pady=(6, 1))
    label(rate_row, text="Update rate", font=mono, width=11, anchor="w").pack(side="left")
    for text, milliseconds in RECEIVER_RATES:
        tk.Button(rate_row, text=text, command=lambda t=text, ms=milliseconds: receiver(
            ["-p", f"RATE,{ms}"], f"Set the position update rate to {t}.")).pack(side="left", padx=2)
    tool_out = label(tools, anchor="w", justify="left", font=("DejaVu Sans", 9), wraplength=430)
    tool_out.pack(fill="x", pady=8)

    # ----- theme -----
    def restyle(widget):
        for child in widget.winfo_children():
            kind = child.winfo_class()
            if kind == "Frame":
                child.configure(bg=pal["bg"])
            elif kind == "Label":
                child.configure(bg=pal["bg"])
                if child in plain_fg:
                    child.configure(fg=pal["fg"])
            elif kind == "Button" and child not in tab_buttons.values():
                child.configure(bg=pal["btn"], fg=pal["fg"], activebackground=pal["bar"],
                                activeforeground=pal["fg"], highlightbackground=pal["bg"])
            elif kind == "Listbox":
                child.configure(bg=pal["sky"], fg=pal["fg"])
            restyle(child)

    def apply_theme():
        pal.update(DARK if theme["dark"] else LIGHT)
        root.configure(bg=pal["bg"])
        restyle(root)
        for widget in (canvas, sig_canvas, jam_canvas, compass):
            widget.configure(bg=pal["sky"])
        jam_bar.configure(bg=pal["bar"])
        body.configure(bg=pal["bg"], fg=pal["fg"])
        show(current["page"])

    def watch_theme():
        dark = system_is_dark()
        if dark != theme["dark"]:
            theme["dark"] = dark
            apply_theme()
        root.after(3000, watch_theme)

    # ----- drawing -----
    def draw_sky(satellites):
        canvas.delete("all")
        width, height = max(canvas.winfo_width(), 200), max(canvas.winfo_height(), 200)
        cx, cy, radius = width / 2, height / 2, min(width, height) / 2 - 26
        for elevation in (0, 30, 60):
            r = (90 - elevation) / 90 * radius
            canvas.create_oval(cx - r, cy - r, cx + r, cy + r, outline=pal["ring"])
            if elevation:
                canvas.create_text(cx + 4, cy - r + 2, text=f"{elevation}°", anchor="nw", fill=pal["ringtext"])
        canvas.create_line(cx - radius, cy, cx + radius, cy, fill=pal["cross"])
        canvas.create_line(cx, cy - radius, cx, cy + radius, fill=pal["cross"])
        for text, azimuth in (("N", 0), ("E", 90), ("S", 180), ("W", 270)):
            x, y = sky_xy(azimuth, -4, radius)
            canvas.create_text(cx + x, cy + y, text=text, font=bold, fill=pal["fg"])
        for sat in satellites:
            if "az" not in sat or "el" not in sat:
                continue
            name, color = CONSTELLATIONS.get(sat.get("gnssid"), ("?", "#616161"))
            x, y = sky_xy(sat["az"], sat["el"], radius)
            r = 11
            used = sat.get("used")
            canvas.create_oval(cx + x - r, cy + y - r, cx + x + r, cy + y + r,
                               fill=color if used else pal["hollow"], outline=color, width=2)
            canvas.create_text(cx + x, cy + y, text=str(sat.get("svid", sat.get("PRN", ""))),
                               fill="white" if used else color, font=("DejaVu Sans", 8, "bold"))
            canvas.create_text(cx + x, cy + y + r + 7, text=f"{sat.get('ss', 0):.0f}",
                               fill=pal["ss"], font=("DejaVu Sans", 7))

    def draw_bars(satellites):
        sig_canvas.delete("all")
        width, height = max(sig_canvas.winfo_width(), 200), max(sig_canvas.winfo_height(), 100)
        top, foot, left_pad = 8, 24, 26
        plot = height - top - foot
        for level in (20, 40):
            y = top + plot * (1 - level / 55)
            sig_canvas.create_line(left_pad, y, width, y, fill=pal["cross"])
            sig_canvas.create_text(2, y, text=str(level), anchor="w", fill=pal["ringtext"], font=("DejaVu Sans", 8))
        sats = sorted((s for s in satellites if s.get("ss") is not None),
                      key=lambda s: (s.get("gnssid", 9), s.get("svid", 0)))
        if not sats:
            sig_canvas.create_text(width / 2, height / 2, text="no satellites", fill=pal["fg"])
            return
        slot = (width - left_pad - 4) / len(sats)
        for index, sat in enumerate(sats):
            color = CONSTELLATIONS.get(sat.get("gnssid"), ("?", "#616161"))[1]
            x0 = left_pad + index * slot + slot * 0.12
            x1 = left_pad + (index + 1) * slot - slot * 0.12
            y0 = top + plot * (1 - min(sat["ss"], 55) / 55)
            sig_canvas.create_rectangle(x0, y0, x1, top + plot, outline=color, width=2,
                                        fill=color if sat.get("used") else "")
            if slot >= 14:
                sig_canvas.create_text((x0 + x1) / 2, top + plot + 10, text=str(sat.get("svid", "")),
                                       fill=pal["fg"], font=("DejaVu Sans", 8))

    def draw_jam_history(history):
        jam_canvas.delete("all")
        width, height = max(jam_canvas.winfo_width(), 200), max(jam_canvas.winfo_height(), 80)
        left_pad, top, foot = 30, 6, 16
        plot = height - top - foot

        def y_of(value):
            return top + plot * (1 - value / 255)
        for level, color in ((40, AMBER), (100, "#c62828")):
            jam_canvas.create_line(left_pad, y_of(level), width, y_of(level), fill=color, dash=(4, 3))
            jam_canvas.create_text(2, y_of(level), text=str(level), anchor="w", fill=pal["ringtext"],
                                   font=("DejaVu Sans", 8))
        if len(history) < 2:
            jam_canvas.create_text(width / 2, height / 2, text="collecting data...", fill=pal["fg"])
            return
        start, end = history[0][0], history[-1][0]
        span = max(end - start, 1)
        points = [(left_pad + (t - start) / span * (width - left_pad - 4), y_of(v), v) for t, v in history]
        for (x0, y0, _), (x1, y1, v1) in zip(points, points[1:]):
            jam_canvas.create_line(x0, y0, x1, y1, fill=jam_level(v1)[1], width=2)
        jam_canvas.create_text(left_pad, height - 2, text=f"-{span / 60:.0f} min", anchor="sw",
                               fill=pal["ringtext"], font=("DejaVu Sans", 8))
        jam_canvas.create_text(width - 4, height - 2, text="now", anchor="se",
                               fill=pal["ringtext"], font=("DejaVu Sans", 8))

    def draw_compass(heading, bearing):
        compass.delete("all")
        cx = cy = 120
        radius = 100
        compass.create_oval(cx - radius, cy - radius, cx + radius, cy + radius, outline=pal["ring"], width=2)
        for text, angle in (("N", 0), ("E", 90), ("S", 180), ("W", 270)):
            x, y = sky_xy(angle, -6, radius + 1)
            compass.create_text(cx + x, cy + y, text=text, font=bold, fill=pal["fg"])
        for angle in range(0, 360, 30):
            x0, y0 = sky_xy(angle, 0, radius)
            x1, y1 = sky_xy(angle, 6, radius)
            compass.create_line(cx + x0, cy + y0, cx + x1, cy + y1, fill=pal["ring"])
        if bearing is not None:
            x, y = sky_xy(bearing, 8, radius)
            compass.create_line(cx, cy, cx + x, cy + y, fill="#1565c0", width=5, arrow="last",
                                arrowshape=(14, 16, 6))
        if heading is not None:
            x, y = sky_xy(heading, 12, radius)
            compass.create_line(cx, cy, cx + x, cy + y, fill=AMBER, width=3, arrow="last",
                                arrowshape=(12, 14, 5))
        compass.create_oval(cx - 4, cy - 4, cx + 4, cy + 4, fill=pal["fg"], outline="")

    # ----- refresh loop -----
    def refresh():
        with state.lock:
            tpv, sky, dops, hw = dict(state.tpv), list(state.sky), dict(state.dops), dict(state.hw)
            connected, device = state.connected, state.device
            history = list(state.jam_history)
        nav["tpv"] = tpv
        mode = tpv.get("mode", 0)
        if nav["message"]:
            tool_out.config(text=nav["message"])
            nav["message"] = None
        jam_value = hw.get("jam")
        alert = (jam_value is not None and jam_value >= 100) or hw.get("jam_state") == "critical"
        if alert and not nav["alert"]:
            root.bell()
        nav["alert"] = alert
        if not connected:
            status.config(text="gpsd not running", fg="#c62828")
        elif device is None:
            status.config(text="No GPS attached to gpsd", fg="#c62828")
        else:
            fix = {0: "No data", 1: "No fix", 2: "2D fix", 3: "3D fix"}.get(mode, "?")
            status.config(text=("⚠ JAMMING ALERT  " if alert else "") + fix,
                          fg="#c62828" if alert else "#2e7d32" if mode >= 2 else "#ef6c00")

        lines = []
        header = lambda name: lines.append((name, None))
        if mode >= 2 and "lat" in tpv and "lon" in tpv:
            header("COORDINATES")
            for item in coordinate_lines(tpv["lat"], tpv["lon"], tpv.get("altHAE", tpv.get("alt"))):
                lines.append(item)
            if "eph" in tpv or "speed" in tpv:
                header("MOTION / ACCURACY")
            if "eph" in tpv:
                lines.append(("Accuracy (est.)", f"±{tpv['eph']:.1f} m horiz"
                              + (f", ±{tpv['epv']:.1f} m vert" if "epv" in tpv else "")))
            if "speed" in tpv:
                lines.append(("Speed / track", f"{tpv['speed'] * 3.6:.1f} km/h"
                              + (f", {tpv['track']:.0f}°" if "track" in tpv else "")))
        if "time" in tpv:
            header("TIME")
            lines.extend(time_lines(parse_gps_utc(tpv["time"])))
        used = sum(1 for s in sky if s.get("used"))
        header("SATELLITES")
        lines.append(("Satellites", f"{used} used / {len(sky)} seen"
                      + (f"   HDOP {dops['hdop']}" if "hdop" in dops else "")))
        text = "\n".join(f"\n== {name} ==" if value is None else f"{name}:\n  {value}"
                         for name, value in lines).strip()
        if text != shown["text"]:
            shown["text"] = text
            top_of_view = body.yview()[0]
            body.config(state="normal")
            body.delete("1.0", "end")
            for index, (name, value) in enumerate(lines):
                if value is None:
                    body.insert("end", f" {name} \n", "section")
                    continue
                tag = f"value{index}"
                body.insert("end", f"{name}:\n", "title")
                body.insert("end", f"  {value}\n", tag)
                body.tag_bind(tag, "<Button-1>", lambda event, v=value: copy_text(v))
                body.tag_bind(tag, "<Enter>", lambda event: body.config(cursor="hand2"))
                body.tag_bind(tag, "<Leave>", lambda event: body.config(cursor="arrow"))
            body.config(state="disabled")
            body.yview_moveto(top_of_view)

        level, color = jam_level(jam_value)
        jam_bar.delete("all")
        if jam_value is not None:
            jam_bar.create_rectangle(0, 0, jam_bar.winfo_width() * jam_value / 255, 26, fill=color, width=0)
        extra = [f"{jam_value}/255 - {level}" if jam_value is not None
                 else "waiting for receiver (needs ubxtool)"]
        if "jam_state" in hw:
            extra.append(f"Receiver jamming state: {hw['jam_state']}")
        if "antenna" in hw:
            extra.append(f"Antenna: {hw['antenna']}")
        jam_text.config(text="\n".join(extra), fg=color if jam_value is not None else pal["fg"])
        draw_sky(sky)

        has_fix = mode >= 2 and "lat" in tpv and "lon" in tpv
        page = current["page"]
        if page == "SIGNALS":
            for key, value in (("HDOP", dops.get("hdop")), ("VDOP", dops.get("vdop")),
                               ("PDOP", dops.get("pdop"))):
                quality, tint = dop_quality(value)
                dash_values[key].config(text="-" if value is None else f"{value}", fg=tint)
            dash_values["FIX"].config(text=fix_label(mode), fg="#2e7d32" if mode >= 2 else "#c62828")
            accuracy = tpv.get("eph")
            dash_values["ACCURACY"].config(
                text="-" if accuracy is None else f"±{accuracy:.1f}m",
                fg=dop_quality(None if accuracy is None else accuracy / 2.5)[1])
            draw_bars(sky)
            draw_jam_history(history)

        heading = tpv.get("track") if tpv.get("speed", 0) >= 0.5 else None
        bearing, lines_nav = None, []
        speed_text = f"{tpv['speed'] * 3.6:.1f} km/h" if "speed" in tpv else "-"
        lines_nav.append(f"Speed:   {speed_text}")
        lines_nav.append("Heading: " + (f"{heading:.0f}° {compass_point(heading)}" if heading is not None
                                       else "- (move to get a heading)"))
        target = nav["target"]
        if target is not None and has_fix:
            metres, bearing = bearing_distance(tpv["lat"], tpv["lon"], target["lat"], target["lon"])
            lines_nav.append(f"Target:  {target['name']}")
            lines_nav.append(f"Dist:    {format_distance(metres)}")
            lines_nav.append(f"Bearing: {bearing:.0f}° {compass_point(bearing)}"
                             + (f"  turn {turn_hint(heading, bearing)}" if heading is not None else ""))
        elif target is not None:
            lines_nav.append(f"Target:  {target['name']} (waiting for fix)")
        if page == "NAVIGATE":
            nav_text.config(text="\n".join(lines_nav))
            draw_compass(heading, bearing)

        if log["handle"] is not None and has_fix and tpv.get("time") and tpv["time"] != log["last"]:
            log["last"] = tpv["time"]
            point = {"time": tpv["time"], "lat": tpv["lat"], "lon": tpv["lon"],
                     "alt": tpv.get("altHAE", tpv.get("alt")), "speed": tpv.get("speed"),
                     "track": tpv.get("track")}
            if len(track) < 200000:
                track.append(point)
            log["writer"].writerow([point["time"], point["lat"], point["lon"], point["alt"],
                                    point["speed"], point["track"]])
            log["handle"].flush()
        if page == "TRACK":
            lines_log = [f"Logging: {'ON' if log['handle'] is not None else 'off'}",
                         f"Points:  {len(track)}", f"Waypoints: {len(waypoints)}"]
            if log["path"]:
                lines_log.append(f"File: {os.path.basename(log['path'])}")
            if log["export"]:
                lines_log.append(f"Exported: {os.path.basename(log['export'])}")
            log_text.config(text="\n".join(lines_log))
        if page == "TOOLS":
            sun = sun_times(tpv["lat"], tpv["lon"], datetime.date.today()) if has_fix else None
            if not has_fix:
                sun_text.config(text="waiting for a fix")
            elif sun is None:
                sun_text.config(text="no sunrise/sunset today (polar day or night)")
            else:
                rise, sunset = sun[0].astimezone(), sun[1].astimezone()
                length = sun[1] - sun[0]
                sun_text.config(text=f"Sunrise: {rise:%H:%M}\nSunset:  {sunset:%H:%M}\n"
                                     f"Daylight: {length.seconds // 3600}h {length.seconds % 3600 // 60:02d}m")
        root.after(1000, refresh)

    def fix_label(mode):
        return {0: "none", 1: "none", 2: "2D", 3: "3D"}.get(mode, "?")

    def close():
        stop.set()
        if log["handle"] is not None:
            log["handle"].close()
        root.destroy()

    root.protocol("WM_DELETE_WINDOW", close)
    refresh_waypoints()
    apply_theme()
    refresh()
    watch_theme()
    root.mainloop()


if __name__ == "__main__":
    import sys
    if "--pin-dock" in sys.argv:
        sys.exit(0 if pin_to_dock() else 1)
    pin_to_dock()
    run_app()
