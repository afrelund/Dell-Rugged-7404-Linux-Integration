#!/bin/sh
set -e
if [ "$1" = configure ]; then
    model=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
    if [ "$model" != "Latitude 14 Rugged Extreme (7404)" ]; then
        echo "dell-rugged-7404: unsupported model '$model'; services not enabled." >&2
        exit 0
    fi
    udevadm control --reload-rules || true
    systemctl daemon-reload || true
    systemctl enable egalax-touchscreen-check.timer || true
    systemctl restart egalax-touchscreen-check.timer || true
    systemctl start --no-block egalax-touchscreen-check.service || true
    # Enable the speaker helper for every desktop user.
    systemctl --global enable dell-speaker-check.service || true
    echo "dell-rugged-7404: log out and in (or run 'systemctl --user enable --now dell-speaker-check.service') to start the speaker helper."
fi
exit 0
