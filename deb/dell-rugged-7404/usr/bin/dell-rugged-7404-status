#!/usr/bin/python3
"""Terminal status for the Dell Latitude 7404 integration.

  dell-rugged-7404-status            show what is installed / working
  dell-rugged-7404-status --install  install missing packages, showing progress
  dell-rugged-7404-status --watch    refresh the status every 2 seconds
  dell-rugged-7404-status --json     machine-readable component status (used by the Setup window)
  dell-rugged-7404-status --apply ID install one component: touchscreen, speaker, gps or graphics
"""
import argparse
from concurrent.futures import ThreadPoolExecutor
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time

PACKAGES = {
    "python3": "runs the helper scripts",
    "alsa-utils": "speaker unmute helper (amixer)",
    "gpsd": "GPS daemon for the u-blox receiver",
    "gpsd-clients": "GPS tools (cgps, gpspipe, ubxtool)",
    "pciutils": "GPU detection (lspci)",
    "python3-tk": "GPS monitor window",
}
UBLOX = "1546"
COLORS = {"OK": "32", "WORK": "33", "TODO": "31", "INFO": "36"}
LABELS = {"OK": " OK ", "WORK": "WORK", "TODO": "TODO", "INFO": "INFO"}


def line(state, text):
    tag = f"\033[{COLORS[state]}m[{LABELS[state]}]\033[0m" if sys.stdout.isatty() else f"[{LABELS[state]}]"
    print(f"{tag} {text}", flush=True)


def run(*command, timeout=10):
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=timeout)
        return result.returncode, result.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return 1, ""


def installed(package):
    code, out = run("dpkg-query", "-W", "-f=${Status}", package)
    return code == 0 and out.endswith("installed")


def read(path):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return ""


def ublox_port():
    for device in Path("/sys/bus/usb/devices").glob("*"):
        if read(device / "idVendor") == UBLOX:
            for tty in device.glob("*/tty/*"):
                return f"/dev/{tty.name}", read(device / "product") or "u-blox receiver"
            return None, read(device / "product") or "u-blox receiver"
    return None, None


# ---------- components (push-to-install) ----------
COMPONENTS = (
    ("touchscreen", "Touchscreen repair", "Keeps the eGalax touchscreen working (checks every few minutes)."),
    ("speaker", "Speaker fix", "Unmutes the HDA Intel PCH Headphone/Headset outputs that drive the speaker."),
    ("gps", "GPS support", "Installs gpsd and the GPS tools and attaches the u-blox receiver."),
    ("graphics", "Graphics driver", "Detects the GPUs and installs a driver only if Ubuntu recommends one."),
    ("smartcard", "Smart card / ID card (CAC)", "Installs the smart card service and tools so the ID card reader works."),
    ("rfid", "RFID / NFC reader", "Adds contactless tag support on top of the smart card service."),
    ("lte", "4G LTE modem", "Dell Wireless 5808e: enables ModemManager and checks the modem is detected."),
    ("sdr", "Software-defined radio", "RTL-SDR USB dongle: installs rtl-sdr and the Gqrx receiver."),
    ("battery", "Battery health", "Shows battery wear (informational; nothing to install)."),
    ("firmware", "Firmware updates", "Refreshes Dell firmware/BIOS updates from the LVFS (never installs them for you)."),
)

APT_GROUPS = {
    "smartcard": ["pcscd", "libccid", "opensc", "pcsc-tools"],
    "rfid": ["pcscd", "libccid", "libnfc-bin", "libacsccid1"],
    "lte": ["modemmanager", "mobile-broadband-provider-info"],
    "sdr": ["rtl-sdr", "gqrx-sdr"],
}


def missing_packages(key):
    return [p for p in APT_GROUPS[key] if not installed(p)]


def card_readers():
    if not shutil.which("opensc-tool"):
        return []
    out = run("opensc-tool", "-l", timeout=10)[1]
    return [l.split(None, 2)[2] if len(l.split(None, 2)) > 2 else l for l in out.splitlines()
            if re.match(r"^\s*\d+\s", l)]


def component_smartcard():
    missing = missing_packages("smartcard")
    if missing:
        return "missing", "not installed: " + ", ".join(missing)
    if run("systemctl", "is-active", "pcscd.socket")[1] != "active":
        return "missing", "smart card service (pcscd) is not running"
    readers = card_readers()
    if not readers:
        return "partial", "service running but no card reader was detected"
    return "installed", f"{len(readers)} reader(s): " + "; ".join(readers)


def component_rfid():
    missing = missing_packages("rfid")
    if missing:
        return "missing", "not installed: " + ", ".join(missing)
    if run("systemctl", "is-active", "pcscd.socket")[1] != "active":
        return "missing", "smart card service (pcscd) is not running"
    contactless = [r for r in card_readers() if re.search(r"contactless|nfc|rfid|\bCL\b", r, re.I)]
    if not contactless:
        return "partial", "service running but no contactless reader was detected"
    return "installed", "; ".join(contactless)


def component_lte():
    if missing_packages("lte"):
        return "missing", "ModemManager is not installed"
    if run("systemctl", "is-active", "ModemManager")[1] != "active":
        return "missing", "ModemManager is not running"
    out = run("mmcli", "-L")[1] if shutil.which("mmcli") else ""
    match = re.search(r"\]\s+(.+)$", out, re.M)
    if match:
        return "installed", f"modem detected: {match.group(1).strip()}"
    return "partial", "ModemManager running but no modem was detected"


def component_sdr():
    if missing_packages("sdr"):
        return "missing", "not installed: " + ", ".join(missing_packages("sdr"))
    if "0bda:2838" not in run("lsusb")[1].lower():
        return "partial", "tools installed but no RTL-SDR dongle is plugged in"
    return "installed", "RTL2838 dongle detected, tools installed"


def component_battery():
    base = "/sys/class/power_supply/BAT0"
    for prefix in ("energy", "charge"):
        try:
            full = int(open(f"{base}/{prefix}_full").read())
            design = int(open(f"{base}/{prefix}_full_design").read())
            break
        except (OSError, ValueError):
            continue
    else:
        return "partial", "battery information is not available"
    health = round(100 * full / design)
    if health >= 80:
        return "installed", f"battery health {health}% of design capacity"
    return "partial", f"battery health {health}% of design capacity: worn, consider replacing"


def component_firmware():
    if not shutil.which("fwupdmgr"):
        return "missing", "fwupd is not installed"
    try:
        result = subprocess.run(["fwupdmgr", "get-updates", "--no-metadata-check"],
                                capture_output=True, text=True, timeout=30)
        out = result.stdout + result.stderr
    except (OSError, subprocess.SubprocessError):
        return "partial", "could not query fwupd"
    if "capsule updates not available" in out.lower():
        return "partial", "UEFI capsule updates are disabled in the BIOS setup, so BIOS updates can't be installed from Linux"
    if "Devices with no available firmware updates" in out and "Upgrade available" not in out:
        return "installed", "no firmware updates available"
    if "Upgrade available" in out:
        return "partial", "firmware updates are available (run: fwupdmgr update)"
    return "installed", "no firmware updates reported"


def component_touchscreen():
    unit = "egalax-touchscreen-check.timer"
    enabled, active = run("systemctl", "is-enabled", unit)[1], run("systemctl", "is-active", unit)[1]
    if enabled == "enabled" and active == "active":
        return "installed", "repair timer enabled and running"
    return "missing", f"repair timer is {active or 'not set up'}"


def component_speaker():
    unit = "dell-speaker-check.service"
    enabled, active = (run("systemctl", "--user", "is-enabled", unit)[1],
                       run("systemctl", "--user", "is-active", unit)[1])
    if enabled == "enabled" and active == "active":
        detail = run("dell-speaker-check", "--status")[1].splitlines()
        return "installed", detail[0] if detail else "speaker helper running"
    return "missing", f"speaker helper is {active or 'not set up'}"


def component_gps():
    if not (installed("gpsd") and installed("gpsd-clients")):
        return "missing", "gpsd and gpsd-clients are not installed"
    port, product = ublox_port()
    if product is None:
        return "installed", "gpsd ready; no u-blox receiver plugged in"
    if port is None:
        return "partial", f"{product} found but it has no serial port yet"
    out = run("gpspipe", "-w", "-n", "6", timeout=8)[1] if shutil.which("gpspipe") else ""
    if port in out:
        return "installed", f"{product} attached to gpsd on {port}"
    return "partial", f"{product} on {port} is not attached to gpsd"


def component_graphics():
    out = run("dell-gpu-check")[1] if shutil.which("dell-gpu-check") else ""
    if "Ubuntu recommends" in out:
        return "missing", next(l.strip() for l in out.splitlines() if "Ubuntu recommends" in l)
    drivers = ", ".join(dict.fromkeys(re.findall(r"driver=(\w+)", out))) or "unknown"
    note = " (no proprietary driver needed)" if "nouveau is correct" in out else ""
    return "installed", f"drivers in use: {drivers}{note}"


def components():
    checks = {"touchscreen": component_touchscreen, "speaker": component_speaker,
              "gps": component_gps, "graphics": component_graphics,
              "smartcard": component_smartcard, "rfid": component_rfid, "lte": component_lte,
              "sdr": component_sdr, "battery": component_battery, "firmware": component_firmware}
    with ThreadPoolExecutor(max_workers=len(checks)) as pool:
        futures = {key: pool.submit(checks[key]) for key in checks}
    result = []
    for key, title, description in COMPONENTS:
        try:
            state, detail = futures[key].result()
        except Exception as error:  # one failing check must not blank the whole window
            state, detail = "partial", f"status check failed: {error}"
        result.append({"id": key, "title": title, "description": description,
                       "state": state, "detail": detail})
    return result


def apply(key):
    """Install one component. 'speaker' runs as the user; the others need root (pkexec)."""
    if key == "battery":
        print(component_battery()[1])
        return 0
    if key == "speaker":
        code = subprocess.run(["systemctl", "--user", "enable", "--now", "dell-speaker-check.service"]).returncode
        if shutil.which("dell-speaker-check"):
            subprocess.run(["dell-speaker-check"])
        return code
    if key not in {name for name, _, _ in COMPONENTS}:
        print(f"unknown component: {key}")
        return 2
    if os.geteuid() != 0:
        print("this step needs administrator rights")
        return 1
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
    if key == "touchscreen":
        print("Enabling the touchscreen repair timer ...", flush=True)
        subprocess.run(["systemctl", "daemon-reload"])
        code = subprocess.run(["systemctl", "enable", "--now", "egalax-touchscreen-check.timer"]).returncode
        subprocess.run(["systemctl", "start", "--no-block", "egalax-touchscreen-check.service"])
        return code
    if key == "gps":
        print("Updating package lists ...", flush=True)
        subprocess.run(["apt-get", "update", "-qq"], env=env)
        print("Installing gpsd and gpsd-clients ...", flush=True)
        code = subprocess.run(["apt-get", "install", "-y", "gpsd", "gpsd-clients"], env=env).returncode
        if code:
            return code
        subprocess.run(["systemctl", "enable", "--now", "gpsd.socket"])
        port, _ = ublox_port()
        if port:
            print(f"Attaching {port} to gpsd ...", flush=True)
            return subprocess.run(["gpsdctl", "add", port]).returncode
        print("No u-blox receiver found; plug it in and run this step again.")
        return 0
    if key in APT_GROUPS:
        print("Updating package lists ...", flush=True)
        subprocess.run(["apt-get", "update", "-qq"], env=env)
        print("Installing " + ", ".join(APT_GROUPS[key]) + " ...", flush=True)
        code = subprocess.run(["apt-get", "install", "-y", *APT_GROUPS[key]], env=env).returncode
        if code:
            return code
        if key in ("smartcard", "rfid"):
            subprocess.run(["systemctl", "enable", "--now", "pcscd.socket"])
            print("Readers seen by the system:")
            print("\n".join(card_readers()) or "none yet (insert a card or check the reader)")
        elif key == "lte":
            subprocess.run(["systemctl", "enable", "--now", "ModemManager"])
        return 0
    if key == "firmware":
        print("Refreshing firmware metadata ...", flush=True)
        subprocess.run(["fwupdmgr", "refresh", "--force"])
        subprocess.run(["fwupdmgr", "get-updates"])
        print("To install what is listed, run: fwupdmgr update")
        return 0
    print("Checking the graphics driver ...", flush=True)
    return subprocess.run(["/usr/bin/dell-gpu-check", "--install"], env=env).returncode


def status():
    print("Dell Latitude 14 Rugged Extreme (7404) - status\n")
    print("Packages")
    for package, purpose in PACKAGES.items():
        line("OK" if installed(package) else "TODO", f"{package}: {purpose}")

    print("\nTouchscreen")
    active = run("systemctl", "is-active", "egalax-touchscreen-check.timer")[1]
    line("OK" if active == "active" else "TODO", f"repair timer: {active or 'unknown'}")

    print("\nSpeaker")
    active = run("systemctl", "--user", "is-active", "dell-speaker-check.service")[1]
    line("OK" if active == "active" else "TODO", f"speaker helper (this user): {active or 'unknown'}")
    if shutil.which("dell-speaker-check"):
        line("INFO", run("dell-speaker-check", "--status")[1] or "speaker status unavailable")

    print("\nGPS")
    port, product = ublox_port()
    if product is None:
        line("TODO", "no u-blox USB receiver found")
    else:
        line("OK" if port else "TODO", f"{product}: {port or 'no serial port yet'}")
        active = run("systemctl", "is-active", "gpsd.socket")[1]
        line("OK" if active == "active" else "TODO", f"gpsd socket: {active or 'unknown'}")
        if shutil.which("gpspipe"):
            code, out = run("gpspipe", "-w", "-n", "6")
            attached = port is not None and port in out
            line("OK" if attached else "TODO",
                 f"gpsd has {port} attached" if attached else "gpsd has no device attached (run --install)")

        if shutil.which("dell-gps-check"):
            for text in run("dell-gps-check", timeout=30)[1].splitlines()[1:]:
                line("INFO", text.strip())

    print("\nGraphics")
    if shutil.which("dell-gpu-check"):
        for text in run("dell-gpu-check")[1].splitlines():
            line("INFO", text.strip())


def install():
    if os.geteuid() != 0:
        os.execvp("sudo", ["sudo", sys.executable, *sys.argv])
    missing = [package for package in PACKAGES if not installed(package)]
    print("Updating package lists ...", flush=True)
    line("WORK", "apt-get update")
    subprocess.run(["apt-get", "update", "-qq"], check=False)
    failed = []
    for package in PACKAGES:
        if package not in missing:
            line("OK", f"{package}: already installed")
            continue
        line("WORK", f"{package}: installing ...")
        result = subprocess.run(["apt-get", "install", "-y", "-qq", package],
                                capture_output=True, text=True)
        if result.returncode == 0 and installed(package):
            line("OK", f"{package}: installed")
        else:
            failed.append(package)
            line("TODO", f"{package}: FAILED - {result.stderr.strip().splitlines()[-1:] or ['see apt output']}")

    port, _ = ublox_port()
    if port and installed("gpsd"):
        line("WORK", f"attaching {port} to gpsd ...")
        result = subprocess.run(["gpsdctl", "add", port], capture_output=True, text=True)
        line("OK" if result.returncode == 0 else "TODO",
             f"{port} attached to gpsd" if result.returncode == 0 else f"gpsdctl failed: {result.stderr.strip()}")
    line("WORK", "checking graphics driver ...")
    if shutil.which("dell-gpu-check"):
        subprocess.run(["dell-gpu-check", "--install"])
    print()
    line("TODO" if failed else "OK", "finished with errors" if failed else "all packages done")
    return 1 if failed else 0


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--install", action="store_true")
    group.add_argument("--watch", action="store_true")
    group.add_argument("--json", action="store_true", help="component status as JSON")
    group.add_argument("--apply", metavar="ID", help="install one component")
    group.add_argument("--attach-gps", action="store_true", help="attach u-blox receiver to gpsd (root)")
    args = parser.parse_args()
    if args.attach_gps:
        port, _ = ublox_port()
        if not port or os.geteuid() != 0:
            return 1
        return subprocess.run(["gpsdctl", "add", port]).returncode
    if args.json:
        print(json.dumps(components()))
        return 0
    if args.apply:
        return apply(args.apply)
    if args.install:
        return install()
    if args.watch:
        try:
            while True:
                print("\033[2J\033[H", end="")
                status()
                time.sleep(2)
        except KeyboardInterrupt:
            return 0
    status()
    return 0


if __name__ == "__main__":
    sys.exit(main())
