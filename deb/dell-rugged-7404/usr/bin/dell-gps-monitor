#!/usr/bin/python3
"""Dell Rugged GPS Monitor: sky view, coordinates, GPS/local time, jamming indicator,
signal charts, navigation, track logging and sun times.

Reads the u-blox receiver through gpsd (localhost:2947). Nothing is written to the receiver
unless you use the confirmed buttons on the TOOLS tab.
"""
import datetime
import json
import math
import os
import re
import shutil
import socket
import subprocess
import threading
import time
from collections import deque

GPS_EPOCH = datetime.datetime(1980, 1, 6, tzinfo=datetime.timezone.utc)
GPS_UTC_LEAP_SECONDS = 18  # GPS time is ahead of UTC by this many seconds (since 2017)
CONSTELLATIONS = {0: ("GPS", "#2e7d32"), 1: ("SBAS", "#6a1b9a"), 2: ("Galileo", "#1565c0"),
                  3: ("BeiDou", "#c62828"), 5: ("QZSS", "#ef6c00"), 6: ("GLONASS", "#00838f")}


# ---------- coordinate formats ----------
def dms(value, positive, negative, places=2):
    hemisphere = positive if value >= 0 else negative
    value = abs(value)
    degrees = int(value)
    minutes_full = (value - degrees) * 60
    minutes = int(minutes_full)
    seconds = round((minutes_full - minutes) * 60, places)
    if seconds >= 60:
        seconds, minutes = 0.0, minutes + 1
    if minutes >= 60:
        minutes, degrees = 0, degrees + 1
    return f"{degrees}°{minutes:02d}'{seconds:0{places + 3}.{places}f}\"{hemisphere}"


def ddm(value, positive, negative, places=4):
    hemisphere = positive if value >= 0 else negative
    value = abs(value)
    degrees = int(value)
    return f"{degrees}°{(value - degrees) * 60:0{places + 3}.{places}f}'{hemisphere}"


def utm_zone(lat, lon):
    zone = int((lon + 180) // 6) + 1
    if 56 <= lat < 64 and 3 <= lon < 12:
        zone = 32
    elif 72 <= lat < 84 and lon >= 0:
        for limit, number in ((9, 31), (21, 33), (33, 35), (42, 37)):
            if lon < limit:
                zone = number
                break
    return min(max(zone, 1), 60)


def to_utm(lat, lon):
    """WGS84 latitude/longitude to (zone, hemisphere, easting, northing) using Krueger series."""
    a, f = 6378137.0, 1 / 298.257223563
    n = f / (2 - f)
    big_a = a / (1 + n) * (1 + n ** 2 / 4 + n ** 4 / 64)
    alpha = [n / 2 - 2 * n ** 2 / 3 + 5 * n ** 3 / 16,
             13 * n ** 2 / 48 - 3 * n ** 3 / 5,
             61 * n ** 3 / 240]
    zone = utm_zone(lat, lon)
    lon0 = math.radians((zone - 1) * 6 - 180 + 3)
    phi, dlon = math.radians(lat), math.radians(lon) - lon0
    t = math.sinh(math.atanh(math.sin(phi)) - 2 * math.sqrt(n) / (1 + n)
                  * math.atanh(2 * math.sqrt(n) / (1 + n) * math.sin(phi)))
    xi = math.atan2(t, math.cos(dlon))
    eta = math.atanh(math.sin(dlon) / math.sqrt(1 + t * t))
    easting = eta
    northing = xi
    for j, coefficient in enumerate(alpha, start=1):
        easting += coefficient * math.cos(2 * j * xi) * math.sinh(2 * j * eta)
        northing += coefficient * math.sin(2 * j * xi) * math.cosh(2 * j * eta)
    easting = 500000 + 0.9996 * big_a * easting
    northing = 0.9996 * big_a * northing
    if lat < 0:
        northing += 10000000
    return zone, "N" if lat >= 0 else "S", easting, northing


def latitude_band(lat):
    return "CDEFGHJKLMNPQRSTUVWXX"[min(int((lat + 80) // 8), 20)]


def to_mgrs(lat, lon, digits=5):
    if not -80 <= lat <= 84:
        return "n/a (outside MGRS UTM range)"
    zone, _, easting, northing = to_utm(lat, lon)
    column = ("ABCDEFGH", "JKLMNPQR", "STUVWXYZ")[(zone - 1) % 3][int(easting // 100000) - 1]
    row = "ABCDEFGHJKLMNPQRSTUV"[(int(northing // 100000) + (5 if zone % 2 == 0 else 0)) % 20]
    scale = 10 ** (5 - digits)
    return (f"{zone}{latitude_band(lat)} {column}{row} "
            f"{int(easting % 100000 // scale):0{digits}d} {int(northing % 100000 // scale):0{digits}d}")


def from_utm(zone, northern, easting, northing):
    """Inverse of to_utm (Krueger series) -> (lat, lon)."""
    a, f = 6378137.0, 1 / 298.257223563
    n = f / (2 - f)
    big_a = a / (1 + n) * (1 + n ** 2 / 4 + n ** 4 / 64)
    beta = [n / 2 - 2 * n ** 2 / 3 + 37 * n ** 3 / 96,
            n ** 2 / 48 + n ** 3 / 15,
            17 * n ** 3 / 480]
    delta = [2 * n - 2 * n ** 2 / 3 - 2 * n ** 3,
             7 * n ** 2 / 3 - 8 * n ** 3 / 5,
             56 * n ** 3 / 15]
    xi = (northing - (0 if northern else 10000000)) / (0.9996 * big_a)
    eta = (easting - 500000) / (0.9996 * big_a)
    xi0, eta0 = xi, eta
    for j, coefficient in enumerate(beta, start=1):
        xi0 -= coefficient * math.sin(2 * j * xi) * math.cosh(2 * j * eta)
        eta0 -= coefficient * math.cos(2 * j * xi) * math.sinh(2 * j * eta)
    chi = math.asin(math.sin(xi0) / math.cosh(eta0))
    phi = chi + sum(c * math.sin(2 * j * chi) for j, c in enumerate(delta, start=1))
    lon = math.radians((zone - 1) * 6 - 180 + 3) + math.atan2(math.sinh(eta0), math.cos(xi0))
    return math.degrees(phi), math.degrees(lon)


def from_mgrs(zone, band, column, row, easting, northing):
    """MGRS parts (numeric easting/northing within the 100 km square, metres) -> (lat, lon)."""
    column_index = ("ABCDEFGH", "JKLMNPQR", "STUVWXYZ")[(zone - 1) % 3].find(column)
    row_index = "ABCDEFGHJKLMNPQRSTUV".find(row)
    if column_index < 0 or row_index < 0 or band not in "CDEFGHJKLMNPQRSTUVWX":
        raise ValueError("bad MGRS letters")
    full_easting = (column_index + 1) * 100000 + easting
    base = ((row_index - (5 if zone % 2 == 0 else 0)) % 20) * 100000 + northing
    band_lat = -80 + 8 * "CDEFGHJKLMNPQRSTUVWX".index(band)
    centre = (zone - 1) * 6 - 180 + 3
    floor = to_utm(band_lat, centre)[3] - 100000
    full_northing = base
    while full_northing < floor:
        full_northing += 2000000
    lat, lon = from_utm(zone, band >= "N", full_easting, full_northing)
    return lat, lon


def parse_coordinate(text):
    """Recognise MGRS, UTM, or lat/lon (decimal, deg-decimal-minutes, DMS). Returns (lat, lon, kind) or None."""
    text = text.strip().upper()
    compact = re.sub(r"[\s,]+", "", text)
    match = re.fullmatch(r"(\d{1,2})([C-HJ-NP-X])([A-HJ-NP-Z])([A-HJ-NP-V])((?:\d\d)*)", compact)
    if match and 1 <= int(match.group(1)) <= 60:
        digits = match.group(5)
        half = len(digits) // 2
        if half <= 5:
            scale = 10 ** (5 - half)
            e = int(digits[:half] or 0) * scale + (scale // 2 if half else 50000)
            n = int(digits[half:] or 0) * scale + (scale // 2 if half else 50000)
            try:
                lat, lon = from_mgrs(int(match.group(1)), match.group(2), match.group(3),
                                     match.group(4), e, n)
            except ValueError:
                return None
            if -90 <= lat <= 90:
                return lat, lon, "MGRS / US National Grid"
    match = re.fullmatch(r"(\d{1,2})\s*([C-HJ-NP-X])\s+(\d{5,7}(?:\.\d+)?)\s*M?E?[\s,]+(\d{6,8}(?:\.\d+)?)\s*M?N?",
                         text)
    if match and 1 <= int(match.group(1)) <= 60:
        lat, lon = from_utm(int(match.group(1)), match.group(2) >= "N",
                            float(match.group(3)), float(match.group(4)))
        return lat, lon, "UTM"
    tokens = re.findall(r"[NSEW]|[+-]?\d+(?:\.\d+)?|[+-]?\.\d+", re.sub(r"[°º'′\"″]|DEG", " ", text))
    groups, current = [], {"nums": [], "letter": None}
    for token in tokens:
        if token in "NSEW":
            if current["letter"] is None and current["nums"]:
                current["letter"] = token
                groups.append(current)
                current = {"nums": [], "letter": None}
            elif current["letter"] is None:
                current["letter"] = token
            else:
                groups.append(current)
                current = {"nums": [], "letter": token}
        else:
            current["nums"].append(token)
    if current["nums"] or current["letter"]:
        groups.append(current)
    if not any(g["letter"] for g in groups):
        numbers = [t for g in groups for t in g["nums"]]
        if len(numbers) not in (2, 4, 6):
            return None
        half = len(numbers) // 2
        groups = [{"nums": numbers[:half], "letter": None}, {"nums": numbers[half:], "letter": None}]
    if len(groups) != 2 or any(not g["nums"] or len(g["nums"]) > 3 for g in groups):
        return None
    if len({len(g["nums"]) for g in groups}) != 1:
        return None
    values = []
    for g in groups:
        parts = [float(t) for t in g["nums"]]
        magnitude = abs(parts[0]) + sum(p / 60 ** i for i, p in enumerate(parts[1:], start=1))
        negative = g["nums"][0].startswith("-") or g["letter"] in ("S", "W")
        values.append((-magnitude if negative else magnitude, g["letter"]))
    (first, first_letter), (second, second_letter) = values
    if first_letter in ("E", "W") or second_letter in ("N", "S"):
        first, second = second, first
        first_letter, second_letter = second_letter, first_letter
    if not (-90 <= first <= 90 and -180 <= second <= 180):
        return None
    kind = {1: "Decimal degrees", 2: "Degrees + decimal minutes", 3: "Degrees minutes seconds"}[len(groups[0]["nums"])]
    return first, second, kind


def geocode_address(query):
    """Look an address up on OpenStreetMap Nominatim (needs internet) -> [(name, lat, lon)]."""
    import urllib.parse
    import urllib.request
    url = "https://nominatim.openstreetmap.org/search?" + urllib.parse.urlencode(
        {"q": query, "format": "json", "limit": 5})
    request = urllib.request.Request(url, headers={"User-Agent": "dell-rugged-7404-gps-monitor"})
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            found = json.load(response)
    except OSError as error:
        raise RouteError(f"Address lookup needs an internet connection ({error}).")
    return [(item["display_name"], float(item["lat"]), float(item["lon"])) for item in found]


def maidenhead(lat, lon):
    lon, lat = lon + 180, lat + 90
    text = chr(65 + int(lon // 20)) + chr(65 + int(lat // 10))
    text += str(int(lon % 20 // 2)) + str(int(lat % 10))
    text += chr(97 + int(lon % 2 * 12)) + chr(97 + int(lat % 1 * 24))
    return text


def coordinate_lines(lat, lon, altitude=None):
    zone, hemisphere, easting, northing = to_utm(lat, lon)
    lines = [
        ("Decimal degrees", f"{lat:.6f}, {lon:.6f}"),
        ("Deg / dec minutes", f"{ddm(lat, 'N', 'S')}  {ddm(lon, 'E', 'W')}"),
        ("Deg / min / sec", f"{dms(lat, 'N', 'S')}  {dms(lon, 'E', 'W')}"),
        ("UTM", f"{zone}{latitude_band(lat)} {easting:.0f} mE {northing:.0f} mN"
                if -80 <= lat <= 84 else f"{zone}{hemisphere} {easting:.0f} {northing:.0f}"),
        ("MGRS / US National Grid", to_mgrs(lat, lon)),
        ("Maidenhead", maidenhead(lat, lon)),
    ]
    if altitude is not None:
        lines.append(("Altitude", f"{altitude:.1f} m  /  {altitude * 3.28084:.0f} ft"))
    return lines


# ---------- time ----------
def parse_gps_utc(text):
    return datetime.datetime.fromisoformat(text.replace("Z", "+00:00"))


def time_lines(utc):
    gps = utc + datetime.timedelta(seconds=GPS_UTC_LEAP_SECONDS)
    since = gps - GPS_EPOCH
    week, tow = divmod(since.total_seconds(), 7 * 86400)
    local = utc.astimezone()
    return [
        ("GPS time", gps.strftime("%Y-%m-%d %H:%M:%S") + f"  (week {int(week)}, TOW {tow:.0f} s)"),
        ("UTC (from GPS)", utc.strftime("%Y-%m-%d %H:%M:%S")),
        ("Local time", local.strftime("%Y-%m-%d %H:%M:%S %Z (UTC%z)")),
    ]


# ---------- jamming ----------
def parse_mon_hw(text):
    """Extract jamInd, antenna status and (if reported) jamming state from ubxtool MON-HW output."""
    result = {}
    match = re.search(r"jamInd\s+(\d+)", text)
    if match:
        result["jam"] = int(match.group(1))
    match = re.search(r"aStatus\s+(\d+)", text)
    if match:
        result["antenna"] = {0: "initializing", 1: "unknown", 2: "OK", 3: "short circuit",
                             4: "open circuit"}.get(int(match.group(1)), "unknown")
    match = re.search(r"\bflags\s+x([0-9a-fA-F]+)", text)
    if match:
        result["jam_state"] = {0: "unknown", 1: "OK", 2: "warning", 3: "critical"}[
            (int(match.group(1), 16) >> 2) & 3]
    return result


def jam_level(value):
    if value is None:
        return "unknown", "#757575"
    if value < 40:
        return "none / low", "#2e7d32"
    if value < 100:
        return "possible interference", "#ef6c00"
    return "STRONG interference", "#c62828"


def sky_xy(azimuth, elevation, radius):
    distance = (90 - elevation) / 90 * radius
    angle = math.radians(azimuth)
    return distance * math.sin(angle), -distance * math.cos(angle)


# ---------- gpsd data ----------
class GpsState:
    def __init__(self):
        self.lock = threading.Lock()
        self.connected = False
        self.device = None
        self.tpv = {}
        self.sky = []
        self.dops = {}
        self.hw = {}
        self.jam_history = deque(maxlen=720)


def gpsd_reader(state, stop):
    while not stop.is_set():
        try:
            with socket.create_connection(("127.0.0.1", 2947), timeout=5) as connection:
                connection.sendall(b'?WATCH={"enable":true,"json":true}\n')
                connection.settimeout(5)
                with state.lock:
                    state.connected = True
                buffer = b""
                while not stop.is_set():
                    try:
                        chunk = connection.recv(8192)
                    except socket.timeout:
                        continue
                    if not chunk:
                        break
                    buffer += chunk
                    *lines, buffer = buffer.split(b"\n")
                    for raw in lines:
                        try:
                            message = json.loads(raw)
                        except ValueError:
                            continue
                        with state.lock:
                            apply_message(state, message)
        except OSError:
            pass
        with state.lock:
            state.connected = False
        stop.wait(2)


def apply_message(state, message):
    kind = message.get("class")
    if kind == "TPV":
        state.tpv = message
    elif kind == "SKY":
        if "satellites" in message:
            state.sky = message["satellites"]
        state.dops = {key: message[key] for key in ("hdop", "vdop", "pdop") if key in message}
    elif kind == "DEVICES":
        devices = message.get("devices") or []
        state.device = devices[0].get("path") if devices else None
    elif kind == "DEVICE":
        state.device = message.get("path")


def hw_poller(state, stop):
    while not stop.is_set():
        if shutil.which("ubxtool"):
            try:
                out = subprocess.run(["ubxtool", "-p", "MON-HW"], capture_output=True,
                                     text=True, timeout=15).stdout
                parsed = parse_mon_hw(out)
                if parsed:
                    with state.lock:
                        state.hw = parsed
                        if "jam" in parsed:
                            state.jam_history.append((time.time(), parsed["jam"]))
            except (OSError, subprocess.SubprocessError):
                pass
        stop.wait(5)


# ---------- navigation, sun, track export ----------
DATA_DIR = os.path.expanduser("~/GPS-Tracks")
COMPASS_POINTS = ("N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE",
                  "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW")


def bearing_distance(lat1, lon1, lat2, lon2):
    """Great-circle distance in metres and initial bearing in degrees from point 1 to point 2."""
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dlat, dlon = p2 - p1, math.radians(lon2 - lon1)
    a = math.sin(dlat / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dlon / 2) ** 2
    distance = 2 * 6371008.8 * math.asin(min(1, math.sqrt(a)))
    y = math.sin(dlon) * math.cos(p2)
    x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dlon)
    return distance, (math.degrees(math.atan2(y, x)) + 360) % 360


def compass_point(degrees):
    return COMPASS_POINTS[int((degrees % 360) / 22.5 + 0.5) % 16]


def format_distance(metres):
    if metres < 1000:
        return f"{metres:.0f} m"
    return f"{metres / 1000:.2f} km  ({metres / 1609.344:.2f} mi)"


def turn_hint(heading, bearing):
    delta = (bearing - heading + 540) % 360 - 180
    if abs(delta) < 3:
        return "on course"
    return f"{abs(delta):.0f}° {'right' if delta > 0 else 'left'}"


def dop_quality(value):
    """Rate a dilution-of-precision value; lower is better."""
    if value is None:
        return "-", "#757575"
    if value <= 2:
        return "good", "#2e7d32"
    if value <= 5:
        return "fair", "#ef6c00"
    return "poor", "#c62828"


def sun_times(lat, lon, day):
    """Sunrise and sunset (aware UTC datetimes) for a date, or None in polar day/night."""
    days = (day - datetime.date(2000, 1, 1)).days
    jstar = days - lon / 360
    anomaly = (357.5291 + 0.98560028 * jstar) % 360
    m = math.radians(anomaly)
    center = 1.9148 * math.sin(m) + 0.02 * math.sin(2 * m) + 0.0003 * math.sin(3 * m)
    ecliptic = math.radians((anomaly + center + 180 + 102.9372) % 360)
    transit = jstar + 0.0053 * math.sin(m) - 0.0069 * math.sin(2 * ecliptic)
    sin_dec = math.sin(ecliptic) * math.sin(math.radians(23.4397))
    cos_dec = math.sqrt(1 - sin_dec ** 2)
    phi = math.radians(lat)
    cos_h = (math.sin(math.radians(-0.833)) - math.sin(phi) * sin_dec) / (math.cos(phi) * cos_dec)
    if abs(cos_h) > 1:
        return None
    half = math.degrees(math.acos(cos_h)) / 360
    base = datetime.datetime(2000, 1, 1, 12, tzinfo=datetime.timezone.utc)
    return (base + datetime.timedelta(days=transit - half),
            base + datetime.timedelta(days=transit + half))


def gpx_text(track, waypoints, name="Dell Rugged track"):
    from xml.sax.saxutils import escape

    def ele(value):
        return f"<ele>{value:.1f}</ele>" if value is not None else ""

    out = ['<?xml version="1.0" encoding="UTF-8"?>',
           '<gpx version="1.1" creator="Dell Rugged GPS Monitor" xmlns="http://www.topografix.com/GPX/1/1">']
    for wp in waypoints:
        out.append(f'  <wpt lat="{wp["lat"]:.7f}" lon="{wp["lon"]:.7f}">{ele(wp.get("alt"))}'
                   f'<name>{escape(wp["name"])}</name></wpt>')
    out.append(f"  <trk><name>{escape(name)}</name><trkseg>")
    for p in track:
        out.append(f'    <trkpt lat="{p["lat"]:.7f}" lon="{p["lon"]:.7f}">{ele(p.get("alt"))}'
                   f'<time>{p["time"]}</time></trkpt>')
    out += ["  </trkseg></trk>", "</gpx>"]
    return "\n".join(out) + "\n"


def load_waypoints(path):
    try:
        with open(path) as handle:
            return [w for w in json.load(handle) if {"name", "lat", "lon"} <= set(w)]
    except (OSError, ValueError, TypeError):
        return []


def save_waypoints(path, waypoints):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as handle:
        json.dump(waypoints, handle, indent=1)


